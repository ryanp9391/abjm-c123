       "data": "Out[72]= \\begin{matrix}\\begin{array}{|c|c|c|c|c|}\\hline\\text{phi} & \\text{c} & \\text{eps} & \\text{state \\#} & \\text{|RHS - C4|}\\\\\\hline\\left\\{0.9,0.35,0.35,-1.1\\right\\} & 0.3 & 0.01 & 1 & 1.672051386236717\\times 10^{-11}\\\\\\hline\\left\\{0.9,0.35,0.35,-1.1\\right\\} & 2.\\, & 0.01 & 1 & 2.9344304763867513\\times 10^{-12}\\\\\\hline\\left\\{0.9,0.35,0.35,-1.1\\right\\} & 0.3 & 0.01 & 5 & 0.0006595877575990805\\\\\\hline\\left\\{0.9,0.35,0.35,-1.1\\right\\} & 2.\\, & 0.01 & 5 & 0.0030252890691876227\\\\\\hline\\left\\{0.9,0.35,0.35,-1.1\\right\\} & 0.3 & 0.01 & 17 & 0.0033636560348740407\\\\\\hline\\left\\{0.9,0.35,0.35,-1.1\\right\\} & 2.\\, & 0.01 & 17 & 0.018323878232070268\\\\\\hline\\left\\{0.9,0.35,0.35,-1.1\\right\\} & 0.3 & 0.01 & 18 & 0.0009772583877995927\\\\\\hline\\left\\{0.9,0.35,0.35,-1.1\\right\\} & 2.\\, & 0.01 & 18 & 0.0033145169658483527\\\\\\hline\\left\\{0.9,0.35,0.35,-1.1\\right\\} & 0.3 & 0.01 & 19 & 0.001783063575144611\\\\\\hline\\left\\{0.9,0.35,0.35,-1.1\\right\\} & 2.\\, & 0.01 & 19 & 0.0057203988684542085\\\\\\hline\\left\\{0.9,0.35,0.35,-1.1\\right\\} & 0.3 & 0.01 & 21 & 0.002148893573149734\\\\\\hline\\left\\{0.9,0.35,0.35,-1.1\\right\\} & 2.\\, & 0.01 & 21 & 0.015626702348514848\\\\\\hline\\left\\{0.9,0.35,0.35,-1.1\\right\\} & 0.3 & 0.01 & 23 & 0.0… [latex truncated: 12883 chars total]",
