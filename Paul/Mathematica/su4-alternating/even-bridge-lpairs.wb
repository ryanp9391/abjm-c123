      {
       "data": "Out[68]= \\begin{array}{|c|c|c|c|c|c|c|c|}\\hline\\text{eps} & \\text{state \\#} & \\text{overlap} & \\text{|F1 - C4|} & \\text{|F2 - C2|} & \\text{|F3 - C2|} & \\text{|F4 - C4|} & \\text{|G - C0|}\\\\\\hline0.01 & 1 & 1.\\, & 8.494871472919385\\times 10^{-12} & 8.666956041736285\\times 10^{-12} & 1.887823231072616\\times 10^{-12} & 1.887823231072616\\times 10^{-12} & 3.3306690738754696\\times 10^{-16}\\\\\\hline0.01 & 17 & 0.9998486388975661 & 0.0037546736341472486 & 0.005984707674076106 & 0.0015082679325288118 & 0.0015082679325285064 & 8.185831147741737\\times 10^{-6}\\\\\\hline0.01 & 18 & 0.9999636041864081 & 0.001038178317424105 & 0.001388785328390263 & 0.0006887872459864358 & 0.0006887872459865468 & 6.079703263085764\\times 10^{-7}\\\\\\hline0.01 & 19 & 0.9999197942020647 & 0.0018858663871020598 & 0.002474265489282847 & 0.0012964124591159816 & 0.0012964124591162921 & 5.353091644280575\\times 10^{-7}\\\\\\hline0.01 & 20 & 0.9999197942020647 & 0.0018858663871020598 & 0.002474265489282847 & 0.0012964124591159816 & 0.0012964124591162921 & 5.353091644280575\\times 10^{-7}\\\\\\hline0.01 & 21 & 0.9999326197664475 & 0.002500907395501169 & 0.00450260919680724 & 0.00048790935036062356 & 0.0004879093503606824 & 0.00001467700849744020… [latex truncated: 3889 chars total]",
