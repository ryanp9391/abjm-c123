       "data": "Out[32]= \\begin{matrix}\\begin{array}{|c|c|}\\hline\\text{p = 1: (X3X1)\\^{}(p) <W\\_ar\\^{}(p-1) W\\_a\\^{}(L-p+1)| = c <W\\_ar\\^{}p W\\_a\\^{}(L-p)|} & \\mathrm{True}\\\\\\hline\\text{p = 1, kappa = 3/10: K\\^{}(p) on <W\\_ar\\^{}(p-1) W\\_a\\^{}(L-p+1)| rotates pair p} & \\mathrm{True}\\\\\\hline\\text{p = 1, kappa = 7/4: K\\^{}(p) on <W\\_ar\\^{}(p-1) W\\_a\\^{}(L-p+1)| rotates pair p} & \\mathrm{True}\\\\\\hline\\text{p = 2: (X3X1)\\^{}(p) <W\\_ar\\^{}(p-1) W\\_a\\^{}(L-p+1)| = c <W\\_ar\\^{}p W\\_a\\^{}(L-p)|} & \\mathrm{True}\\\\\\hline\\text{p = 2, kappa = 3/10: K\\^{}(p) on <W\\_ar\\^{}(p-1) W\\_a\\^{}(L-p+1)| rotates pair p} & \\mathrm{True}\\\\\\hline\\text{p = 2, kappa = 7/4: K\\^{}(p) on <W\\_ar\\^{}(p-1) W\\_a\\^{}(L-p+1)| rotates pair p} & \\mathrm{True}\\\\\\hline\\text{p = 3: (X3X1)\\^{}(p) <W\\_ar\\^{}(p-1) W\\_a\\^{}(L-p+1)| = c <W\\_ar\\^{}p W\\_a\\^{}(L-p)|} & \\mathrm{True}\\\\\\hline\\text{p = 3, kappa = 3/10: K\\^{}(p) on <W\\_ar\\^{}(p-1) W\\_a\\^{}(L-p+1)| rotates pair p} & \\mathrm{True}\\\\\\hline\\text{p = 3, kappa = 7/4: K\\^{}(p) on <W\\_ar\\^{}(p-1) W\\_a\\^{}(L-p+1)| rotates pair p} & \\mathrm{True}\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|}\\hline\\text{right-end word (Y1 = t1(thA\\_L), Y2 = t2(thA\\_L), Y3 = t3\\^{}(thA\\_L + h))} & \\text{pairs changed}\\\\\\hline\\… [latex truncated: 1412 chars total]",
