  {
   "kind": 2,
   "value": "wsBasis[w_, res_] := Module[{c = wsCands[w], xs = res[\"xs\"], b, extra},\n  b = {c[\"v(x)u\"], c[\"vG^-T(x)u\"], c[\"vG^-T(x)uG\"]};\n  extra = Select[xs, MatrixRank[Append[Map[Flatten, b], Flatten[#]]] > Length[b] &];\n  Join[b, Take[extra, UpTo[1]]]];\nwsB1 = wsBasis[wsW1, wsRes1];\nwsMinors[x_] := Flatten[Table[x[[a, c]] x[[b, d]] - x[[a, d]] x[[b, c]], {a, 4}, {b, a + 1, 4}, {c, 4}, {d, c + 1, 4}]];\nwsLam = {l1, l2, l3, l4};\nwsX1 = wsLam . wsB1;\nwsSol1 = Solve[Thread[wsMinors[wsX1] == 0], wsLam];\n{Length[wsB1], MatrixRank /@ wsB1, wsSol1}",
   "languageId": "wolfram",
   "outputs": [
