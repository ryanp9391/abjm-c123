      {
       "data": "Out[1301]= \\begin{array}{|c|c|c|c|c|c|}\\hline\\text{w} & \\text{rank S} & \\text{dim S12} & \\text{q = uGv} & \\text{u G\\^{}-1 v} & \\text{\\# rank-1 solution branches}\\\\\\hline\\left\\{\\frac{7}{5},\\frac{9}{8},\\frac{3}{7},\\frac{5}{9}\\right\\} & 37 & 4 & \\frac{232551}{1558000} & -\\frac{6278877}{62320000} & 3\\\\\\hline\\left\\{\\frac{11}{10},\\frac{13}{9},\\frac{2}{5},\\frac{7}{6}\\right\\} & 37 & 4 & \\frac{38961}{40250} & -\\frac{56277}{71875} & 3\\\\\\hline\\left\\{\\frac{3}{2},\\frac{9}{8},\\frac{3}{7},\\frac{5}{9}\\right\\} & 9 & 3 & 0 & 0 & 1\\\\\\hline\\end{array}",
