     "items": [
      {
       "data": "<details class=\"vscode-wolfram-message-output\" style=\"color:#f44;border-left:3px solid #f44;background:rgba(255,68,68,0.08);padding:2px 6px;margin:1px 0;border-radius:0 3px 3px 0;font-family:monospace;font-size:0.85em\"><summary style=\"cursor:pointer\">2 warnings</summary><div style=\"padding:2px 0 2px 4px;border-top:1px solid rgba(255,68,68,0.15)\">Union::normal: Nonatomic expression expected at position 1 in Union[SparseArray[&lt;65536&gt;, {65536}]].</div><div style=\"padding:2px 0 2px 4px;border-top:1px solid rgba(255,68,68,0.15)\">Union::normal: Nonatomic expression expected at position 1 in Union[SparseArray[&lt;65536&gt;, {65536}]].</div></details>",
