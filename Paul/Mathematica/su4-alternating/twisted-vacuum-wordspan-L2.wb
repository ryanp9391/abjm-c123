       "data": "Out[1202]= \\begin{array}{|c|c|}\\hline\\text{[t1,t1] entries} & \\mathrm{Union}\\left[\\mathrm{SparseArray}[]\\right]\\\\\\hline\\text{[t1,t3] entries} & \\mathrm{Union}\\left[\\mathrm{SparseArray}[]\\right]\\\\\\hline\\text{eigen t1\\^{}w (value, residual)} & \\left\\{\\frac{3490337}{44906400},\\left\\{0\\right\\}\\right\\}\\\\\\hline\\text{t3\\^{}w eigen residual} & \\begin{pmatrix}-\\frac{594745414686680698925651973371503}{33757416658274431795200000000} & -\\frac{835686662670979226889854862727}{58606626142837555200000000} & -\\frac{84963630669525814132235996195929}{6751483331654886359040000000} & -\\frac{119383808952997032412836408961}{11721325228567511040000000} & -\\frac{12137661524217973447462285170847}{1350296666330977271808000000} & -\\frac{17054829850428147487548058423}{2344265045713502208000000} & -\\frac{1733951646316853349637469310121}{270059333266195454361600000} & -\\frac{188703439957963051233193033519}{35163975685702533120000000} & -\\frac{2436404264346878212506865489}{468853009142700441600000} & -\\frac{1733951646316853349637469310121}{378083066572673636106240000} & -\\frac{5034120801459207850640343184523}{1250274691047201177600000000} & -\\frac{26957634279709007319027576217}{7032795137140506624000000} & -\\frac{2436404264… [latex truncated: 4997 chars total]",
