      {
       "data": "Out[702]= \\begin{array}{|c|c|}\\hline\\text{\\# starts} & 60\\\\\\hline\\text{10 smallest f} & \\left\\{\\text{4.2}\\times 10^{\\text{-15}},\\text{4.3}\\times 10^{\\text{-15}},\\text{5.2}\\times 10^{\\text{-15}},\\text{5.3}\\times 10^{\\text{-15}},\\text{5.3}\\times 10^{\\text{-15}},\\text{5.4}\\times 10^{\\text{-15}},\\text{6.3}\\times 10^{\\text{-15}},\\text{6.7}\\times 10^{\\text{-15}},\\text{7.1}\\times 10^{\\text{-15}},\\text{7.3}\\times 10^{\\text{-15}}\\right\\}\\\\\\hline\\text{\\# zeros (f < 10⁻¹²)} & 45\\\\\\hline\\text{zeros: \\{eigen-bra?, \\# left eigenvectors it overlaps (out of 256)\\} --- tally} & \\begin{pmatrix}\\left\\{\\mathrm{True},1\\right\\} & 44\\\\\\left\\{\\mathrm{True},2\\right\\} & 1\\end{pmatrix}\\\\\\hline\\end{array}",
