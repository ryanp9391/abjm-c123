/span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:55.6502em;\"><span></span></span></span></span></span></span></span></span></span></div></div></div></div>\n<div style=\"margin-top:3px;padding:2px 8px;display:flex;align-items:center;gap:6px;border-left:2px solid rgba(128,128,128,0.3);\"\n     data-truncated-uuid=\"68\" data-session-epoch=\"825950\">\n  <span style=\"font-size:11px;color:var(--vscode-descriptionForeground,#888);flex:1;\">&#128230; Large output &#8212; 1,004 atoms (skeleton shown, full value in kernel)</span>\n  <button data-action=\"expand\" style=\"padding:1px 6px;font-size:12px;cursor:pointer;line-height:1.5;background:transparent;border:1px solid rgba(128,128,128,0.3);border-radius:3px;color:var(--vscode-foreground,inherit);\" title=\"Show full output\">&#9654;</button>\n  <button data-action=\"expand-more\" style=\"padding:1px 6px;font-size:12px;cursor:pointer;line-height:1.5;background:transparent;border:1px solid rgba(128,128,128,0.3);border-radius:3px;color:var(--vscode-foreground,inherit);\" title=\"Show +20 more lines\">&#43;&#8230;</button>\n  <button data-action=\"open-text\" style=\"padding:1px 6px;font-size:12px;cursor:pointer;line-height:1.5;background:transparent;border:1px solid rgba(128,128,128,0.3);border-radius:3px;color:var(--vscode-foreground,inherit);\" title=\"Open as text file\">&#128196;</button>\n</div>",
