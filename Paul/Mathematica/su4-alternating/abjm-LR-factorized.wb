      {
       "data": "Out[683]= \\begin{array}{|c|c|}\\hline\\text{\\# starts} & 40\\\\\\hline\\text{minimal values f (sorted, first 10)} & \\left\\{\\text{1.1}\\times 10^{\\text{-16}},\\text{2.2}\\times 10^{\\text{-16}},\\text{3.3}\\times 10^{\\text{-16}},\\text{6.7}\\times 10^{\\text{-16}},\\text{8.9}\\times 10^{\\text{-16}},\\text{8.9}\\times 10^{\\text{-16}},\\text{8.9}\\times 10^{\\text{-16}},\\text{1.}\\times 10^{\\text{-15}},\\text{1.1}\\times 10^{\\text{-15}},\\text{1.2}\\times 10^{\\text{-15}}\\right\\}\\\\\\hline\\text{\\# zeros (f < 10⁻¹⁰)} & 40\\\\\\hline\\text{zeros: \\{f, eigen-bra residual of t̄₁, coupled multiplets \\{Dynkin, E, LR\\}\\}} & \\begin{array}{|c|c|c|}\\hline\\text{2.3}\\times 10^{\\text{-15}} & \\text{1.1}\\times 10^{\\text{-8}} & \\begin{pmatrix}\\left\\{2,0,2\\right\\} & 0.\\, & \\mathrm{True}\\end{pmatrix}\\\\\\hline\\text{5.1}\\times 10^{\\text{-15}} & \\text{1.1}\\times 10^{\\text{-8}} & \\begin{pmatrix}\\left\\{2,0,2\\right\\} & 0.\\, & \\mathrm{True}\\\\\\left\\{1,0,1\\right\\} & 12.\\, & \\mathrm{False}\\\\\\left\\{1,0,1\\right\\} & 12.\\, & \\mathrm{False}\\end{pmatrix}\\\\\\hline\\text{1.2}\\times 10^{\\text{-15}} & \\text{7.9}\\times 10^{\\text{-9}} & \\begin{pmatrix}\\left\\{2,0,2\\right\\} & 0.\\, & \\mathrm{True}\\end{pmatrix}\\\\\\hline\\text{1.}\\times 10^{\\text{-15}} & \\text{6.4}\\times 10^{\\… [latex truncated: 8898 chars total]",
