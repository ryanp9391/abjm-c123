      {
       "data": "Out[40]= \\begin{array}{|c|c|}\\hline\\text{X1 = <e1 e4| t1(thF)} & \\begin{pmatrix}\\frac{1}{4}\\,g\\$6480\\left(4,1\\right) & \\frac{1}{2}\\,g\\$6480\\left(4,2\\right) & \\frac{1}{2}\\,g\\$6480\\left(4,3\\right) & \\frac{1}{2}\\,g\\$6480\\left(4,4\\right)\\\\0 & -\\frac{1}{4}\\,g\\$6480\\left(4,1\\right) & 0 & 0\\\\0 & 0 & -\\frac{1}{4}\\,g\\$6480\\left(4,1\\right) & 0\\\\0 & 0 & 0 & -\\frac{1}{4}\\,g\\$6480\\left(4,1\\right)\\end{pmatrix}\\\\\\hline\\text{X2 = <e1 e4| t2(thF+h)} & \\begin{pmatrix}0 & \\frac{1}{8}\\,\\left(g\\$6480\\left(3,2\\right)\\,g\\$6480\\left(4,3\\right)-g\\$6480\\left(3,3\\right)\\,g\\$6480\\left(4,2\\right)\\right) & \\frac{1}{8}\\,\\left(g\\$6480\\left(2,3\\right)\\,g\\$6480\\left(4,2\\right)-g\\$6480\\left(2,2\\right)\\,g\\$6480\\left(4,3\\right)\\right) & \\frac{1}{8}\\,\\left(g\\$6480\\left(2,4\\right)\\,g\\$6480\\left(4,2\\right)+g\\$6480\\left(3,4\\right)\\,g\\$6480\\left(4,3\\right)-g\\$6480\\left(2,2\\right)\\,g\\$6480\\left(4,4\\right)-g\\$6480\\left(3,3\\right)\\,g\\$6480\\left(4,4\\right)\\right)\\\\0 & \\frac{1}{8}\\,\\left(g\\$6480\\left(3,3\\right)\\,g\\$6480\\left(4,1\\right)-g\\$6480\\left(3,1\\right)\\,g\\$6480\\left(4,3\\right)\\right) & \\frac{1}{8}\\,\\left(g\\$6480\\left(2,1\\right)\\,g\\$6480\\left(4,3\\right)-g\\$6480\\left(2,3\\right)\\,g\\$6480\\left(4,1\\right)\\right) & \\frac{1}{8}\\,\\left(g… [latex truncated: 3955 chars total]",
