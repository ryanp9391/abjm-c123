       "data": "Out[33]= \\begin{array}{|c|c|c|}\\hline\\text{operator on <0| (companion, generic theta)} & \\text{only site moved} & \\text{new site vector}\\\\\\hline\\text{t1(th2+0h)} & 2 & \\left\\{0,0,-\\frac{2263}{14000},0\\right\\}\\\\\\hline\\text{t1(th3+0h)} & 3 & \\left\\{\\frac{131201075}{25044096},\\frac{391645}{298144},0,0\\right\\}\\\\\\hline\\text{t3(th1-1h)} & 1 & \\left\\{0,0,0,\\frac{27786923680581}{1099994130780160}\\right\\}\\\\\\hline\\text{t3(th4+3h)} & 4 & \\left\\{-\\frac{880833443841}{557043836518400},\\frac{19671946912449}{3119445484503040},-\\frac{279224201697597}{31194454845030400},\\frac{83091954869001}{15597227422515200}\\right\\}\\\\\\hline\\end{array}",
