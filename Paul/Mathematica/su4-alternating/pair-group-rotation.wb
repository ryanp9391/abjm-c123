       "data": "Out[28]= \\begin{array}{|c|c|}\\hline\\text{d = (thA - thF)/h} & \\text{single t\\_k(thF + m h) localising on pair 1}\\\\\\hline-2 & \\text{t1(thF+0h)}\\\\\\hline-1 & \\text{t1(thF+0h)}\\text{, }\\text{t3(thF-2h)}\\\\\\hline0 & \\text{t1(thF+0h)}\\text{, }\\text{t3(thF-1h)}\\\\\\hline1 & \\text{t1(thF+0h)}\\text{, }\\text{t3(thF+0h)}\\\\\\hline2 & \\text{t1(thF+0h)}\\text{, }\\text{t2(thF+1h)}\\text{, }\\text{t3(thF+1h)}\\\\\\hline3 & \\text{t1(thF+0h)}\\text{, }\\text{t3(thF+2h)}\\\\\\hline4 & \\text{t1(thF+0h)}\\\\\\hline\\end{array}",
