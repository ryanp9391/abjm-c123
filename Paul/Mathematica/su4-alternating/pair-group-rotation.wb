  {
   "kind": 2,
   "value": "pgRanks[th_, z_, v_, u_, words_, kap_] := Module[{G = DiagonalMatrix[z], ref = pgProd[{v, u, v, u}], rest = pgProd[{v, u}], cols, tg},\n   cols = Table[pgSplit[pgApplyWord[w, ref, {\"A\", \"F\", \"A\", \"F\"}, th, G], rest][[1]], {w, words}];\n   tg = pgProd[{v . DiagonalMatrix[1 - kap z], u . Inverse[DiagonalMatrix[1 - kap z]]}];\n   {MatrixRank[cols], MatrixRank[Append[cols, tg]]}];\npgNeg = With[{thA = {-3/5 + 1, -3/5, -3/8, -11/8}, thG = {2/7, -3/5, 8/11, -11/8}, a = 1/3, kap = 3/10,\n    w5 = {{}, {{1, -3/5}}, {{2, -1/10}}, {{3, -1/10}}, {{1, -3/5}, {3, -1/10}}}, w4 = {{}, {{1, -3/5}}, {{3, 2/7 - 1/2}}, {{1, -3/5}, {3, 2/7 - 1/2}}}},\n   {{\"ABJM point, z2 = z3, W_a (works)\", pgRanks[thA, {3/2, 5/4, 5/4, 4/7}, pgW[a][[1]], pgW[a][[2]], w5, kap]},\n    {\"ABJM point, z2 != z3, W_a\", pgRanks[thA, {3/2, 5/4, 2/3, 4/7}, pgW[a][[1]], pgW[a][[2]], w5, kap]},\n    {\"ABJM point, z2 = z3, generic BPS (v,u)\", pgRanks[thA, {3/2, 5/4, 5/4, 4/7}, pgV0, pgU0, w5, kap]},\n    {\"generic theta, z2 = z3, W_a\", pgRanks[thG, {3/2, 5/4, 5/4, 4/7}, pgW[a][[1]], pgW[a][[2]], w4, kap]}}];\nGrid[Prepend[pgNeg, {\"case\", \"{rank of localised span, rank with target}\"}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"725118\" data-output-id=\"224\" data-out-n=\"47\" data-sub-idx=\"2\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"29\" data-sub-start=\"10\" data-sub-end=\"10\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[47]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"24\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:6.04em;vertical-align:-2.75em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.29em;\"><span style=\"top:-5.25em;\"><span class=\"pstrut\" style=\"height:5.25em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-2.75em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.25em;\"><span style=\"top:-5.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">case</span></span></span></span><span style=\"top:-4.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">ABJM point, z2 = z3, W_a (works)</span></span></span></span><span style=\"top:-3.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">ABJM point, z2 != z3, W_a</span></span></span></span><span style=\"top:-1.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">ABJM point, z2 = z3, generic BPS (v,u)</span></span></span></span><span style=\"top:-0.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">generic theta, z2 = z3, W_a</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.75em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-2.75em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.25em;\"><span style=\"top:-5.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">{rank of localised span, rank with target}</span></span></span></span><span style=\"top:-4.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">5</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">5</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span><span style=\"top:-3.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">5</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">6</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span><span style=\"top:-1.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">5</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">6</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span><span style=\"top:-0.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">4</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">5</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.75em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-2.75em;\"></span></span></span><span style=\"top:-2.5em;\"><span class=\"pstrut\" style=\"height:5.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.7em;\"><span class=\"pstrut\" style=\"height:5.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-4.9em;\"><span class=\"pstrut\" style=\"height:5.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-6.1em;\"><span class=\"pstrut\" style=\"height:5.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-7.3em;\"><span class=\"pstrut\" style=\"height:5.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-8.5em;\"><span class=\"pstrut\" style=\"height:5.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.75em;\"><span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[47]= \\begin{array}{|c|c|}\\hline\\text{case} & \\text{\\{rank of localised span, rank with target\\}}\\\\\\hline\\text{ABJM point, z2 = z3, W\\_a (works)} & \\left\\{5,5\\right\\}\\\\\\hline\\text{ABJM point, z2 != z3, W\\_a} & \\left\\{5,6\\right\\}\\\\\\hline\\text{ABJM point, z2 = z3, generic BPS (v,u)} & \\left\\{5,6\\right\\}\\\\\\hline\\text{generic theta, z2 = z3, W\\_a} & \\left\\{4,5\\right\\}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "56974393-d0cf-4727-b2c5-c80b148757db"
    }
