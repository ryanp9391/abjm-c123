       "data": "Out[511]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{L} & \\text{Dynkin} & \\text{L+p odd} & \\text{\\# states} & \\text{counts of \\{|⟨$\\Psi$|$\\mathcal{Q}$$\\Psi$⟩|, off bridges all 0, main bridges all 0\\}}\\\\\\hline2 & \\left\\{2,0,2\\right\\} & \\mathrm{False} & 1 & \\langle\\!\\lvert \\left\\{1.\\,,\\mathrm{False},\\mathrm{False}\\right\\}\\to 1\\rvert\\!\\rangle \\\\\\hline2 & \\left\\{1,0,1\\right\\} & \\mathrm{True} & 2 & \\langle\\!\\lvert \\left\\{1.\\,,\\mathrm{True},\\mathrm{False}\\right\\}\\to 2\\rvert\\!\\rangle \\\\\\hline2 & \\left\\{0,0,0\\right\\} & \\mathrm{False} & 2 & \\langle\\!\\lvert \\left\\{1.\\,,\\mathrm{True},\\mathrm{False}\\right\\}\\to 2\\rvert\\!\\rangle \\\\\\hline3 & \\left\\{3,0,3\\right\\} & \\mathrm{False} & 1 & \\langle\\!\\lvert \\left\\{1.\\,,\\mathrm{False},\\mathrm{False}\\right\\}\\to 1\\rvert\\!\\rangle \\\\\\hline3 & \\left\\{2,0,2\\right\\} & \\mathrm{True} & 3 & \\langle\\!\\lvert \\left\\{1.\\,,\\mathrm{True},\\mathrm{False}\\right\\}\\to 3\\rvert\\!\\rangle \\\\\\hline3 & \\left\\{1,0,1\\right\\} & \\mathrm{False} & 6 & \\langle\\!\\lvert \\left\\{1.\\,,\\mathrm{False},\\mathrm{False}\\right\\}\\to 6\\rvert\\!\\rangle \\\\\\hline3 & \\left\\{0,0,0\\right\\} & \\mathrm{True} & 4 & \\langle\\!\\lvert \\left\\{1.\\,,\\mathrm{True},\\mathrm{False}\\right\\}\\to 4\\rvert\\!\\rangle \\\\\\hline4 & \\left\\{4,0,4\\rig… [latex truncated: 2118 chars total]",
