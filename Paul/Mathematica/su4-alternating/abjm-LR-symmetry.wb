       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[506]= \\begin{array}{|c|c|}\\hline\\text{‖[$\\mathcal{Q}$, H\\_MZ]$\\psi$‖ (L = 3)} & \\text{1.5}\\times 10^{\\text{-16}}\\\\\\hline\\text{‖$\\mathcal{Q}$S$\\psi$ − S⁻¹$\\mathcal{Q}$$\\psi$‖} & \\text{0.}\\\\\\hline\\text{best matches for $\\mathcal{Q}$ t̄₁(u) $\\mathcal{Q}$⁻¹ \\{form, c, rel. residual\\}} & \\begin{pmatrix}\\text{t̄₁(c−u)} & 1 & 2.077234084596904\\times 10^{-16}\\\\\\text{t̄₃(c−u)} & \\frac{3}{2} & 1.3220002624259737\\\\\\text{t̄₁(c−u)} & \\frac{1}{2} & 1.5359156209876246\\end{pmatrix}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
