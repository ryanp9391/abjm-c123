      {
       "data": "Out[456]= \\begin{array}{|c|c|c|c|c|c|c|c|}\\hline\\text{lambda\\_1,2,3 (pair 2 factors)} & \\left\\{\\frac{1}{2},-\\frac{1}{8},\\frac{3}{8}\\right\\} &  &  &  &  &  & \\\\\\hline\\text{c0..c4 (kappa=1, y=1)} & \\left\\{1,-8,64,-\\frac{128}{9},\\frac{256}{9}\\right\\} &  &  &  &  &  & \\\\\\hline\\text{exact operator identity  X3\\^{} X1 = 24 h\\^{}7 lam1 lam3 P  (P = pair translation)} & \\mathrm{True} &  &  &  &  &  & \\\\\\hline\\text{24 h\\^{}7 lam1 lam3} & \\frac{9}{256} &  &  &  &  &  & \\\\\\hline\\text{HW state (Dynkin)} & \\text{A} & \\text{B} & \\text{C} & \\text{A*C} & \\text{2-A-B-C} & \\text{K1 (direct)} & \\text{eigen-residual}\\\\\\hline\\left\\{2,0,2\\right\\} & 2 & -2 & 2 & 4 & 0 & 0 & \\text{0.}\\\\\\hline\\left\\{0,2,0\\right\\} & -2 & -2 & -2 & 4 & 8 & 8 & \\text{4.1}\\times 10^{\\text{-16}}\\\\\\hline\\left\\{1,0,1\\right\\} & -1+\\frac{216506351\\,\\mathrm{i}}{125000000} & 4 & -1-\\frac{216506351\\,\\mathrm{i}}{125000000} & 4 & 0 & 0 & \\text{4.6}\\times 10^{\\text{-16}}\\\\\\hline\\left\\{1,0,1\\right\\} & -1-\\frac{216506351\\,\\mathrm{i}}{125000000} & 4 & -1+\\frac{216506351\\,\\mathrm{i}}{125000000} & 4 & 0 & 0 & \\text{4.6}\\times 10^{\\text{-16}}\\\\\\hline\\left\\{0,0,0\\right\\} & 2 & -12 & 2 & 4 & 10 & 10 & \\text{7.5}\\times 10^{\\text{-15}}\\\\\\hline\\left\\{0,0,0\\r… [latex truncated: 1693 chars total]",
       "mime": "text/plain"
      }
