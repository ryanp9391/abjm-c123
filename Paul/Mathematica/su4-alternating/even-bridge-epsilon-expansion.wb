  {
   "kind": 2,
   "value": "(* Test of the building blocks on ONE pair (A F, 16-dim), generic theta, generic diagonal twist, exact *)\nueTest1 = Module[{h = 1/2, types = {\"A\", \"F\"}, thF = -3/5, th, z = {3/2, 5/4, 2/3, 4/7}, Lam, us = {1/5, -2/3}, t, comm, M1, M1F, M2, M3, zero16, r},\n  th = {thF + 2 h, thF}; Lam = DiagonalMatrix[z]; zero16 = ConstantArray[0, {16, 16}];\n  t = Table[ueTG[ueMono[k, u, types, th, h], k, Lam, ueGpref[k, u, types, th, h, False]], {k, 3}, {u, us}];\n  comm = AllTrue[Flatten[Table[Normal[t[[a, i]] . t[[b, j]] - t[[b, j]] . t[[a, i]]] == zero16, {a, 3}, {b, 3}, {i, 2}, {j, 2}]], TrueQ];\n  (* ABJM point theta_A = theta_F + 2h, u0 = theta_F + h: operator identities t2(u0) = t1(u0) t1(theta_F), t3(u0) = 0 *)\n  With[{u0 = thF + h},\n   M1 = ueTG[ueMono[1, u0, types, th, h], 1, Lam, 1]; M1F = ueTG[ueMono[1, thF, types, th, h], 1, Lam, 1];\n   M2 = ueTG[ueMono[2, u0, types, th, h], 2, Lam, ueGpref[2, u0, types, th, h, False]];\n   M3 = ueTG[ueMono[3, u0, types, th, h], 3, Lam, ueGpref[3, u0, types, th, h, False]]];\n  r = <|\"[t_a(u), t_b(v)] = 0 (a,b = 1..3, 2 values of u)\" -> comm, \"t2(u0) = t1(u0) t1(thF)\" -> (Normal[M2 - M1 . M1F] == zero16), \"t3(u0) = 0\" -> (Normal[M3] == zero16)|>;\n  Grid[Prepend[List @@@ Normal[r], {\"1-pair test\", \"exact result\"}], Frame -> All]];\n{ueTest1, MemoryInUse[]/10.^9}",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"725116\" data-output-id=\"72\" data-out-n=\"426\" data-sub-idx=\"2\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"7\" data-sub-start=\"12\" data-sub-end=\"12\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[426]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"15\" data-line-broken=\"1\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:6.64em;vertical-align:-3.07em;\"></span><span class=\"mord\"><span class=\"mtable\"><span class=\"col-align-r\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.57em;\"><span style=\"top:-5.57em;\"><span class=\"pstrut\" style=\"height:4.69em;\"></span><span class=\"mord\"></span></span><span style=\"top:-2.28em;\"><span class=\"pstrut\" style=\"height:4.69em;\"></span><span class=\"mord\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.07em;\"><span></span></span></span></span></span><span class=\"col-align-l\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.57em;\"><span style=\"top:-5.57em;\"><span class=\"pstrut\" style=\"height:4.69em;\"></span><span class=\"mord\"><span class=\"mord\"></span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"minner\"><span class=\"mopen\"><span class=\"delimsizing mult\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.65em;\"><span style=\"top:-1.9em;\"><span class=\"pstrut\" style=\"height:3.15em;\"></span><span class=\"delimsizinginner de