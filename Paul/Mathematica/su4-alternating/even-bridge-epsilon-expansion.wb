      {
       "data": "Out[490]= \\begin{aligned}\n  &\\left\\{\\begin{pmatrix}\\text{max |matrix.psi - vector application|} & \\text{t1} & \\text{t2} & \\text{t3} & \\text{T14}\\\\\\text{L = 2, generic theta, z} & \\text{2.5}\\times 10^{\\text{-16}} & \\text{1.2}\\times 10^{\\text{-16}} & \\text{5.7}\\times 10^{\\text{-17}} & \\text{1.2}\\times 10^{\\text{-16}}\\end{pmatrix} \\right. \\\\\n  &\\left. ,2.114223936\\right\\}\n\\end{aligned}",
