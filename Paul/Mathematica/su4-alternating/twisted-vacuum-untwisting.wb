       "data": "Out[1562]= \\begin{array}{|c|c|}\\hline\\text{alpha\\textasciitilde{} = lim F1\\_1/F1\\_4} & -\\frac{\\mathrm{utb}\\,\\left(utp1-utp2\\right)\\,\\left(utp1-utp3\\right)\\,\\left(utp1-utp4\\right)}{\\left(utp2-utp4\\right)\\,\\left(utp4-utp3\\right)\\,\\left(\\mathrm{utb}\\,utp4+\\mathrm{utc}\\right)}\\\\\\hline\\text{F1\\_\\{2,3\\}/F1\\_4} & \\left\\{0,0\\right\\}\\\\\\hline\\text{A1 limit} & \\left\\{1,0,0,0\\right\\}\\\\\\hline\\end{array}",
