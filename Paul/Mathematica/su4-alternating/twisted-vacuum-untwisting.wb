      {
       "data": "Out[1551]= \\begin{array}{|c|c|}\\hline\\text{fixed w: A1/A1\\_1 to O(e)} & \\left\\{1,-\\frac{2717\\,\\mathrm{ute}}{19125}+\\mathcal{O}\\left(\\mathrm{ute}^2\\right),\\frac{5434\\,\\mathrm{ute}}{2125}+\\mathcal{O}\\left(\\mathrm{ute}^2\\right),-\\frac{2717\\,\\mathrm{ute}^3}{3000}+\\mathcal{O}\\left(\\mathrm{ute}^4\\right)\\right\\}\\\\\\hline\\text{fixed w: F1/f4 to O(e\\^{}2)} & \\left\\{\\frac{2717\\,\\mathrm{utb}\\,\\mathrm{ute}^3}{18000}+\\mathcal{O}\\left(\\mathrm{ute}^4\\right),-\\frac{3\\,\\mathrm{utb}\\,\\mathrm{ute}}{2}-9\\,\\mathrm{utb}\\,\\mathrm{ute}^2+\\mathcal{O}\\left(\\mathrm{ute}^3\\right),-\\frac{\\mathrm{utb}\\,\\mathrm{ute}}{12}-\\frac{\\mathrm{utb}\\,\\mathrm{ute}^2}{36}+\\mathcal{O}\\left(\\mathrm{ute}^3\\right),\\left(\\frac{5\\,\\mathrm{utb}}{6}+\\mathrm{utc}\\right)\\,\\mathrm{ute}+\\mathcal{O}\\left(\\mathrm{ute}^3\\right)\\right\\}\\\\\\hline\\text{w2=z2,w3=z3: A1} & \\left\\{1,-\\frac{2717\\,\\mathrm{ute}}{19125}+\\mathcal{O}\\left(\\mathrm{ute}^2\\right),\\frac{5434\\,\\mathrm{ute}}{2125}+\\mathcal{O}\\left(\\mathrm{ute}^2\\right),-\\frac{2717\\,\\mathrm{ute}}{1125}+\\mathcal{O}\\left(\\mathrm{ute}^2\\right)\\right\\}\\\\\\hline\\text{w2=z2,w3=z3: F1/f4} & \\left\\{\\frac{2717\\,\\mathrm{utb}\\,\\mathrm{ute}}{1125}+\\frac{51623\\,\\mathrm{utb}\\,\\mathrm{ute}^2}{13500}+\\mathcal{O}\\left(\\m… [latex truncated: 1516 chars total]",
