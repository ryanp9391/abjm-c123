       "data": "Out[1582]= \\begin{array}{|c|c|c|c|c|c|c|c|c|c|c|}\\hline\\text{\\#} & \\text{w} & \\text{Dynkin} & \\text{E} & \\text{w1=L} & \\text{loc(1/3,-2/5)} & \\text{loc(1,1)} & \\text{special at=1/2} & \\text{noteLast} & \\text{noteFirst} & \\text{vac}\\\\\\hline1 & \\left\\{3,0,0,-3\\right\\} & \\left\\{3,0,3\\right\\} & 0 & \\mathrm{True} & 1.\\, & 1.\\, & 1.\\, & 1.\\, & 1.\\, & 1.\\,\\\\\\hline2 & \\left\\{3,-1,-1,-1\\right\\} & \\left\\{4,0,0\\right\\} & 12.\\, & \\mathrm{True} & 0 & 0 & 0 & 0 & 0 & 0\\\\\\hline3 & \\left\\{2,1,-1,-2\\right\\} & \\left\\{1,2,1\\right\\} & 12.\\, & \\mathrm{False} & 0 & 0 & 0 & 0 & 0 & 0\\\\\\hline4 & \\left\\{2,1,-1,-2\\right\\} & \\left\\{1,2,1\\right\\} & 12.\\, & \\mathrm{False} & 0 & 0 & 0 & 0 & 0 & 0\\\\\\hline5 & \\left\\{2,0,0,-2\\right\\} & \\left\\{2,0,2\\right\\} & 8.000000000000004 & \\mathrm{False} & 0 & 0 & 0.\\, +0.1020620726159656\\,\\mathrm{i} & 0 & 0 & 0\\\\\\hline6 & \\left\\{2,0,0,-2\\right\\} & \\left\\{2,0,2\\right\\} & 8.000000000000004 & \\mathrm{False} & 0 & 0 & 0.\\, -0.1020620726159656\\,\\mathrm{i} & 0 & 0 & 0\\\\\\hline7 & \\left\\{2,0,0,-2\\right\\} & \\left\\{2,0,2\\right\\} & 16.000000000000004 & \\mathrm{False} & 0 & 0 & 0.10206207261596574 & 0 & 0 & 0\\\\\\hline8 & \\left\\{2,0,-1,-1\\right\\} & \\left\\{2,1,0\\right\\} & 12.000000000000005 & \\mathrm… [latex truncated: 3863 chars total]",
