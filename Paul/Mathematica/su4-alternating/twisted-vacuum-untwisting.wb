      {
       "data": "Out[1542]= \\begin{array}{|c|c|}\\hline\\text{F1/(f4 e) leading} & \\left\\{0,-\\frac{\\left(utp1-utp2\\right)\\,\\left(utp2-utp4\\right)}{utp1-utp4},-\\frac{\\left(utp1-utp3\\right)\\,\\left(utp3-utp4\\right)}{utp1-utp4},\\mathrm{utc}-utp4\\right\\}\\\\\\hline\\text{alpha=comp2/comp4} & \\frac{\\left(utp1-utp2\\right)\\,\\left(utp2-utp4\\right)}{\\left(\\mathrm{utc}-utp4\\right)\\,\\left(utp4-utp1\\right)}\\\\\\hline\\text{beta=comp3/comp4} & \\frac{\\left(utp1-utp3\\right)\\,\\left(utp3-utp4\\right)}{\\left(\\mathrm{utc}-utp4\\right)\\,\\left(utp4-utp1\\right)}\\\\\\hline\\text{kappa fixed: F1/f4 at e=0} & \\left\\{0,0,0,1-\\mathrm{utkf}\\right\\}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
