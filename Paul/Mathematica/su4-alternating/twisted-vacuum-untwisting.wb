      {
       "data": "Out[1545]= \\begin{array}{|c|c|}\\hline\\text{A1 (norm. by comp 1)} & \\left\\{1,0,0,0\\right\\}\\\\\\hline\\text{F1/(e f4)} & \\left\\{0,-\\frac{\\mathrm{utb}}{35},-\\frac{13\\,\\mathrm{utb}}{14},\\frac{3\\,\\mathrm{utb}}{7}+\\mathrm{utc}\\right\\}\\\\\\hline\\text{ref A after n} & \\left\\{1,0,0,0\\right\\}\\\\\\hline\\text{ref F after n} & \\left\\{0,0,0,1\\right\\}\\\\\\hline\\end{array}",
