       "data": "Out[1569]= \\begin{array}{|c|c|c|}\\hline\\text{generic w: v, f (diag)} & \\left\\{\\frac{3828}{8125},\\frac{10208}{16625},-\\frac{2349}{8750},\\frac{11319}{61750}\\right\\} & \\left\\{-\\frac{2187}{86944},\\frac{45927}{695552},\\frac{189}{247},\\frac{1796985}{1863862}\\right\\}\\\\\\hline\\text{pairings generic w} & \\begin{pmatrix}\\text{B1 diag sum v.f/z} & \\frac{63423}{2470000}\\\\\\text{B1 companion u G\\^{}-1 v} & \\frac{63423}{2470000}\\\\\\text{B2/beta diag sum v f z} & -\\frac{21141}{6916000}\\\\\\text{B2/beta companion u G v} & -\\frac{21141}{6916000}\\\\\\text{u.v} & 0\\end{pmatrix} & \\\\\\hline\\text{special w2=z2,w3=z3: v, f} & \\left\\{\\frac{3828}{8125},\\frac{10208}{16625},-\\frac{2349}{8750},\\frac{11319}{61750}\\right\\} & \\left\\{-\\frac{243}{760},0,0,\\frac{7047}{8575}\\right\\}\\\\\\hline\\text{pairings special} & \\begin{pmatrix}\\text{B1 diag sum v.f/z} & \\frac{77517}{475000}\\\\\\text{B1 companion u G\\^{}-1 v} & \\frac{77517}{475000}\\\\\\text{B2/beta diag sum v f z} & -\\frac{232551}{1662500}\\\\\\text{B2/beta companion u G v} & -\\frac{232551}{1662500}\\\\\\text{u.v} & 0\\end{pmatrix} & \\\\\\hline\\text{v n, f n\\^{}-T (generic)} & \\left\\{\\frac{3828}{8125},0,0,\\frac{3828\\,\\mathrm{uta}}{8125}\\right\\} & \\left\\{-\\frac{1796985\\,\\mathrm{uta}}{1863862},0,… [latex truncated: 1649 chars total]",
