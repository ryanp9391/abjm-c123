  {
   "kind": 2,
   "value": "utD = Import[\"C:\\\\Users\\\\pryan\\\\git-projects\\\\abjm-c123\\\\Paul\\\\Mathematica\\\\su4-alternating\\\\data\\\\abjm-hw-states.wxf\", \"WXF\"];\nGrid[{{\"head\", Head[utD]}, {\"keys\", If[AssociationQ[utD], Keys[utD], \"n/a\"]}, {\"description\", If[AssociationQ[utD], utD[\"description\"], \"\"]}}, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
