      {
       "data": "Out[108]= \\begin{aligned}\n  &\\left\\{\\begin{pmatrix}\\frac{1}{100} & 11.4 & 3.74\\times 10^{-7}\\\\\\frac{1}{200} & 10.9 & 9.20\\times 10^{-8}\\\\\\frac{1}{400} & 10.6 & 2.28\\times 10^{-8}\\\\\\frac{1}{800} & 11.5 & 5.68\\times 10^{-9}\\\\\\frac{1}{1600} & 11.0 & 1.42\\times 10^{-9}\\end{pmatrix} \\right. \\\\\n  &\\left. ,4.295706024\\right\\}\n\\end{aligned}",
