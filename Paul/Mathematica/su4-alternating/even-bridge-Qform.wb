      {
       "data": "Out[153]= \\begin{array}{|c|c|c|c|c|c|c|c|}\\hline\\text{data state (group leader)} & \\text{|C\\_direct| at eps = 1/100, 1/200, 1/400, 1/800} & \\text{extrapolated |C\\_direct|} & \\text{extrapolated |C\\_Q|} & \\text{|C| data} & \\text{max rel |C\\_Q - C\\_direct|} & \\text{extrap |A|} & \\text{extrap |W|}\\\\\\hline17 & \\left\\{0.1677623,0.1694436,0.1702848,0.1707056\\right\\} & 0.171126405 & 0.171126405 & 0.1711264053796342 & 4.15\\times 10^{-37} & 3.656854 & -1.849486\\times 10^{-9}\\\\\\hline18 & \\left\\{0.02616036,0.02664607,0.02689116,0.02701426\\right\\} & 0.0271377471 & 0.0271377471 & 0.027137747061841994 & 8.24\\times 10^{-40} & 7.656854 & -2.233087\\times 10^{-9}\\\\\\hline19 & \\left\\{0.04411774,0.04500459,0.04545154,0.04567590\\right\\} & 0.0459008456 & 0.0459008456 & 0.045900845619830016 & 7.02\\times 10^{-38} & 14.65800 & -7.885333\\times 10^{-9}\\\\\\hline19 & \\left\\{0.04411774,0.04500459,0.04545154,0.04567590\\right\\} & 0.0459008456 & 0.0459008456 & 0.045900845619830016 & 7.02\\times 10^{-38} & 14.65800 & -7.885333\\times 10^{-9}\\\\\\hline21 & \\left\\{0.1513401,0.1524143,0.1529498,0.1532171\\right\\} & 0.153484083 & 0.153484083 & 0.1534840824942894 & 4.54\\times 10^{-37} & 1.841997 & -1.510791\\times 10^{-9}\\\\\\hline21 & \\lef… [latex truncated: 1377 chars total]",
