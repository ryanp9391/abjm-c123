  {
   "kind": 2,
   "value": "(* 2a runs, eps = 1/100, 1/200, 1/400 (90-100 digit eigenvectors) *)\nDo[qfEigRes[pr[[1]]] = qfEvalEig[pr[[1]], pr[[2]]], {pr, {{1/100, 90}, {1/200, 90}, {1/400, 100}}}];\n{Table[{e, N[qfEigRes[e][\"time\"], 3], N[qfEigRes[e][\"gap\"], 3]}, {e, Keys[qfEigRes]}], N[MemoryInUse[]/10.^9, 3]}",
