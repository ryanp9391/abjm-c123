   "kind": 2,
   "value": "(* stage 2 at eps = 1/100 ... 1/1600 (precision 100,100,100,110,120 digits as in the sources); the operator stores are released afterwards *)\nqfStage2List = Table[Module[{r = qfStage2[pr[[1]], pr[[2]]]}, qfStoreS[pr[[1]]] =.; r], {pr, {{1/100, 100}, {1/200, 100}, {1/400, 100}, {1/800, 110}, {1/1600, 120}}}];\nqfStoreS[1/50] =.;\nGrid[Prepend[Map[N[#, 4] &, qfStage2List, {2}], {\"eps\", \"prec\", \"time (s)\", \"Gram time (s)\", \"Gram nonzeros\", \"max |Gram.sol - tau|\", \"memory (GB)\"}], Frame -> All]",
   "languageId": "wolfram",
