  {
   "kind": 2,
   "value": "(* 3.2b the normalised twisted eigenvalues A, B, C of the eps-chain converge to the untwisted ones (E = 20: (2,-12,2); E = 4: (-2,4,-2)) *)\nqfABC = Table[Table[Module[{e = qfEpsL2[[i]], S, h = qfHh, thF, thA, u0, l1, l2, l3, y, row = qfSingE[[j, i]]},\n    S = qfSetup[e]; thF = S[\"thF\"]; thA = S[\"thA\"]; u0 = thF[[1]] + h; y = S[\"y\"];\n    l1 = qfLamK[1, thF[[1]], {thA[[2]]}, {thF[[2]]}]; l2 = qfLamK[2, u0, {thA[[2]]}, {thF[[2]]}]; l3 = qfLamK[3, u0, {thA[[2]]}, {thF[[2]]}];\n    {row[\"tauF\"][[1]]/(h^2 l1), row[\"x2\"]/(2 h^4 y l2), row[\"X3\"]/(6 h^5 y^2 l3)}], {i, 5}], {j, 2}];\nqfABClim = Table[Table[qfExtrapE[qfABC[[j, All, k]]], {k, 3}], {j, 2}];\nGrid[Join[{{\"singlet\", \"eps\", \"A = tau_F/(h^2 l1)\", \"B = tau_2(u0)/(2 h^4 y l2)\", \"C = tau^_3(u0)/(6 h^5 y^2 l3)\", \"A C\"}},\n  Flatten[Table[Join[Table[{If[i == 1, {\"E = 20\", \"E = 4\"}[[j]], \"\"], qfEpsL2[[i]], N[qfABC[[j, i, 1]], 8], N[qfABC[[j, i, 2]], 8], N[qfABC[[j, i, 3]], 8], N[qfABC[[j, i, 1]] qfABC[[j, i, 3]], 8]}, {i, 5}],\n     {{\"\", \"eps -> 0\", N[qfABClim[[j, 1]], 12], N[qfABClim[[j, 2]], 12], N[qfABClim[[j, 3]], 12], N[qfABClim[[j, 1]] qfABClim[[j, 3]], 12]}}], {j, 2}], 1]], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
