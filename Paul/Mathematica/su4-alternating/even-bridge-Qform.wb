      {
       "data": "Out[41]= \\begin{matrix}\\begin{array}{|c|c|c|c|c|c|}\\hline\\text{weight sector} & \\text{\\# states} & \\text{w1} & \\text{max |<0\\_w|Psi> - (v1 u4)\\^{}2 <W\\_a|Psi>|} & \\text{max |<0\\_w|Psi>|} & \\text{max |(v1u4)\\^{}2 <W\\_a|Psi>|}\\\\\\hline\\left\\{2,0,0,-2\\right\\} & 1 & \\frac{7}{5} & 0.\\times 10^{-41} & 0.1499 & 0.1499\\\\\\hline\\left\\{2,0,0,-2\\right\\} & 1 & \\frac{11}{3} & 0.\\times 10^{-37} & 349.0 & 349.0\\\\\\hline\\left\\{1,0,0,-1\\right\\} & 12 & \\frac{7}{5} & 0.\\times 10^{-41} & 0.07337 & 0.07337\\\\\\hline\\left\\{1,0,0,-1\\right\\} & 12 & \\frac{11}{3} & 0.\\times 10^{-37} & 990.8 & 990.8\\\\\\hline\\left\\{0,0,0,0\\right\\} & 28 & \\frac{7}{5} & 0.\\times 10^{-41} & 0.03252 & 0.03252\\\\\\hline\\left\\{0,0,0,0\\right\\} & 28 & \\frac{11}{3} & 0.\\times 10^{-36} & 2547 & 2547\\\\\\hline\\left\\{-1,0,0,1\\right\\} & 12 & \\frac{7}{5} & 0.\\times 10^{-42} & 0.01137 & 0.01137\\\\\\hline\\left\\{-1,0,0,1\\right\\} & 12 & \\frac{11}{3} & 0.\\times 10^{-36} & 5164 & 5164\\\\\\hline\\left\\{-2,0,0,2\\right\\} & 1 & \\frac{7}{5} & 0.\\times 10^{-42} & 0.003435 & 0.003435\\\\\\hline\\left\\{-2,0,0,2\\right\\} & 1 & \\frac{11}{3} & 0.\\times 10^{-36} & 9051 & 9051\\\\\\hline\\left\\{1,1,-1,-1\\right\\} & 4 & \\frac{7}{5} & 0 & 0 & 0\\\\\\hline\\left\\{1,1,-1,-1\\right\\} & 4 & \\frac{11}{3… [latex truncated: 1756 chars total]",
