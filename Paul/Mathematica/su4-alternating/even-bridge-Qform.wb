  {
   "kind": 2,
   "value": "(* 2a: eigenvector normalisation. Per eps: F1, F2, t2(u0), t3'(u0) in the diagonal frame (zero-weight block), 28 hp eigenvectors of a generic combination, eigenvalue data -> A, W; |<0|Psi>|/||Psi|| from the eigenvector *)\nqfEvalEig[eps_, prec_] := Module[{S = qfSetup[eps], h = qfHh, Lam, th, ty = qfTy4, thF, thA, z, u0, blk, F1, F2, T2, T3d, comb, vals, vecs, VR, piv, ev, X1v, X2v, X3v, F2v, l1, l2, l3, kap, y, s, kapS, Pre0, bra0z, braWz, gap, rows, t0},\n   t0 = AbsoluteTime[]; Lam = DiagonalMatrix[S[\"z\"]]; th = S[\"th\"]; thF = S[\"thF\"]; thA = S[\"thA\"]; z = S[\"z\"]; u0 = thF[[1]] + h; kap = S[\"kap\"]; y = S[\"y\"]; s = S[\"s\"];\n   blk[m_] := Normal[m[[qfZero, qfZero]]];\n   F1 = blk[qfTmulti[1, {Lam}, thF[[1]], ty, th, h, False][[1]]]; F2 = blk[qfTmulti[1, {Lam}, thF[[2]], ty, th, h, False][[1]]];\n   T2 = blk[qfTmulti[2, {Lam}, u0, ty, th, h, False][[1]]]; T3d = blk[qfTmulti[3, {Lam}, u0, ty, th, h, True][[1, 2]]];\n   comb = N[F1 + 2/5 F2 + 3/7 T2 + 5 T3d, prec]; {vals, vecs} = Eigensystem[comb]; VR = Transpose[vecs];\n   gap = Min[Abs[Subtract @@@ Subsets[vals, {2}]]];\n   piv = Table[First[Ordering[Abs[VR[[All, n]]], -1]], {n, 28}];\n   ev[op_] := Module[{X = N[op, prec] . VR}, Table[X[[piv[[n]], n]]/VR[[piv[[n]], n]], {n, 28}]];\n   X1v = ev[F1]; F2v = ev[F2]; X2v = ev[T2]; X3v = ev[T3d];\n   l1 = qfLamK[1, thF[[1]], {thA[[2]]}, {thF[[2]]}]; l2 = qfLamK[2, u0, {thA[[2]]}, {thF[[2]]}]; l3 = qfLamK[3, u0, {thA[[2]]}, {thF[[2]]}];\n   kapS = Table[qfKappaS[2 q, th, h], {q, 2}]; Pre0 = (S[\"a\"]/S[\"kap0\"])^2 (S[\"lam1\"] S[\"u4\"])^(-2);\n   bra0z = qfKron[{S[\"lamz\"], {1, 1, 1, 1}, S[\"lamz\"], {1, 1, 1, 1}}][[qfZero]]; braWz = qfWbra[{S[\"a\"], S[\"a\"]}][[qfZero]];\n   rows = Table[Module[{psi = VR[[All, n]], psiH, K, yv, Wv, wdir, wQ, ov0, real},\n      psiH = psi/Norm[psi]; ov0 = bra0z . psiH;\n      K = s^2 + kap s (X1v[[n]]/(h^2 l1) + X2v[[n]]/(2 h^4 y l2) + X3v[[n]]/(6 h^5 y^2 l3)) + kap^2 X3v[[n]] X1v[[n]]/(24 h^7 y^2 l1 l3);\n      yv = {X1v[[n]], F2v[[n]]}/kapS; Wv = qfBz[z[[2]], yv, thF, h] qfBz[z[[3]], yv, thF, h];\n      wdir = braWz . psiH; wQ = ov0 Pre0 Wv; real = Max[Abs[Im[psi/psi[[Ordering[Abs[psi], -1][[1]]]]]]] < 10^-30;\n      <|\"n\" -> n, \"real\" -> real, \"K\" -> K, \"W\" -> Wv, \"ov0\" -> ov0, \"Pre\" -> Pre0/S[\"Nk\"], \"Cdir\" -> Abs[K wdir/S[\"Nk\"]], \"CQ\" -> Abs[K wQ/S[\"Nk\"]], \"wErr\" -> Abs[wdir - wQ]/Abs[wdir], \"tauF\" -> {X1v[[n]], F2v[[n]]}, \"x2\" -> X2v[[n]], \"X3\" -> X3v[[n]]|>], {n, 28}];\n   <|\"eps\" -> eps, \"rows\" -> rows, \"gap\" -> gap, \"time\" -> AbsoluteTime[] - t0|>];\nqfEigRes = <||>;\n{\"2a functions loaded\", N[MemoryInUse[]/10.^9, 3]}",
   "languageId": "wolfram",
   "outputs": [
    {
