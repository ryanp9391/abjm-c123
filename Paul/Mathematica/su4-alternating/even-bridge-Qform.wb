  {
   "kind": 2,
   "value": "(* 2a result: |C| = N_pre |A| |W| |<0|Psi>|/||Psi|| for the two singlets, and the eps -> 0 extrapolation (degree 4 through eps = 1/100 ... 1/1600) *)\nqfEpsL2 = {1/100, 1/200, 1/400, 1/800, 1/1600};\nqfPickE[res_, t_] := First[SortBy[Select[res[\"rows\"], #[\"real\"] &], Abs[#[\"Cdir\"] - t] &]];\nqfSingE = Table[Table[qfPickE[qfEigRes[e], t], {e, qfEpsL2}], {t, qfTgt}];\nqfExtrapE[vals_] := InterpolatingPolynomial[Transpose[{qfEpsL2, vals}], qfx] /. qfx -> 0;\nqfLimE = Table[With[{rows = qfSingE[[j]]}, Map[qfExtrapE, {rows[[All, \"Cdir\"]], rows[[All, \"CQ\"]], Abs /@ rows[[All, \"K\"]], Abs /@ rows[[All, \"W\"]], Abs /@ rows[[All, \"ov0\"]], rows[[All, \"Pre\"]]}]], {j, 2}];\nColumn[Join[Table[Labeled[Grid[Prepend[Table[{qfEpsL2[[i]], N[qfSingE[[j, i, \"Cdir\"]], 12], N[qfSingE[[j, i, \"CQ\"]], 12], N[qfSingE[[j, i, \"wErr\"]], 2], N[Abs[qfSingE[[j, i, \"K\"]]], 10], N[Abs[qfSingE[[j, i, \"W\"]]], 10], N[Abs[qfSingE[[j, i, \"ov0\"]]], 10], N[qfSingE[[j, i, \"Pre\"]], 10]}, {i, 5}],\n     {\"eps\", \"|C_direct| = |K <W_a|Psi>/N|\", \"|C_Q| = N_pre|A||W||<0|Psi>|\", \"|<W|Psi>_direct - <W|Psi>_Q|/|<W|Psi>|\", \"|A|\", \"|W|\", \"|<0|Psi>|/||Psi||\", \"N_pre\"}], Frame -> All, Alignment -> Left], {\"singlet E = 20 (target 1/sqrt(40))\", \"singlet E = 4 (target 1/sqrt(24))\"}[[j]], Top], {j, 2}],\n  {Labeled[Grid[Prepend[Table[{{\"E = 20\", \"E = 4\"}[[j]], N[qfTgt[[j]], 16], N[qfLimE[[j, 1]], 16], N[qfLimE[[j, 2]], 16], N[qfLimE[[j, 2]] - qfTgt[[j]], 3], N[qfLimE[[j, 3]], 12], N[qfLimE[[j, 4]], 12], N[qfLimE[[j, 5]], 12], N[1/Sqrt[{2500000, 7776}[[j]]], 12], N[qfLimE[[j, 6]], 12]}, {j, 2}],\n     {\"singlet\", \"target\", \"extrap |C_direct|\", \"extrap |C_Q|\", \"|C_Q| - target\", \"extrap A\", \"extrap W\", \"extrap |<0|Psi>|/||Psi||\", \"1/sqrt(B0), B0 = 2.5e6, 7776\", \"extrap N_pre\"}], Frame -> All, Alignment -> Left], \"eps -> 0 (degree-4 Lagrange extrapolation)\", Top]}]]",
   "languageId": "wolfram",
   "outputs": [
