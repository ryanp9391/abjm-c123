  {
   "kind": 2,
   "value": "(* 3.3 check on all 28 zero-weight states: W(eps) vs (16 tau^2 - 4 tau - 1 + 8 x)^2, x = tau_2(u0)/tau_F; deviation must fall like eps on the parity-symmetric states *)\nqfWall = Table[Table[Module[{r = qfEigRes[e][\"rows\"][[n]], tau, x, B1p},\n     tau = r[\"tauF\"][[1]]; x = r[\"x2\"]/tau; B1p = 16 tau^2 - 4 tau - 1 + 8 x; Abs[r[\"W\"] - B1p^2]/Abs[r[\"W\"]]], {n, 28}], {e, {1/800, 1/1600}}];\nqfWallTab = Table[{n, qfEigRes[1/1600][\"rows\"][[n]][\"real\"], N[qfEigRes[1/1600][\"rows\"][[n]][\"tauF\"][[1]], 5], N[qfWall[[1, n]], 3], N[qfWall[[2, n]], 3], N[qfWall[[1, n]]/qfWall[[2, n]], 3]}, {n, 28}];\nqfWsym = Select[qfWallTab, #[[6]] > 1.8 && #[[6]] < 2.2 && #[[5]] < 0.05 &];\nColumn[{Grid[{{\"# states where the deviation halves with eps (ratio 1.8..2.2) and is < 5% at eps = 1/1600\", Length[qfWsym]}, {\"of which real\", Count[qfWsym[[All, 2]], True]}, {\"max deviation at eps = 1/1600 among them\", Max[qfWsym[[All, 5]]]}}, Frame -> All, Alignment -> Left],\n  Grid[Prepend[qfWallTab, {\"state\", \"real\", \"tau_F1 (eps = 1/1600)\", \"|W - B1^2|/|W|, eps = 1/800\", \"eps = 1/1600\", \"ratio\"}], Frame -> All, Alignment -> Left]}]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
