  {
   "kind": 2,
   "value": "(* 2c table: |C_direct|, |C_Q| (norm from the eigenvector) at the four eps, cubic extrapolation, and the data *)\nqfEpsL3 = {1/100, 1/200, 1/400, 1/800};\nqfLagr0[es_, vals_] := Sum[vals[[i]] Product[If[j == i, 1, (0 - es[[j]])/(es[[i]] - es[[j]])], {j, Length[es]}], {i, Length[es]}];\nqfDataMod3 = Association[Table[i -> Abs[qfDat3[\"CRe\"][[i]][[5]] + I qfDat3[\"CIm\"][[i]][[5]]], {i, {17, 18, 19, 21}}]];\nqfTab3 = Table[Module[{cd = Table[Abs[qfOut3[e][[j]][\"Cd\"]], {e, qfEpsL3}], cq = Table[Abs[qfOut3[e][[j]][\"Cq\"]], {e, qfEpsL3}], aa = Table[Abs[qfOut3[e][[j]][\"K\"]], {e, qfEpsL3}], ww = Table[Abs[qfOut3[e][[j]][\"W\"]], {e, qfEpsL3}], g = qfOut3[1/100][[j]][\"group\"]},\n    {g, N[cd, 7], N[qfLagr0[qfEpsL3, cd], 9], N[qfLagr0[qfEpsL3, cq], 9], N[qfDataMod3[g], 9], N[Max[Abs[(cq - cd)/cd]], 3], N[qfLagr0[qfEpsL3, aa], 7], N[qfLagr0[qfEpsL3, ww], 7]}], {j, 6}];\nGrid[Prepend[qfTab3, {\"data state (group leader)\", \"|C_direct| at eps = 1/100, 1/200, 1/400, 1/800\", \"extrapolated |C_direct|\", \"extrapolated |C_Q|\", \"|C| data\", \"max rel |C_Q - C_direct|\", \"extrap |A|\", \"extrap |W|\"}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
