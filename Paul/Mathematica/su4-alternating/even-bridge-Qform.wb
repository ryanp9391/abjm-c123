em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-3.35em;\"></span></span></span><span style=\"top:-2.5em;\"><span class=\"pstrut\" style=\"height:5.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.7em;\"><span class=\"pstrut\" style=\"height:5.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-4.9em;\"><span class=\"pstrut\" style=\"height:5.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-6.1em;\"><span class=\"pstrut\" style=\"height:5.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-7.3em;\"><span class=\"pstrut\" style=\"height:5.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-8.5em;\"><span class=\"pstrut\" style=\"height:5.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-9.7em;\"><span class=\"pstrut\" style=\"height:5.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.35em;\"><span></span></span></span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.97em;\"><span></span></span></span></span></span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:8.19em;\"><span></span></span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[49]= \\begin{matrix}\\begin{matrix}\\text{generic theta (2/7,-3/5,8/11,-11/8)}\\\\\\begin{array}{|c|c|c|c|c|}\\hline\\text{n = L - mu} & \\text{\\# states} & \\text{min eigenvalue gap} & \\text{max rel. dev. direct vs Q-form} & \\text{max |<W\\_a|Psi>|}\\\\\\hline0 & 1 & \\infty  & 0.\\times 10^{-47} & 1.\\,\\\\\\hline1 & 12 & 0.0143 & 0.\\times 10^{-47} & 0.5391\\\\\\hline2 & 28 & 0.000741 & 0.\\times 10^{-44} & 0.2632\\\\\\hline3 & 12 & 0.00361 & 0.\\times 10^{-47} & 0.1013\\\\\\hline4 & 1 & \\infty  & 0.\\times 10^{-48} & 0.03374\\\\\\hline\\end{array}\\end{matrix}\\\\\\begin{matrix}\\text{ABJM pair-by-pair theta (2/5,-3/5,-3/8,-11/8)}\\\\\\begin{array}{|c|c|c|c|c|}\\hline\\text{n = L - mu} & \\text{\\# states} & \\text{min eigenvalue gap} & \\text{max rel. dev. direct vs Q-form} & \\text{max |<W\\_a|Psi>|}\\\\\\hline0 & 1 & \\infty  & 0.\\times 10^{-47} & 1.\\,\\\\\\hline1 & 12 & 0.0155 & 0.\\times 10^{-45} & 0.5333\\\\\\hline2 & 28 & 0.00127 & 0.\\times 10^{-42} & 0.2397\\\\\\hline3 & 12 & 0.000924 & 0.\\times 10^{-45} & 0.09795\\\\\\hline4 & 1 & \\infty  & 0.\\times 10^{-48} & 0.03374\\\\\\hline\\end{array}\\end{matrix}\\end{matrix}",
       "mime": "text/plain"
      }
