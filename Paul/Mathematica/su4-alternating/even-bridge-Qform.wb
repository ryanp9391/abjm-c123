  {
   "kind": 2,
   "value": "(* Part 2 result: the two singlets factor by factor, and the eps -> 0 extrapolation (degree 5 through eps = 1/50 ... 1/1600) *)\nqfEpsL = {1/50, 1/100, 1/200, 1/400, 1/800, 1/1600}; qfTgt = {1/Sqrt[40], 1/Sqrt[24]};\nqfPick[res_, t_] := First[SortBy[Select[res[\"rows\"], #[\"real\"] &], Abs[#[\"Cdir\"] - t] &]];\nqfSing = Table[Table[qfPick[qfRes[e], t], {e, qfEpsL}], {t, qfTgt}];\nqfExtrap[vals_] := InterpolatingPolynomial[Transpose[{qfEpsL, vals}], qfx] /. qfx -> 0;\nqfFacTab = Table[Table[{qfEpsL[[i]], N[qfSing[[j, i, \"Cdir\"]], 12], N[qfSing[[j, i, \"CQ\"]], 12], N[Abs[qfSing[[j, i, \"K\"]]], 10], N[Abs[qfSing[[j, i, \"W\"]]], 10], N[Abs[qfSing[[j, i, \"B\"]]], 12], N[qfSing[[j, i, \"Pre\"]], 10]}, {i, 6}], {j, 2}];\nqfLim = Table[With[{rows = qfSing[[j]]}, Map[qfExtrap, {rows[[All, \"Cdir\"]], rows[[All, \"CQ\"]], Abs /@ rows[[All, \"K\"]], Abs /@ rows[[All, \"W\"]], Abs /@ rows[[All, \"B\"]], rows[[All, \"Pre\"]]}]], {j, 2}];\nColumn[Join[Table[Labeled[Grid[Prepend[qfFacTab[[j]], {\"eps\", \"|C_direct|\", \"|C_Q|\", \"|A| = |P_kappa|\", \"|W| = |B_z2 B_z3|\", \"|B| = sum tauT M tau\", \"N_pre\"}], Frame -> All, Alignment -> Left], {\"singlet E = 20 (target 1/sqrt(40))\", \"singlet E = 4 (target 1/sqrt(24))\"}[[j]], Top], {j, 2}],\n  {Labeled[Grid[Prepend[Table[{{\"E = 20\", \"E = 4\"}[[j]], N[qfTgt[[j]], 16], N[qfLim[[j, 1]], 16], N[qfLim[[j, 2]], 16], N[qfLim[[j, 2]] - qfTgt[[j]], 3], N[qfLim[[j, 3]], 14], N[qfLim[[j, 4]], 14], N[qfLim[[j, 5]], 14], N[qfLim[[j, 6]], 12]}, {j, 2}],\n     {\"singlet\", \"target\", \"extrap |C_direct|\", \"extrap |C_Q|\", \"|C_Q| - target\", \"extrap A\", \"extrap W\", \"extrap B\", \"extrap N_pre\"}], Frame -> All, Alignment -> Left], \"eps -> 0 (degree-5 Lagrange extrapolation)\", Top]}]]",
   "languageId": "wolfram",
   "outputs": [
