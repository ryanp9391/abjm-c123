      {
       "data": "Out[64]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{n} & \\text{|<W\\_a\\^{}3|Psi>|} & \\text{rel. dev. direct vs Q-form} & \\text{tau\\_1(theta\\_2)} & \\text{eigen-residual}\\\\\\hline0 & 1.\\, & 6.80352\\times 10^{-59} & -0.0293049 & 0\\\\\\hline1 & 0.0186341 & 1.40734\\times 10^{-55} & 0.011482999205637473418605125849381416557670164395245+0.056890274843389208321431663776317169662495614100600\\,\\mathrm{i} & 7.42\\times 10^{-59}\\\\\\hline1 & 0.00780096 & 6.20067\\times 10^{-50} & -0.089902867694613390941282966221086031160092908584590-0.000019602599152539803270939451436301600484477944841970\\,\\mathrm{i} & 1.05\\times 10^{-54}\\\\\\hline1 & 0.0860515 & 4.69506\\times 10^{-59} & -0.021535232957840081628895504228534967711997503902073+0.050793259803405121021601162287834264158883417941290\\,\\mathrm{i} & 5.15\\times 10^{-62}\\\\\\hline2 & 0.000315533 & 1.91839\\times 10^{-54} & -0.0364227 & 7.09\\times 10^{-59}\\\\\\hline2 & 0.00316518 & 1.01312\\times 10^{-51} & -0.10728297624437716920807617174198119355164845957477+0.000048161315224666904818742208368535336814131601996440\\,\\mathrm{i} & 1.55\\times 10^{-55}\\\\\\hline2 & 0.00197155 & 1.44210\\times 10^{-55} & 0.26219847641699031951840137046147371448416797914289-0.0756624272495095960511463847241… [latex truncated: 1355 chars total]",
