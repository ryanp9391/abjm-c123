      {
       "data": "Out[120]= \\begin{array}{|c|c|c|c|c|c|}\\hline\\text{singlet} & \\text{eps} & \\text{A = tau\\_F/(h\\^{}2 l1)} & \\text{B = tau\\_2(u0)/(2 h\\^{}4 y l2)} & \\text{C = tau\\^{}\\_3(u0)/(6 h\\^{}5 y\\^{}2 l3)} & \\text{A C}\\\\\\hline\\text{E = 20} & \\frac{1}{100} & 1.9669626 & -11.768200 & 1.9556064 & 3.8466046\\\\\\hline & \\frac{1}{200} & 1.9834283 & -11.883552 & 1.9777143 & 3.9226545\\\\\\hline & \\frac{1}{400} & 1.9917008 & -11.941638 & 1.9888349 & 3.9611641\\\\\\hline & \\frac{1}{800} & 1.9958471 & -11.970785 & 1.9944118 & 3.9805411\\\\\\hline & \\frac{1}{1600} & 1.9979227 & -11.985384 & 1.9972045 & 3.9902603\\\\\\hline & \\text{eps -> 0} & 2.00000000000 & -12.0000000000 & 2.00000000000 & 4.00000000000\\\\\\hline\\text{E = 4} & \\frac{1}{100} & -1.9962909 & 3.9811453 & -1.9847652 & 3.9621687\\\\\\hline & \\frac{1}{200} & -1.9981602 & 3.9905863 & -1.9924038 & 3.9811419\\\\\\hline & \\frac{1}{400} & -1.9990838 & 3.9952966 & -1.9962072 & 3.9905854\\\\\\hline & \\frac{1}{800} & -1.9995428 & 3.9976491 & -1.9981049 & 3.9952964\\\\\\hline & \\frac{1}{1600} & -1.9997716 & 3.9988248 & -1.9990528 & 3.9976491\\\\\\hline & \\text{eps -> 0} & -2.00000000000 & 4.00000000000 & -2.00000000000 & 4.00000000000\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
