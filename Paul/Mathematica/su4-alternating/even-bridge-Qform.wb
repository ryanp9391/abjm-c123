      {
       "data": "Out[91]= \\begin{array}{|c|c|c|c|c|c|c|}\\hline\\text{eps} & \\text{prec} & \\text{time (s)} & \\text{Gram time (s)} & \\text{Gram nonzeros} & \\text{max |Gram.sol - tau|} & \\text{memory (GB)}\\\\\\hline0.01 & 100.\\, & 6.4013061 & 5.1771186 & 5694.\\, & 0.\\times 10^{-87} & 3.773104936\\\\\\hline0.005 & 100.\\, & 6.1264992 & 4.9790633 & 5694.\\, & 0.\\times 10^{-85} & 3.752605872\\\\\\hline0.0025 & 100.\\, & 6.0007747 & 4.9494746 & 5694.\\, & 1.2\\times 10^{-101} & 3.731812224\\\\\\hline0.00125 & 110.\\, & 6.0810088 & 5.0125516 & 5694.\\, & 0.\\times 10^{-92} & 3.710688064\\\\\\hline0.000625 & 120.\\, & 6.4285623 & 5.2746557 & 5694.\\, & 2.5\\times 10^{-118} & 3.6895033440000002\\\\\\hline\\end{array}",
