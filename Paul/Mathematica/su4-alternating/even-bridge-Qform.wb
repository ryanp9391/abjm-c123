       "data": "Out[124]= \\begin{matrix}\\begin{matrix}\\text{singlet E = 20}\\\\\\begin{array}{|c|c|c|c|c|c|c|c|c|}\\hline\\text{eps} & \\text{nu y\\_2} & \\text{nu y\\_4} & \\text{y\\_2 + y\\_4} & \\text{g y\\_2 y\\_4} & \\text{B\\_1 = 1-(y2+y4)+g y2 y4} & \\text{B\\_\\{z2\\}(y)} & \\text{B\\_\\{z3\\}(y)} & \\text{sqrt|W|}\\\\\\hline\\frac{1}{100} & -0.49537952 & 0.50650017 & -3.0055824 & 1.0036942 & 5.0092766 & 5.0268084 & 5.0393461 & 5.0330733\\\\\\hline\\frac{1}{200} & -0.49769175 & 0.50324693 & -3.0028019 & 1.0018611 & 5.0046629 & 5.0134209 & 5.0196803 & 5.0165496\\\\\\hline\\frac{1}{400} & -0.49884637 & 0.50162267 & -3.0014036 & 1.0009340 & 5.0023376 & 5.0067146 & 5.0098420 & 5.0082780\\\\\\hline\\frac{1}{800} & -0.49942331 & 0.50081114 & -3.0007025 & 1.0004679 & 5.0011703 & 5.0033583 & 5.0049214 & 5.0041398\\\\\\hline\\frac{1}{1600} & -0.49971169 & 0.50040552 & -3.0003514 & 1.0002342 & 5.0005856 & 5.0016794 & 5.0024608 & 5.0020701\\\\\\hline\\text{eps -> 0} & -0.5000000 & 0.5000000 & -3.000000 & 1.0000000 & 5.000000 & 5.000000 & 5.000000 & 5.000000\\\\\\hline\\end{array}\\end{matrix}\\\\\\begin{matrix}\\text{singlet E = 4}\\\\\\begin{array}{|c|c|c|c|c|c|c|c|c|}\\hline\\text{eps} & \\text{nu y\\_2} & \\text{nu y\\_4} & \\text{y\\_2 + y\\_4} & \\text{g y\\_2 y\\_4} & \\text{B\\… [latex truncated: 2785 chars total]",
