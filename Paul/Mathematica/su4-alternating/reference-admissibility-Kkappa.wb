      {
       "data": "Out[186]= \\begin{array}{|c|c|}\\hline\\text{v.u = 0 for the random BPS reference} & \\mathrm{True}\\\\\\hline\\text{L = 2 full chain: all 5 words localise on pair 1; pair-1 vector = lambda\\_w x (1-pair word)} & \\left\\{\\mathrm{True},\\mathrm{True}\\right\\}\\\\\\hline\\text{same on W\\_a (a = 1/3)} & \\left\\{\\mathrm{True},\\mathrm{True}\\right\\}\\\\\\hline\\text{K\\_kappa coefficients of the calibration, pair level (W\\_a, kappa = 3/10): raKcoef x raLamW} & \\left\\{\\frac{2809}{19600},\\frac{159}{350},\\frac{636}{875},\\frac{1696}{4375},\\frac{192}{625}\\right\\}\\\\\\hline\\text{raTest on W\\_a (a = 1/3): must reproduce these coefficients} & \\left\\{5,\\left\\{5,5,5\\right\\},3,\\left\\{\\mathrm{True},\\text{0},\\mathrm{True},\\text{0},\\text{0},\\mathrm{True},\\text{0}\\right\\},\\mathrm{True},\\left\\{\\frac{2809}{19600},\\frac{159}{350},\\frac{636}{875},\\frac{1696}{4375},\\frac{192}{625}\\right\\}\\right\\}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
