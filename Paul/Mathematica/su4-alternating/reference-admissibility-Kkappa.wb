  {
   "kind": 2,
   "value": "raWch[zz_][a_, b_] := {1, zz[[b]], zz[[b]] (Total[zz] - zz[[a]] - zz[[b]]), (Times @@ zz)/zz[[a]], (Times @@ zz) zz[[b]]/zz[[a]]};\nraChSupp[v_, u_] := Select[Tuples[{Range[4], Range[4]}], #[[1]] != #[[2]] && v[[#[[1]]]] u[[#[[2]]]] =!= 0 &];\nraObsTab[v_, u_, zz_] := Module[{pw = raPairWordsZ[v, u, zz], comps = raKapComps[v, u], S = raChSupp[v, u], M},\n   M = Table[raWch[zz][s[[1]], s[[2]]], {s, S}];\n   {{\"v.u\", v . u}, {\"rank of the 5-word span\", MatrixRank[pw]}, {\"# kappa-components, their rank\", {Length[comps], MatrixRank[comps]}}, {\"dim(span intersect span of all kappa-components)\", MatrixRank[pw] + MatrixRank[comps] - MatrixRank[Join[pw, comps]]}, {\"charged support |S|, rank of the |S| x 5 eigenvalue matrix\", {Length[S], If[S === {}, 0, MatrixRank[M]]}}, {\"rank(span + T_kappa), kappa = 3/10, -7/5, 1/z4\", Table[MatrixRank[Append[pw, raTargetZ[v, u, kap, zz]]], {kap, raKaps}]}}];\nraFormal = raTwVacForm[raWw, raZg];\nGrid[{{\"formal twisted vacuum, GENERIC z = (3/2,5/4,2/3,4/7), w = (7/5,9/8,3/7,5/9)\", \"W_a (a=1/3), same generic z\"}, {Grid[raObsTab[raFormal[[1]], raFormal[[2]], raZg], Frame -> All, Alignment -> Left], Grid[raObsTab[raW[1/3][[1]], raW[1/3][[2]], raZg], Frame -> All, Alignment -> Left]}}, Frame -> All, Alignment -> Top]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
