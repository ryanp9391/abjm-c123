   "kind": 2,
   "value": "raTwLoc[name_, w_] := Module[{f = raTwVacForm[w, raZg]}, {name, f[[1]] . f[[2]], Table[f[[1, j]] f[[2, j]], {j, 4}], raOkZ[f[[1]], f[[2]], raZg]}];\nraTwLocs = Join[{raTwLoc[\"generic w\", raWw]},\n   Table[raTwLoc[\"w1 = z\" <> ToString[a], ReplacePart[raWw, 1 -> raZg[[a]]]], {a, 4}],\n   Table[raTwLoc[\"w2 = z\" <> ToString[ab[[1]]] <> \", w3 = z\" <> ToString[ab[[2]]], ReplacePart[raWw, {2 -> raZg[[ab[[1]]]], 3 -> raZg[[ab[[2]]]]}]], {ab, Subsets[Range[4], {2}]}]];\nGrid[Prepend[raTwLocs, {\"locus\", \"v.u\", \"pi_j = v_j u_j\", \"K-family exists at generic z\"}], Frame -> All, Alignment -> Left]",
