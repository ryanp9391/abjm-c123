  {
   "kind": 2,
   "value": "raEg[i_, j_] := Normal[raE[i, j]]; raI4 = IdentityMatrix[4];\nraGfam = {\n  {\"W_a: exp(E14/3)\", raI4 + (1/3) raEg[1, 4]},\n  {\"torus x W_a: diag(2,1,1,3) (1 + E14/5)\", DiagonalMatrix[{2, 1, 1, 3}] . (raI4 + (1/5) raEg[1, 4])},\n  {\"R5: 1 + 2E24 + 3E34   (v = e1)\", raI4 + 2 raEg[2, 4] + 3 raEg[3, 4]},\n  {\"R2: (1+2E12+3E13)(1+3E24-2E34)   (p.c = 0)\", (raI4 + 2 raEg[1, 2] + 3 raEg[1, 3]) . (raI4 + 3 raEg[2, 4] - 2 raEg[3, 4])},\n  {\"R2 broken: (1+2E12+3E13)(1+E24+E34)   (p.c = 5)\", (raI4 + 2 raEg[1, 2] + 3 raEg[1, 3]) . (raI4 + raEg[2, 4] + raEg[3, 4])},\n  {\"generic Borel element\", raGt},\n  {\"W_a x R2: exp(E14/3)(1+2E12+3E13)(1+3E24-2E34)\", (raI4 + (1/3) raEg[1, 4]) . (raI4 + 2 raEg[1, 2] + 3 raEg[1, 3]) . (raI4 + 3 raEg[2, 4] - 2 raEg[3, 4])}};\nraKop[kap_, G_] := Module[{o = {Normal[raT[1, 0, {\"A\", \"F\"}, {1, 0}, G]], Normal[raT[2, rah, {\"A\", \"F\"}, {1, 0}, G]], Normal[raT[3, rah, {\"A\", \"F\"}, {1, 0}, G, True]]}, c = raKcoef[kap] raLamW},\n   c[[1]] IdentityMatrix[16] + c[[2]] o[[1]] + c[[3]] o[[2]] + c[[4]] o[[3]] + c[[5]] o[[3]] . o[[1]]];\nraVac = raProd[{raUV[1], raUV[4]}];\nraCovRow[name_, g_] := Module[{Gt = g . raGp . Inverse[g], Gp, Rg = KroneckerProduct[g, Inverse[Transpose[g]]], vv, uu, kap = 3/10, lhs, tgt, a1, a2, a3, Kl, Kg},\n   Gp = Transpose[Gt];   (* G' = g^-T Lambda g^T *)\n   vv = raUV[1] . g; uu = raUV[4] . Inverse[Transpose[g]];\n   Kl = raKop[kap, raGp]; Kg = raKop[kap, Gp];\n   a1 = (raProd[{vv, uu}] . Kl == raVac . Kg . Rg);   (* exact covariance of the whole operator K *)\n   lhs = raVac . Kg; tgt = raProd[{raUV[1] . (raI4 - kap Gt), raUV[4] . Inverse[Transpose[raI4 - kap Gt]]}];\n   a2 = (lhs =!= ConstantArray[0, 16]) && MatrixRank[{lhs, tgt}] == 1;   (* <vac|K[G'] ~ <vac| rho(1 - kappa G'^T) *)\n   a3 = Table[MatrixPower[Gp, n][[4, 1]], {n, 1, 3}];\n   {name, vv, uu, raPred[vv, uu], a1, a2, a3, MatrixForm[Gp - DiagonalMatrix[Diagonal[Gp]]]}];\nGrid[Prepend[Table[raCovRow @@ r, {r, raGfam}], {\"g\", \"v = e1 g\", \"u = e4 g^-T\", \"closed form (5c) predicts admissible\", \"<vac|rho(g) K[Lambda] == <vac|K[G'] rho(g) (G' = g^-T Lam g^T, exact)\", \"<vac|K_kappa[G'] ~ <vac|rho(1-kappa G'^T)   [K_kappa with the fixed W_a coefficients]\", \"[G'^n]_41, n=1,2,3\", \"off-diagonal part of G'\"}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
