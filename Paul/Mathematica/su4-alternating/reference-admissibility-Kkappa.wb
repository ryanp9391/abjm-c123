  {
   "kind": 2,
   "value": "(* z2 = z3 (phi2 = phi3): reference = limit of the twisted vacuum, v = (0,1,-1,0); K_kappa acts as the F-site rotation only *)\nraUntw0[ep_, phi_, om_, cc_] := Module[{zz = 1 + ep phi, ww = 1 + ep om, kap = 1 - cc ep, u, T, Tp, nrm},\n   u = raTwVacForm[ww, zz][[2]]; T = raProd[{raTw (1 - kap zz), u/(1 - kap zz)}];\n   Tp = raProd[{raTw, Table[Product[phi[[j]] - om[[m]], {m, 3}]/(cc - phi[[j]]), {j, 4}]}];\n   nrm[x_] := x/Sqrt[x . x]; N[Min[Norm[N[nrm[T] - nrm[Tp], 20]], Norm[N[nrm[T] + nrm[Tp], 20]]], 5]];\nraUntwTab0 = Table[{e, raUntw0[10^-e, {9/10, 7/20, 7/20, -11/10}, {7/10, -3/10, 1/5, 1/2}, 4/5]}, {e, 2, 5}];\nGrid[Prepend[raUntwTab0, {\"eps = 10^-e\", \"phi2 = phi3: deviation of T_kappa from (0,1,-1,0) (x) (uhat_j/(c - phi_j))\"}], Frame -> All]",
   "languageId": "wolfram",
   "outputs": [
