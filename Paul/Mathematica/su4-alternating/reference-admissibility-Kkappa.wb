     "id": "e7cd9d8e-649f-41c6-9b13-092ad0747686"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* random test of the closed form: 3 sample types, exact rank test at kappa in {3/10,-7/5,1/z4} *)\nraRnd[] := RandomInteger[{1, 9}] RandomChoice[{-1, 1}]/RandomInteger[{1, 4}];\nraSampBlock[] := Module[{v = {0, 0, 0, 0}, u = {0, 0, 0, 0}, c, p, q, t}, (* blockwise-BPS by construction *)\n   c = RandomChoice[{1, 2, 3}]; If[c == 1, v[[1]] = raRnd[]]; If[c == 2, u[[1]] = raRnd[]];\n   c = RandomChoice[{1, 2, 3}]; If[c == 1, v[[4]] = raRnd[]]; If[c == 2, u[[4]] = raRnd[]];\n   p = If[RandomInteger[{0, 2}] == 0, {0, 0}, {raRnd[], raRnd[]}];\n   q = If[p == {0, 0}, If[RandomInteger[{0, 2}] == 0, {0, 0}, {raRnd[], raRnd[]}], t = If[RandomInteger[{0, 3}] == 0, 0, raRnd[]]; t {p[[2]], -p[[1]]}];\n   v[[{2, 3}]] = p; u[[{2, 3}]] = q; {v, u}];\nraSampW[] := Module[{v1 = raRnd[], v4 = raRnd[], t = raRnd[]}, {{v1, 0, 0, v4}, t {v4, 0, 0, -v1}}];\nraSampRand[] := Module[{v, u, js}, (* random zero pattern, then v.u = 0 imposed by adjusting one u_j *)\n   v = Table[If[RandomInteger[{0, 9}] < 4, 0, raRnd[]], 4]; u = Table[If[RandomInteger[{0, 9}] < 4, 0, raRnd[]], 4];\n   js = Flatten[Position[v, x_ /; x =!= 0, {1}, Heads -> False]];\n   If[js === {}, v[[RandomInteger[{1, 4}]]] = raRnd[]; js = Flatten[Position[v, x_ /; x =!= 0, {1}, Heads -> False]]];\n   With[{j = RandomChoice[js]}, u[[j]] = u[[j]] - (v . u)/v[[j]]]; {v, u}];\nSeedRandom[20261013];\nraTally[gen_, n_] := Module[{res = Table[Module[{s = gen[], v, u}, {v, u} = s; If[MatrixRank[{v, u}] == 0 || v . u =!= 0 || AllTrue[v, # === 0 &] || AllTrue[u, # === 0 &], Nothing, {raPred[v, u], raTest[v, u][[5]]}]], {n}]},\n   {Length[res], Count[res, {True, _}], Count[res, {_, True}], Count[res, {a_, b_} /; a =!= b]}];\nraRndTab = {{\"blockwise-BPS by construction\", raTally[raSampBlock, 60]}, {\"W-type (p=q=0)\", raTally[raSampW, 20]}, {\"random zero pattern + v.u=0\", raTally[raSampRand, 150]}};\nGrid[Prepend[{#[[1]], #[[2, 1]], #[[2, 2]], #[[2, 3]], #[[2, 4]]} & /@ raRndTab, {\"sample type\", \"# samples\", \"# predicted admissible\", \"# K_kappa exists (rank test)\", \"# disagreements\"}], Frame -> All]",
   "languageId": "wolfram",
   "outputs": [
