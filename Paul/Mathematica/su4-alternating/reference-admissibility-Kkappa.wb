     "id": "30228afe-9d2d-4c94-9640-bad5fe4738ba"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "raCoefs[v_, u_, kap_] := Module[{c = Array[raCc, 5], s}, s = Quiet[Solve[Thread[c . raPairWords[v, u] == raTarget[v, u, kap]/(1 - kap raY)^2], c]]; If[s === {}, None, (c /. First[s]) /. raCc[_] -> 0]];\nraLamW3 = Module[{l = {1, raLam[1, raTh3[[2]], Drop[raTh3, 2]], raLam[2, raTh3[[2]] + rah, Drop[raTh3, 2]], raLam[3, raTh3[[2]] + rah, Drop[raTh3, 2]], 0}}, l[[5]] = l[[4]] l[[2]]; l];\nraL3Loc[v_, u_] := Module[{psi = raModA[raProd[{v, u, v, u, v, u}]], rest = raModA[raProd[{v, u, v, u}]], ws, pw = raPairWords[v, u]},\n   ws = raWordsP[psi, raTypes3, raTh3, DiagonalMatrix[raZ]];\n   {ws, Table[Mod[ws[[i]] - raMod[raLamW3[[i]]] Flatten[Outer[Times, raModA[pw[[i]]], rest]], raP] === ConstantArray[0, 4096], {i, 5}]}];\nraL3Check[name_, v_, u_] := Module[{ws, loc, rest = raModA[raProd[{v, u, v, u}]], res},\n   {ws, loc} = raL3Loc[v, u];\n   res = Table[Module[{c = raCoefs[v, u, kap]}, If[c === None, \"no pair-level solution\", Mod[Sum[raMod[c[[i]]/raLamW3[[i]]] ws[[i]], {i, 5}], raP] === Mod[Flatten[Outer[Times, raModA[raTarget[v, u, kap]/(1 - kap raY)^2], rest]], raP]]], {kap, raKaps}];\n   {name, loc, res}];\nraTw = {0, 1, -1, 0};\nraL3Tab = {\n   raL3Check[\"W_a, a = 1/3\", raW[1/3][[1]], raW[1/3][[2]]],\n   raL3Check[\"<0_w| at z2=z3 (limit), generic w: v = (0,1,-1,0), u = u_w\", raTw, raTwVacForm[raWw, raZp][[2]]],\n   raL3Check[\"<0_w| limit, w1 = z1 locus: v = e1, u = u_w\", raUV[1], raTwVacForm[raWw1, raZp][[2]]],\n   raL3Check[\"<0|_comp limit: (0,1,-1,0) (x) (1,1,1,1)\", raTw, {1, 1, 1, 1}],\n   raL3Check[\"R2: v = (1,2,3,0), u = (0,3,-2,5)\", {1, 2, 3, 0}, {0, 3, -2, 5}],\n   raL3Check[\"R5: v = e1, u = (0,2,3,5)\", {1, 0, 0, 0}, {0, 2, 3, 5}],\n   raL3Check[\"R6: v = (0,2,3,0), u = (1,3,-2,4)\", {0, 2, 3, 0}, {1, 3, -2, 4}],\n   raL3Check[\"closure R1: v = (1,2,3,2), u = (0,3,-2,0)\", {1, 2, 3, 2}, {0, 3, -2, 0}],\n   raL3Check[\"negative control: random BPS (no K-family): localisation only\", raV0, raU0]};\nGrid[Prepend[raL3Tab, {\"reference (v (x) u)^3\", \"5 words localise on pair 1 (word = lambda_w x pair-word (x) rest)\", \"sum_w c_w/lambda_w <psi|w == T_kappa/(1-kappa y)^2 (x) rest   for kappa = 3/10, -7/5, 1/z4\"}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
