      {
       "data": "Out[239]= \\begin{array}{|c|c|}\\hline\\text{formal twisted vacuum, GENERIC z = (3/2,5/4,2/3,4/7), w = (7/5,9/8,3/7,5/9)} & \\text{W\\_a (a=1/3), same generic z}\\\\\\hline\\begin{array}{|c|c|}\\hline\\text{v.u} & 0\\\\\\hline\\text{rank of the 5-word span} & 5\\\\\\hline\\text{\\# kappa-components, their rank} & \\left\\{13,13\\right\\}\\\\\\hline\\text{dim(span intersect span of all kappa-components)} & 2\\\\\\hline\\text{charged support |S|, rank of the |S| x 5 eigenvalue matrix} & \\left\\{12,5\\right\\}\\\\\\hline\\text{rank(span + T\\_kappa), kappa = 3/10, -7/5, 1/z4} & \\left\\{6,6,6\\right\\}\\\\\\hline\\end{array} & \\begin{array}{|c|c|}\\hline\\text{v.u} & 0\\\\\\hline\\text{rank of the 5-word span} & 5\\\\\\hline\\text{\\# kappa-components, their rank} & \\left\\{13,3\\right\\}\\\\\\hline\\text{dim(span intersect span of all kappa-components)} & 2\\\\\\hline\\text{charged support |S|, rank of the |S| x 5 eigenvalue matrix} & \\left\\{2,2\\right\\}\\\\\\hline\\text{rank(span + T\\_kappa), kappa = 3/10, -7/5, 1/z4} & \\left\\{6,6,6\\right\\}\\\\\\hline\\end{array}\\\\\\hline\\end{array}",
