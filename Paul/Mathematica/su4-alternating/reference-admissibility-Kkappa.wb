      {
       "data": "Out[234]= \\begin{array}{|c|c|c|}\\hline\\text{a} & \\text{b} & \\text{\\{e\\_a(x)e\\_b is an eigenvector, eigenvalue == prediction\\} for x1, x2, x3 (symbolic z, exact)}\\\\\\hline1 & 2 & \\begin{pmatrix}\\mathrm{True} & \\mathrm{True}\\\\\\mathrm{True} & \\mathrm{True}\\\\\\mathrm{True} & \\mathrm{True}\\end{pmatrix}\\\\\\hline1 & 3 & \\begin{pmatrix}\\mathrm{True} & \\mathrm{True}\\\\\\mathrm{True} & \\mathrm{True}\\\\\\mathrm{True} & \\mathrm{True}\\end{pmatrix}\\\\\\hline1 & 4 & \\begin{pmatrix}\\mathrm{True} & \\mathrm{True}\\\\\\mathrm{True} & \\mathrm{True}\\\\\\mathrm{True} & \\mathrm{True}\\end{pmatrix}\\\\\\hline2 & 1 & \\begin{pmatrix}\\mathrm{True} & \\mathrm{True}\\\\\\mathrm{True} & \\mathrm{True}\\\\\\mathrm{True} & \\mathrm{True}\\end{pmatrix}\\\\\\hline2 & 3 & \\begin{pmatrix}\\mathrm{True} & \\mathrm{True}\\\\\\mathrm{True} & \\mathrm{True}\\\\\\mathrm{True} & \\mathrm{True}\\end{pmatrix}\\\\\\hline2 & 4 & \\begin{pmatrix}\\mathrm{True} & \\mathrm{True}\\\\\\mathrm{True} & \\mathrm{True}\\\\\\mathrm{True} & \\mathrm{True}\\end{pmatrix}\\\\\\hline3 & 1 & \\begin{pmatrix}\\mathrm{True} & \\mathrm{True}\\\\\\mathrm{True} & \\mathrm{True}\\\\\\mathrm{True} & \\mathrm{True}\\end{pmatrix}\\\\\\hline3 & 2 & \\begin{pmatrix}\\mathrm{True} & \\mathrm{True}\\\\\\mathrm{True} & \\mathrm{True}\\\\\\mathrm{Tru… [latex truncated: 1790 chars total]",
