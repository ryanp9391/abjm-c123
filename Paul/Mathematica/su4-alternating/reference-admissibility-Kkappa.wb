      {
       "data": "Out[196]= \\begin{array}{|c|c|}\\hline\\text{Gc(z) V == V Lambda} & \\mathrm{True}\\\\\\hline\\text{t1\\^{}\\{Gc\\}(u) R == R t1\\^{}Lambda(u), one pair, symbolic u} & \\mathrm{True}\\\\\\hline\\text{Gc(w) v\\_w = w1 v\\_w ;  u\\_w Gc(w) = w4 u\\_w} & \\left\\{\\mathrm{True},\\mathrm{True}\\right\\}\\\\\\hline\\text{diagonal-frame image v = v\\_w V\\^{}-T equals lambda\\_j prod(w1 - z\\_m)} & \\mathrm{True}\\\\\\hline\\text{u = u\\_w V proportional to prod\\_\\{m<=3\\}(z\\_j - w\\_m); ratio} & \\left\\{\\mathrm{True},\\frac{25515}{1558}\\right\\}\\\\\\hline\\text{v.u == 0} & \\mathrm{True}\\\\\\hline\\text{(v u v u) eigenbra of t1\\^{}Lambda(z)(u) at L = 2 with the w-vacuum eigenvalue? (u = 1/3, -5/7, 9/4)} & \\mathrm{False}\\\\\\hline\\text{(v u v u) eigenbra of t1\\^{}\\{G'\\_w\\}(u), G'\\_w = V(z)\\^{}-1 Gc(w) V(z), with the w-vacuum eigenvalue (u = 1/3, -5/7, 9/4)} & \\mathrm{True}\\\\\\hline\\text{eigenvalues of G'\\_w} & \\left\\{\\frac{7}{5},\\frac{9}{8},\\frac{5}{9},\\frac{3}{7}\\right\\}\\\\\\hline\\text{z3 = y + del: coefficient of 1/del in v} & \\left\\{0,-\\frac{174}{2375},\\frac{174}{2375},0\\right\\}\\\\\\hline\\text{predicted c (0,-1,1,0)} & \\left\\{0,-\\frac{174}{2375},\\frac{174}{2375},0\\right\\}\\\\\\hline\\text{O(1) part of v} & \\left\\{\\frac{522}{1625},\\frac{232}{475},\\frac{8352}… [latex truncated: 1254 chars total]",
