       "data": "Out[377]= \\begin{array}{|c|c|c|c|}\\hline\\text{locus} & \\text{v.u} & \\text{pi\\_j = v\\_j u\\_j} & \\text{K-family exists at generic z}\\\\\\hline\\text{generic w} & 0 & \\left\\{\\frac{8613}{455000},-\\frac{22011}{2327500},-\\frac{10527}{490000},\\frac{29667}{2470000}\\right\\} & \\mathrm{False}\\\\\\hline\\text{w1 = z1} & 0 & \\left\\{0,0,0,0\\right\\} & \\mathrm{True}\\\\\\hline\\text{w1 = z2} & 0 & \\left\\{0,0,0,0\\right\\} & \\mathrm{True}\\\\\\hline\\text{w1 = z3} & 0 & \\left\\{0,0,0,0\\right\\} & \\mathrm{True}\\\\\\hline\\text{w1 = z4} & 0 & \\left\\{0,0,0,0\\right\\} & \\mathrm{True}\\\\\\hline\\text{w2 = z1, w3 = z2} & 0 & \\left\\{0,0,\\frac{957}{10000},-\\frac{957}{10000}\\right\\} & \\mathrm{False}\\\\\\hline\\text{w2 = z1, w3 = z3} & 0 & \\left\\{0,\\frac{319}{23750},0,-\\frac{319}{23750}\\right\\} & \\mathrm{False}\\\\\\hline\\text{w2 = z1, w3 = z4} & 0 & \\left\\{0,\\frac{957}{61250},-\\frac{957}{61250},0\\right\\} & \\mathrm{False}\\\\\\hline\\text{w2 = z2, w3 = z3} & 0 & \\left\\{\\frac{319}{32500},0,0,-\\frac{319}{32500}\\right\\} & \\mathrm{False}\\\\\\hline\\text{w2 = z2, w3 = z4} & 0 & \\left\\{\\frac{957}{87500},0,-\\frac{957}{87500},0\\right\\} & \\mathrm{False}\\\\\\hline\\text{w2 = z3, w3 = z4} & 0 & \\left\\{\\frac{319}{8750},-\\frac{319}{8750},0,0\\right\\} & \\mathrm{False}\\\\\\hl… [latex truncated: 1214 chars total]",
