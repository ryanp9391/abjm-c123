       "data": "Out[200]= \\begin{array}{|c|c|c|c|c|c|c|c|c|}\\hline\\text{reference} & \\text{v} & \\text{u} & \\text{rank span} & \\text{rank span+T\\_kappa (3 kappas)} & \\text{\\# nonzero kappa-components} & \\text{components in span (D,B12,B14,B21,B24,B41,B42)} & \\text{K-family exists} & \\text{coefficients at kappa=3/10 (target T/(1-kap y)\\^{}2; W\\_a: = raKcoef raLamW)}\\\\\\hline\\text{(1) W\\_a, a = 1/3} & \\left\\{1,0,0,\\frac{1}{3}\\right\\} & \\left\\{-\\frac{1}{3},0,0,1\\right\\} & 5 & \\left\\{5,5,5\\right\\} & 3 & \\left\\{\\mathrm{True},\\text{0},\\mathrm{True},\\text{0},\\text{0},\\mathrm{True},\\text{0}\\right\\} & \\mathrm{True} & \\left\\{\\frac{2809}{19600},\\frac{159}{350},\\frac{636}{875},\\frac{1696}{4375},\\frac{192}{625}\\right\\}\\\\\\hline\\text{(1) W\\_a, a = -1} & \\left\\{1,0,0,-1\\right\\} & \\left\\{1,0,0,1\\right\\} & 5 & \\left\\{5,5,5\\right\\} & 3 & \\left\\{\\mathrm{True},\\text{0},\\mathrm{True},\\text{0},\\text{0},\\mathrm{True},\\text{0}\\right\\} & \\mathrm{True} & \\left\\{\\frac{2809}{19600},\\frac{159}{350},\\frac{636}{875},\\frac{1696}{4375},\\frac{192}{625}\\right\\}\\\\\\hline\\text{(1) W\\_0 = bare vacuum e1 (x) e4} & \\left\\{1,0,0,0\\right\\} & \\left\\{0,0,0,1\\right\\} & 1 & \\left\\{1,1,1\\right\\} & 1 & \\left\\{\\text{0},\\text{0},\\mathrm{True},\\text{0},\\text{0}… [latex truncated: 7944 chars total]",
