       "data": "Out[323]= \\begin{array}{|c|c|}\\hline\\text{eps = 10\\^{}-e} & \\text{generic phi (phi2 != phi3): deviation from (vhat D) (x) (uhat D\\^{}-1) for D = c - phi | D = c + phi}\\\\\\hline2 & \\left\\{0.030120,1.0069\\right\\}\\\\\\hline3 & \\left\\{0.0029536,0.98348\\right\\}\\\\\\hline4 & \\left\\{0.00029478,0.98118\\right\\}\\\\\\hline5 & \\left\\{0.000029472,0.98095\\right\\}\\\\\\hline\\end{array}",
