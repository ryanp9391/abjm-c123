       "data": "Out[158]= \\begin{array}{|c|c|}\\hline\\text{k} & \\text{max |fused t\\_k - quantum-minor t\\_k| (exact, 1 pair, random twist raG0)}\\\\\\hline1 & 0\\\\\\hline2 & 0\\\\\\hline3 & 0\\\\\\hline4 & 0\\\\\\hline\\end{array}",
