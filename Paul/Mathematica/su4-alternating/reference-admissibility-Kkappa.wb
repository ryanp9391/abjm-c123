      {
       "data": "Out[170]= \\begin{array}{|c|c|c|}\\hline\\text{build time (s)} & 5.7256553 & \\\\\\hline\\text{lambda1, lambda2, lambda3} & \\left\\{-\\frac{99}{1600},-\\frac{55539}{2560000},-\\frac{40851459}{4096000000}\\right\\} & \\\\\\hline\\text{kappa} & \\text{a'} & \\text{<W\\_a\\^{}2| K\\_kappa == (1 - kappa z1)\\^{}2 <W\\_a' (x) W\\_a| (exact)}\\\\\\hline\\frac{3}{10} & \\frac{116}{231} & \\mathrm{True}\\\\\\hline-\\frac{7}{5} & \\frac{6}{31} & \\mathrm{True}\\\\\\hline\\frac{7}{4} & 0 & \\mathrm{True}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "973e6173-36d0-4c54-91e9-62b9e8d391bc"
