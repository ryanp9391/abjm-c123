      {
       "data": "Out[211]= \\begin{array}{|c|c|c|c|c|c|c|c|c|}\\hline\\text{reference (z2=z3 chain)} & \\text{v} & \\text{u} & \\text{v.u=0} & \\text{closed form predicts} & \\text{K\\_kappa exists (exact rank test, 3 kappas)} & \\text{agree} & \\text{rank of 5-word span} & \\text{\\# nonzero kappa-components}\\\\\\hline\\text{Borel: W-type, v=(1,0,0,2), u=(-6,0,0,3)} & \\left\\{1,0,0,2\\right\\} & \\left\\{-6,0,0,3\\right\\} & \\mathrm{True} & \\mathrm{True} & \\mathrm{True} & \\mathrm{True} & 5 & 3\\\\\\hline\\text{Borel: v=(1,0,0,v4), u generic (q != 0)} & \\left\\{1,0,0,2\\right\\} & \\left\\{-6,1,2,3\\right\\} & \\mathrm{True} & \\mathrm{False} & \\mathrm{False} & \\mathrm{True} & 5 & 5\\\\\\hline\\text{Borel: v generic, u=(-v4,0,0,1)} & \\left\\{1,-\\frac{2}{3},\\frac{5}{7},\\frac{3}{2}\\right\\} & \\left\\{-\\frac{3}{2},0,0,1\\right\\} & \\mathrm{True} & \\mathrm{False} & \\mathrm{False} & \\mathrm{True} & 5 & 5\\\\\\hline\\text{Borel: gl(2)-symmetric v=(1,2,2,3), u=(-4,1/4,1/4,1)} & \\left\\{1,2,2,3\\right\\} & \\left\\{-4,\\frac{1}{4},\\frac{1}{4},1\\right\\} & \\mathrm{True} & \\mathrm{False} & \\mathrm{False} & \\mathrm{True} & 5 & 7\\\\\\hline\\text{Borel: gl(2)-symmetric v=(1,2,2,0), u=(0,0,0,1)} & \\left\\{1,2,2,0\\right\\} & \\left\\{0,0,0,1\\right\\} & \\mathrm{True} & \\mathrm{True} & \\… [latex truncated: 2888 chars total]",
