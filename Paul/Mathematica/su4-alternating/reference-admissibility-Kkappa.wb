       "data": "Out[244]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{k} & \\text{rho(g) t\\_k\\^{}Lambda rho(g)\\^{}-1 == t\\_k\\^{}\\{G'\\} with G' = g\\^{}-1 Lam g} & \\text{G' = g Lam g\\^{}-1} & \\text{G' = g\\^{}T Lam g\\^{}-T} & \\text{G' = g\\^{}-T Lam g\\^{}T}\\\\\\hline1 & \\mathrm{False} & \\mathrm{False} & \\mathrm{False} & \\mathrm{True}\\\\\\hline2 & \\mathrm{False} & \\mathrm{False} & \\mathrm{False} & \\mathrm{True}\\\\\\hline3 & \\mathrm{False} & \\mathrm{False} & \\mathrm{False} & \\mathrm{True}\\\\\\hline\\end{array}",
