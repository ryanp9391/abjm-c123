   "kind": 2,
   "value": "(* constants of the words, L = 3, standard point (exact), and the symbolic factored forms of d_k at L = 3 *)\nobd3 = Table[obD[k, obTH[[;; 6]], 3], {k, 6}]; obc3 = FoldList[Times, obd3];\nobdSym = Table[Factor[obD[k, Array[obq, 6], 3]], {k, 6}];\nGrid[Prepend[Table[{k, If[OddQ[k], \"A, inverse letter\", \"F, forward letter\"], obd3[[k]], obc3[[k]], N[obc3[[k]], 8], obdSym[[k]]}, {k, 6}], {\"k\", \"letter\", \"d_k (exact, standard point)\", \"c_k = d_1...d_k\", \"c_k (numeric)\", \"d_k symbolic (q_s = theta_s, h = 1/2)\"}], Frame -> All, Alignment -> Left]",
