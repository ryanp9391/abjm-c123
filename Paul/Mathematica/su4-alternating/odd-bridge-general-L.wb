      {
       "data": "Out[154]= \\begin{array}{|c|c|c|c|c|c|c|c|c|c|}\\hline\\text{\\#} & \\text{Dynkin} & \\text{weight} & \\text{sector dim} & \\text{E\\_MZ} & \\text{|psi - S psi|} & \\text{V0 = <vac\\^{}L|psi>} & \\text{X11\\_p, p=1,2,3} & \\text{X44\\_p, p=1,2,3} & \\text{C\\_1 (data)}\\\\\\hline1 & \\left\\{3,0,3\\right\\} & \\left\\{3,0,0,-3\\right\\} & 1 & 0.\\, & \\text{0.} & 1.\\, & \\left\\{0,0,0\\right\\} & \\left\\{0,0,0\\right\\} & 1.\\,\\\\\\hline2 & \\left\\{4,0,0\\right\\} & \\left\\{3,-1,-1,-1\\right\\} & 6 & 12.\\, & \\text{6.1}\\times 10^{\\text{-16}} & 0 & \\left\\{0,0,0\\right\\} & \\left\\{0,0,0\\right\\} & 0\\\\\\hline3 & \\left\\{1,2,1\\right\\} & \\left\\{2,1,-1,-2\\right\\} & 9 & 12.\\, & \\text{7.7}\\times 10^{\\text{-16}} & 0 & \\left\\{0,0,0\\right\\} & \\left\\{0,0,0\\right\\} & 0\\\\\\hline4 & \\left\\{1,2,1\\right\\} & \\left\\{2,1,-1,-2\\right\\} & 9 & 12.\\, & \\text{7.7}\\times 10^{\\text{-16}} & 0 & \\left\\{0,0,0\\right\\} & \\left\\{0,0,0\\right\\} & 0\\\\\\hline5 & \\left\\{2,0,2\\right\\} & \\left\\{2,0,0,-2\\right\\} & 24 & 8.000000000000004 & \\text{2.5}\\times 10^{\\text{-16}} & 0 & \\left\\{0.\\, +0.2041241452319312\\,\\mathrm{i},0.\\, +0.2041241452319313\\,\\mathrm{i},0.\\, +0.20412414523193123\\,\\mathrm{i}\\right\\} & \\left\\{0.\\, +0.204124145231931\\,\\mathrm{i},0.\\, +0.20412414523193126\\,\\mathrm{i},0.… [latex truncated: 5282 chars total]",
