   "kind": 2,
   "value": "obPhi3f = {0.5, 0.1, -0.4, -1.3};\nobHat = Flatten[Table[Module[{tw = obGetTw[ph[[1]], ph[[2]], eps, 0.], th = N[obThABJM], Wb = obProd[obRefW[3, 1/3.]]},\n     Table[Module[{psi = tw[i][\"psi\"], tau = tw[i][\"taus\"], t1, t2, K},\n       t1 = obC[1, th, 3] tau[[1]]; t2 = tau[[2]]/obD[2, th, 3]; K = (Wb . psi)/(eps (1/3.) (ph[[2, 4]] - ph[[2, 1]]));\n       {ph[[1]], eps, obHW[[i, \"dyn\"]], N[obHW[[i, \"E\"]]], obFmt[t1], obFmt[t2], obFmt[K], obFmt[(1 - 1/t1) K], obFmt[(t2 - 1)/t1 K], obFmt[obHW[[i, \"C\"]][[2]]]}], {i, {5, 6, 7}}]], {ph, {{\"phi1\", obPhi1f}, {\"phi2\", obPhi2f}, {\"phi3\", obPhi3f}}}, {eps, {0.001, 0.0001, 0.00001}}], 2];\nGrid[Prepend[obHat, {\"phi\", \"eps\", \"Dynkin\", \"E_MZ\", \"hat tau_1\", \"hat tau_2\", \"K = <W|Psi_eps>/(eps a (phi4 - phi1))\", \"(1 - 1/hat tau_1) K\", \"(hat tau_2 - 1) K/hat tau_1\", \"C_1 (data)\"}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
