       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[138]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{k} & \\text{family} & \\text{pair p} & \\text{residual vector exactly 0 (exact rational arithmetic)} & \\text{vector length}\\\\\\hline1 & \\text{A-site family (b)} & 1 & \\mathrm{True} & 4096\\\\\\hline2 & \\text{F-site family (a)} & 1 & \\mathrm{True} & 4096\\\\\\hline3 & \\text{A-site family (b)} & 2 & \\mathrm{True} & 4096\\\\\\hline4 & \\text{F-site family (a)} & 2 & \\mathrm{True} & 4096\\\\\\hline5 & \\text{A-site family (b)} & 3 & \\mathrm{True} & 4096\\\\\\hline6 & \\text{F-site family (a)} & 3 & \\mathrm{True} & 4096\\\\\\hline\\end{array}",
