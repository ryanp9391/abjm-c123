       "data": "Out[195]= \\begin{array}{|c|c|c|c|c|c|c|}\\hline\\text{theta\\_A - theta\\_F} & \\text{k} & \\text{tau(theta\\_k) on vac} & \\text{d\\_k} & \\text{hat tau\\_k} & \\text{z\\_1 or z\\_4} & \\text{|vac t - tau vac|}\\\\\\hline1.\\, & 1 & 0.325 & 4.\\, & 1.3 & 1.3 & 0.\\,\\\\\\hline1.\\, & 2 & 0.175 & 0.25 & 0.7 & 0.7 & 0.\\,\\\\\\hline1.\\, & 3 & 0.325 & 4.\\, & 1.3 & 1.3 & 0.\\,\\\\\\hline1.\\, & 4 & 0.175 & 0.25 & 0.7 & 0.7 & 0.\\,\\\\\\hline0.1 & 1 & 0.0032500000000000007 & 399.99999999999994 & 1.3 & 1.3 & 0.\\,\\\\\\hline0.1 & 2 & 0.0017500000000000003 & 0.0025000000000000005 & 0.7 & 0.7 & 0.\\,\\\\\\hline0.1 & 3 & 0.0032500000000000007 & 399.99999999999994 & 1.3 & 1.3 & 0.\\,\\\\\\hline0.1 & 4 & 0.0017500000000000003 & 0.0025000000000000005 & 0.7 & 0.7 & 0.\\,\\\\\\hline0.001 & 1 & 3.250000000000006\\times 10^{-7} & 3.9999999999999925\\times 10^{6} & 1.3 & 1.3 & 0.\\,\\\\\\hline0.001 & 2 & 1.750000000000003\\times 10^{-7} & 2.5000000000000047\\times 10^{-7} & 0.7 & 0.7 & 0.\\,\\\\\\hline0.001 & 3 & 3.250000000000006\\times 10^{-7} & 3.9999999999999925\\times 10^{6} & 1.3 & 1.3 & 0.\\,\\\\\\hline0.001 & 4 & 1.750000000000003\\times 10^{-7} & 2.5000000000000047\\times 10^{-7} & 0.7 & 0.7 & 0.\\,\\\\\\hline0.00001 & 1 & 3.2500000000065\\times 10^{-11} & 3.999999999992\\time… [latex truncated: 1563 chars total]",
