      {
       "data": "Out[350]= \\begin{array}{|c|c|c|c|c|c|}\\hline\\text{$\\varepsilon$ = $\\delta$} & \\text{|⟨$\\Psi$\\_$\\varepsilon$|$\\Psi$⟩|} & \\text{|LHS−RHS|/|LHS|} & \\text{LHS = ⟨B₁|$\\Psi$⟩} & \\text{|⟨W|$\\Psi$⟩|} & \\text{|bracket|}\\\\\\hline\\left\\{2,0,2\\right\\} & \\text{C₁(HW) = 1.} &  &  &  & \\\\\\hline\\frac{1}{100} & \\text{1.} & \\text{0} & \\text{1.} & \\text{1.} & \\text{1.}\\\\\\hline\\frac{1}{1000} & \\text{1.} & \\text{0} & \\text{1.} & \\text{1.} & \\text{1.}\\\\\\hline\\frac{1}{10000} & \\text{1.} & \\text{0} & \\text{1.} & \\text{1.} & \\text{1.}\\\\\\hline\\left\\{1,0,1\\right\\} & \\text{C₁(HW) = 0.144338 - 0.25 I} &  &  &  & \\\\\\hline\\frac{1}{100} & \\text{9.99895}\\times 10^{\\text{-1}} & \\text{2.78845}\\times 10^{\\text{-14}} & \\text{-2.85608}\\times 10^{\\text{-1}}+\\left(\\text{1.38603}\\times 10^{\\text{-2}}\\right)\\,\\mathrm{i} & \\text{3.29478}\\times 10^{\\text{-3}} & \\text{8.67868}\\times 10^{\\text{1}}\\\\\\hline\\frac{1}{1000} & \\text{9.99999}\\times 10^{\\text{-1}} & \\text{1.73105}\\times 10^{\\text{-12}} & \\text{-2.88401}\\times 10^{\\text{-1}}+\\left(\\text{1.39866}\\times 10^{\\text{-3}}\\right)\\,\\mathrm{i} & \\text{3.32951}\\times 10^{\\text{-4}} & \\text{8.66207}\\times 10^{\\text{2}}\\\\\\hline\\frac{1}{10000} & \\text{1.} & \\text{3.48049}\\times 10^{\\text{-11}… [latex truncated: 2267 chars total]",
       "mime": "text/plain"
      }
     ],
     "id": "b341be50-4d57-45f4-a35c-82f2b02b1b04"
