      {
       "data": "Out[174]= \\begin{array}{|c|c|c|}\\hline\\text{candidate} & \\text{‖[t₁, Ŝ]$\\psi$‖} & \\text{‖[t₃, Ŝ]$\\psi$‖}\\\\\\hline\\text{S$\\circ$R(sites 3..L)} & 3.657906868939635\\times 10^{-17} & 3.70476693839805\\times 10^{-22}\\\\\\hline\\text{R(sites 3..L)$\\circ$S} & 0.023425616802596416 & 9.516342278147982\\times 10^{-8}\\\\\\hline\\text{S$\\circ$R(sites 1,2)} & 0.023425616802596416 & 9.516342278147982\\times 10^{-8}\\\\\\hline\\text{R(sites 1,2)$\\circ$S} & 3.657906868939635\\times 10^{-17} & 3.70476693839805\\times 10^{-22}\\\\\\hline\\text{plain S} & 0.011702918392912473 & 4.6867905959482526\\times 10^{-8}\\\\\\hline\\end{array}",
