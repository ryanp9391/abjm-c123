       "data": "Out[180]= \\begin{array}{|c|c|}\\hline\\text{dim \\{$\\Psi$, $\\chi$\\}} & 2\\\\\\hline\\text{eigenvalues of t₁(0.37) on it} & \\left\\{-0.061933559999999985,-0.06193355999999989\\right\\}\\\\\\hline\\text{eigenvalues of t₃(0.41) on it} & \\left\\{0.00001130095191829707,0.000011300951918297068\\right\\}\\\\\\hline\\text{eigenvalues of t₂(0.37) on it} & \\left\\{0.0016340603113926006,0.001634060311392599\\right\\}\\\\\\hline\\text{eigenvalues of t₂(−0.61) on it} & \\left\\{0.2486648883758882,0.2486648883758882\\right\\}\\\\\\hline\\text{eigenvalues of S on it} & \\left\\{-1.\\,,0.9999999999999998\\right\\}\\\\\\hline\\text{[t₂, t₁] = 0 (rel)} & 8.210842091870131\\times 10^{-20}\\\\\\hline\\end{array}",
