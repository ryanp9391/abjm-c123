       "data": "Out[164]= \\begin{array}{|c|c|c|c|c|c|c|c|c|}\\hline\\text{Dynkin} & \\text{sector dim} & \\text{dim joint eigenspace of $\\Psi$} & \\text{|a|} & \\text{‖$\\chi$‖} & \\text{$\\chi$ eigen, same $\\lambda$ (rel res)} & \\text{max ‖J₊$\\chi$‖/‖$\\chi$‖} & \\text{‖S$\\chi$−$\\chi$‖} & \\text{‖S$\\chi$+$\\chi$‖}\\\\\\hline\\left\\{1,0,1\\right\\} & 12 & 2 & \\text{9.94}\\times 10^{\\text{-1}} & \\text{1.11}\\times 10^{\\text{-1}} & \\text{9.83}\\times 10^{\\text{-4}} & \\text{2.25}\\times 10^{\\text{-4}} & \\text{2.} & \\text{2.4}\\times 10^{\\text{-3}}\\\\\\hline\\left\\{1,0,1\\right\\} & 12 & 1 & \\text{1.} & \\text{1.49}\\times 10^{\\text{-4}} & \\text{6.38}\\times 10^{\\text{-1}} & \\text{3.19}\\times 10^{\\text{-1}} & \\text{8.92}\\times 10^{\\text{-1}} & \\text{1.79}\\\\\\hline\\end{array}",
