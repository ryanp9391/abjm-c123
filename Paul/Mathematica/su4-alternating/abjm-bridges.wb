  {
   "kind": 2,
   "value": "untwistRowA[st_, eps_] := Module[{z = 1 + eps phi, th = thABJM + eps thdir, Lam, idx = sectors[st[\"w\"]], M, V, P, k, psi, tau, lhs, W, fac, ov},\n   Lam = DiagonalMatrix[z];\n   M = Transpose[Table[mixTbar[th, Lam, N[UnitVector[nn^LL, i]]][[idx]], {i, idx}]];\n   V = Eigenvectors[M]; P = (Normal[SparseArray[Thread[idx -> #], nn^LL]]/Norm[#]) & /@ V;\n   ov = Abs[Conjugate[P] . st[\"psi\"]]; k = Ordering[ov, -1][[1]];\n   psi = P[[k]]; psi = psi Abs[Conjugate[psi] . st[\"psi\"]]/(Conjugate[psi] . st[\"psi\"]);\n   tau = (Conjugate[psi] . t1V[th, Lam, th[[1]], psi])/(Conjugate[psi] . psi);\n   lhs = braVec[1] . psi; W = braVec[0] . psi; fac = (1 - z[[4]]/(c1[th] tau))/(1 - z[[4]]/z[[1]]);\n   {eps, ov[[k]], Abs[lhs - fac W]/Abs[lhs], lhs, Abs[W], Abs[fac]}];\nuntwistRowsA = Flatten[Table[If[Abs[st[\"C\"][[2]]] < 10^-8, {},\n     Prepend[untwistRowA[st, #] & /@ {10^-2, 10^-3, 10^-4}, {dyn[st[\"w\"]], \"C₁(HW) = \" <> ToString[NumberForm[st[\"C\"][[2]], 6]], \"\", \"\", \"\", \"\"}]], {st, hwA}], 1];\nGrid[Prepend[Map[If[NumericQ[#] && !ExactNumberQ[#], ScientificForm[Chop[#, 10^-15], 6], #] &, untwistRowsA, {2}],\n  {\"ε = δ\", \"|⟨Ψ_ε|Ψ⟩|\", \"|LHS−RHS|/|LHS|\", \"LHS = ⟨B₁|Ψ⟩\", \"|⟨W|Ψ⟩|\", \"|bracket|\"}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
