{
 "cells": [
  {
   "kind": 1,
   "value": "# ABJM bridges: on-shell HW states, C_ℓ, odd-bridge formula through the untwisting limit\n\nNotebook port of `checks/abjm_bridges.py` + `abjm_bridges_t3.py` (`ABJM-3pt-transfer-matrices.md` §5.5, §5.7), now with **t₃ in vector form** (`dual-lax-t3.wb`) so that on-shell states are joint t₁, t₃ eigenstates and the untwisting matching uses them.\n\nConventions: A site ρ(E_ij) = e_ij, F site ρ(E_ij) = −e_ji, T = ℒ₁⋯ℒ_L, twist on the right. Bra for bridge ℓ (fields): first ℓ sites carry O₂ fields (A: e₁, F: e₄), the rest O₃ fields (A: e₁−e₄, F: e₄+e₁); ℓ = 0 is ⟨W₋₁^L|, ℓ = 2L the vacuum. C_ℓ = ⟨B_ℓ|Ψ⟩/‖Ψ‖ (bilinear bra, phase of Ψ fixed by making its largest component real positive).\n\n**Set `Lp` (number of pairs) in the setup cell.**",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[ee, rho, origE, barE, gFac, applySite, transferVec, t1V, t3V, mixT, siteOp, weight, Jop, dyn, braVec, fixPhase, wedgeC, Dw, wedgeOp, wedgeE, gW, Gw, transferVecD, t2V];\nnn = 4; hh = 1/2; Lp = 2; LL = 2 Lp;\nee[i_, j_] := SparseArray[{{i, j}} -> 1, {nn, nn}];\nrho[\"A\"][i_, j_] := ee[i, j]; rho[\"F\"][i_, j_] := -ee[j, i];\nid4 = IdentityMatrix[nn, SparseArray];\norigE[ty_][v_, t_][i_, j_] := (v - t) KroneckerDelta[i, j] id4 + hh rho[ty][i, j];\nbarE[\"A\"][v_, t_][k_, l_] := (v - t + hh) KroneckerDelta[k, l] id4 - hh ee[l, k];\nbarE[\"F\"][v_, t_][k_, l_] := (v - t - 3 hh) KroneckerDelta[k, l] id4 + hh ee[k, l];\ngFac[\"A\"][v_, t_] := (v - t - hh) (v - t - 2 hh); gFac[\"F\"][v_, t_] := (v - t) (v - t - hh);\n(* t2: fused wedge^2 Lax (dual-lax-t3.wb section 4): aux basis e_I, I in 2-subsets, D = derivation action *)\nsubs2 = Subsets[Range[nn], {2}];\nwedgeC[k_, m_, Ir_] := Which[{k, m} == Ir, 1, {m, k} == Ir, -1, True, 0];\nDw[X_] := Table[Sum[X[[k, Jc[[1]]]] wedgeC[k, Jc[[2]], Ir] + X[[k, Jc[[2]]]] wedgeC[Jc[[1]], k, Ir], {k, nn}], {Ir, subs2}, {Jc, subs2}];\nDwE = Table[Dw[Normal[ee[a, b]]], {a, nn}, {b, nn}];\nwedgeOp[ty_][iI_, iJ_] := wedgeOp[ty][iI, iJ] = Sum[DwE[[a, b, iI, iJ]] rho[ty][a, b], {a, nn}, {b, nn}];\nwedgeE[ty_][v_, t_][iI_, iJ_] := (v - t - If[ty == \"F\", hh, 0]) KroneckerDelta[iI, iJ] id4 + hh wedgeOp[ty][iI, iJ];\ngW[\"A\"][v_, t_] := v - t - hh; gW[\"F\"][v_, t_] := v - t;\nGw[G_] := Table[Det[G[[subs2[[jJ]], subs2[[iI]]]]], {jJ, 6}, {iI, 6}];\napplySite[psi_, s_, m_, L_] := Flatten[Map[m . # &, ArrayReshape[psi, {nn^(s - 1), nn, nn^(L - s)}]]];\ntransferVecD[ent_, types_, ths_, G_, v_, psi_, d_] := Module[{L = Length[types], Phi, mat},\n   mat[s_, i_, j_] := N[Normal[ent[types[[s]]][v, ths[[s]]][i, j]]];\n   Phi = Table[applySite[psi, L, mat[L, k, j], L], {k, d}, {j, d}];\n   Do[Phi = Table[Sum[applySite[Phi[[m, j]], s, mat[s, k, m], L], {m, d}], {k, d}, {j, d}], {s, L - 1, 1, -1}];\n   Sum[Phi[[i, j]] G[[j, i]], {i, d}, {j, d}]];\ntransferVec[ent_, types_, ths_, G_, v_, psi_] := transferVecD[ent, types, ths, G, v, psi, nn];\nt1V[ths_, G_, v_, psi_] := transferVec[origE, types, ths, N[G], v, psi];\nt2V[ths_, G_, v_, psi_] := N[Times @@ MapThread[gW[#1][v, #2] &, {types, ths}]] transferVecD[wedgeE, types, ths, N[Gw[G]], v, psi, 6];\nt3V[ths_, G_, v_, psi_] := N[Times @@ MapThread[gFac[#1][v, #2] &, {types, ths}]] transferVec[barE, types, ths, N[Det[G] Transpose[Inverse[G]]], v, psi];\nmixT[ths_, G_, psi_] := t1V[ths, G, 0.3711, psi] + 0.37 t1V[ths, G, -0.917, psi] + 0.29 t3V[ths, G, 0.41, psi] - 0.13 t3V[ths, G, -0.77, psi];\n(* chain, weight sectors, raising operators, translation by one pair *)\ntypes = Flatten[Table[{\"A\", \"F\"}, Lp]];\nsiteOp[s_, m_] := KroneckerProduct @@ Table[If[b == s, m, id4], {b, LL}];\nweight[b_] := Total[MapThread[If[#2 == \"A\", 1, -1] UnitVector[nn, #1] &, {b, types}]];\nsectors = GroupBy[Range[nn^LL], weight[Tuples[Range[nn], LL][[#]]] &];\ndominant = ReverseSortBy[Select[Keys[sectors], OrderedQ[Reverse[#]] &], Identity];\nJop[i_, j_] := Sum[siteOp[s, rho[types[[s]]][i, j]], {s, LL}];\nperm = Flatten[Transpose[ArrayReshape[Range[nn^LL], {nn^2, nn^(LL - 2)}]]];\nshiftM = SparseArray[Table[{k, perm[[k]]} -> 1, {k, nn^LL}], {nn^LL, nn^LL}];\ndyn[w_] := -Differences[w];\nO2 = <|\"A\" -> UnitVector[nn, 1], \"F\" -> UnitVector[nn, 4]|>; O3 = <|\"A\" -> UnitVector[nn, 1] - UnitVector[nn, 4], \"F\" -> UnitVector[nn, 4] + UnitVector[nn, 1]|>;\nbraVec[l_] := Flatten[Outer[Times, Sequence @@ Table[If[s <= l, O2[types[[s]]], O3[types[[s]]]], {s, LL}]]];\nfixPhase[v_] := Module[{w = v/Norm[v], k}, k = Ordering[Abs[w], -1][[1]]; w Abs[w[[k]]]/w[[k]]];\nGrid[{{\"pairs\", Lp}, {\"sites\", LL}, {\"dim\", nn^LL}, {\"dominant weight sectors\", Length[dominant]}}, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"825950\" data-output-id=\"24\" data-out-n=\"324\" data-sub-idx=\"38\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"1\" data-sub-start=\"42\" data-sub-end=\"42\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[324]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"15\" data-latex-b64=\"XGJlZ2lue2FycmF5fXt8Y3xjfH1caGxpbmVcdGV4dHtwYWlyc30gJiAyXFxcaGxpbmVcdGV4dHtzaXRlc30gJiA0XFxcaGxpbmVcdGV4dHtkaW19ICYgMjU2XFxcaGxpbmVcdGV4dHtkb21pbmFudCB3ZWlnaHQgc2VjdG9yc30gJiA2XFxcaGxpbmVcZW5ke2FycmF5fQ==\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:4.84em;vertical-align:-2.15em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.69em;\"><span style=\"top:-4.65em;\"><span class=\"pstrut\" style=\"height:4.65em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:4.8em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-2.15em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.65em;\"><span style=\"top:-4.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">pairs</span></span></span></span><span style=\"top:-3.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">sites</span></span></span></span><span style=\"top:-2.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">dim</span></span></span></span><span style=\"top:-1.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">dominant weight sectors</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.15em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:4.8em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-2.15em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.65em;\"><span style=\"top:-4.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">2</span></span></span><span style=\"top:-3.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">4</span></span></span><span style=\"top:-2.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">256</span></span></span><span style=\"top:-1.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">6</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.15em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:4.8em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-2.15em;\"></span></span></span><span style=\"top:-2.5em;\"><span class=\"pstrut\" style=\"height:4.65em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.7em;\"><span class=\"pstrut\" style=\"height:4.65em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-4.9em;\"><span class=\"pstrut\" style=\"height:4.65em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-6.1em;\"><span class=\"pstrut\" style=\"height:4.65em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-7.3em;\"><span class=\"pstrut\" style=\"height:4.65em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.15em;\"><span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[324]= \\begin{array}{|c|c|}\\hline\\text{pairs} & 2\\\\\\hline\\text{sites} & 4\\\\\\hline\\text{dim} & 256\\\\\\hline\\text{dominant weight sectors} & 6\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "304d7569-3a71-4fbb-8daf-87a842bdbd41"
