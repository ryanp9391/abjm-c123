       "data": "Out[155]= \\begin{array}{|c|c|c|c|c|c|c|c|c|}\\hline\\text{Dynkin} & \\text{$\\tau$₁(0.123)} & \\text{$\\tau$₃(0.41)} & \\text{gap (t₁,t₃)} & \\text{C0} & \\text{C1} & \\text{C2} & \\text{C3} & \\text{C4}\\\\\\hline\\left\\{2,0,2\\right\\} & 0.008480046564000001 & 9.427993723688083\\times 10^{-6} & \\infty  & \\text{1.} & \\text{1.} & \\text{1.} & \\text{1.} & \\text{1.}\\\\\\hline\\left\\{0,2,0\\right\\} & -0.006648953435999999 & 5.557686957294068\\times 10^{-6} & \\infty  & \\text{0} & \\text{0} & \\text{0} & \\text{0} & \\text{0}\\\\\\hline\\left\\{1,0,1\\right\\} & -0.014213453436000001 & 0.00001130095191829707 & \\text{3.1}\\times 10^{\\text{-1}} & \\text{0} & \\text{0.353553} & \\text{0} & \\text{0.353553} & \\text{0}\\\\\\hline\\left\\{1,0,1\\right\\} & -0.014213453436000001 & 9.381347332247072\\times 10^{-6} & \\text{3.1}\\times 10^{\\text{-1}} & \\text{0} & \\text{0.204124} & \\text{0} & \\text{0.204124} & \\text{0}\\\\\\hline\\left\\{0,0,0\\right\\} & -0.0293424534360007 & 0.000014149261203078064 & \\text{1.9}\\times 10^{\\text{-1}} & \\text{0} & \\text{0} & \\text{-0.258199} & \\text{0} & \\text{0}\\\\\\hline\\left\\{0,0,0\\right\\} & 0.22065754656400002 & 0.000015109063496103067 & \\text{1.9}\\times 10^{\\text{-1}} & \\text{0} & \\text{0} & \\text{-0.25} & \\text{0} & \\text{0}\\\\… [latex truncated: 1217 chars total]",
