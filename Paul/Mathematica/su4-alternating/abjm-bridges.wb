       "data": "Out[185]= \\begin{array}{|c|c|c|c|c|c|c|}\\hline\\text{$\\varepsilon$ = $\\delta$} & \\text{|⟨$\\Psi$\\_$\\varepsilon$|$\\Psi$⟩|} & \\text{|LHS−RHS|/|LHS|} & \\text{LHS = ⟨B₁|$\\Psi$⟩} & \\text{|⟨W|$\\Psi$⟩|} & \\text{|bracket|} & \\text{eigenvector residual of t₁}\\\\\\hline\\left\\{2,0,2\\right\\} & \\text{C₁(HW) = 1.} &  &  &  &  & \\\\\\hline\\mathrm{If}\\left[\\lnot \\mathrm{RationalQ}\\left(\\frac{1}{100}\\right),\\mathrm{Chop}\\left[\\frac{\\text{1}}{\\text{100}},\\frac{\\text{1}}{\\text{10}^{\\text{15}}}\\right],\\frac{1}{100}\\right] & \\mathrm{If}\\left[\\lnot \\mathrm{RationalQ}\\left(1.\\,\\right),\\mathrm{Chop}\\left[\\text{1.},\\frac{\\text{1}}{\\text{10}^{\\text{15}}}\\right],1.\\,\\right] & \\mathrm{If}\\left[\\lnot \\mathrm{RationalQ}\\left(1.1102230246251565\\times 10^{-16}\\right),\\mathrm{Chop}\\left[\\text{1.11022}\\times 10^{\\text{-16}},\\frac{\\text{1}}{\\text{10}^{\\text{15}}}\\right],1.1102230246251565\\times 10^{-16}\\right] & \\mathrm{If}\\left[\\lnot \\mathrm{RationalQ}\\left(1.\\,\\right),\\mathrm{Chop}\\left[\\text{1.},\\frac{\\text{1}}{\\text{10}^{\\text{15}}}\\right],1.\\,\\right] & \\mathrm{If}\\left[\\lnot \\mathrm{RationalQ}\\left(1.\\,\\right),\\mathrm{Chop}\\left[\\text{1.},\\frac{\\text{1}}{\\text{10}^{\\text{15}}}\\right],1.\\,\\right] & \\mathrm{If}\\left[\\lnot \\mathr… [latex truncated: 12981 chars total]",
