      {
       "data": "Out[334]= \\begin{array}{|c|c|c|c|c|c|}\\hline\\text{$\\theta$\\_A − $\\theta$\\_F} & \\text{‖U$\\psi$‖/‖$\\psi$‖,  U = t₁($\\theta$\\_F) t̄₃($\\theta$\\_A−h)} & \\text{U $\\propto$ S? (rel res)} & \\text{U $\\propto$ S⁻¹? (rel res)} & \\text{c (S)} & \\text{c (S⁻¹)}\\\\\\hline0 & \\text{1.06}\\times 10^{\\text{-17}} & \\text{9.95}\\times 10^{\\text{-1}} & \\text{9.95}\\times 10^{\\text{-1}} & 0 & 0\\\\\\hline1 & \\text{6.25}\\times 10^{\\text{-2}} & \\text{1.49}\\times 10^{\\text{-17}} & \\text{1.49}\\times 10^{\\text{-17}} & \\text{6.25}\\times 10^{\\text{-2}} & \\text{6.25}\\times 10^{\\text{-2}}\\\\\\hline\\text{3.}\\times 10^{\\text{-1}} & \\text{1.63}\\times 10^{\\text{-2}} & \\text{2.68}\\times 10^{\\text{-16}} & \\text{2.68}\\times 10^{\\text{-16}} & \\text{1.63}\\times 10^{\\text{-2}} & \\text{1.63}\\times 10^{\\text{-2}}\\\\\\hline-1 & \\text{5.63}\\times 10^{\\text{-1}} & \\text{1.33}\\times 10^{\\text{-16}} & \\text{1.33}\\times 10^{\\text{-16}} & \\text{5.63}\\times 10^{\\text{-1}} & \\text{5.63}\\times 10^{\\text{-1}}\\\\\\hline2 & \\text{0.} & \\text{0.} & \\text{0.} & 0 & 0\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "400cc1c3-4004-44cc-ab82-28e7fba54331"
    }
