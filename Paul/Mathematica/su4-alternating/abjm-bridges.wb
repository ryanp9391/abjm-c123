      {
       "data": "Out[327]= \\begin{array}{|c|c|}\\hline\\text{vector t₂(0.37) vs t2Mat, untwisted homogeneous, random $\\psi$} & \\text{5.}\\times 10^{\\text{-19}}\\\\\\hline\\text{vector t₂(−0.61) vs t2Mat} & \\text{2.2}\\times 10^{\\text{-16}}\\\\\\hline\\text{[t₂, Ŝ] at twist + pair-periodic $\\theta$ (vector)} & \\text{4.}\\times 10^{\\text{-19}}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
