       "data": "Out[651]= \\begin{matrix}\\begin{matrix}\\mathbf{\\text{L = 2 pairs: class (\\# non-LR coupling / \\# non-BPS LR coupling)}}\\\\\\begin{array}{|c|c|c|c|c|c|c|}\\hline\\text{orbit \\\\ ($\\mathscr{l}$, start)} & \\text{$\\mathscr{l}$=1 A} & \\text{$\\mathscr{l}$=1 F} & \\text{$\\mathscr{l}$=2 A} & \\text{$\\mathscr{l}$=2 F} & \\text{$\\mathscr{l}$=3 A} & \\text{$\\mathscr{l}$=3 F}\\\\\\hline\\text{generic (note)} & \\text{non-LR only (2/0)} & \\text{non-LR only (2/0)} & \\text{both (2/3)} & \\text{both (2/3)} & \\text{non-LR only (2/0)} & \\text{non-LR only (2/0)}\\\\\\hline\\text{a2.f1 = 0} & \\text{non-LR only (2/0)} & \\text{--- (0/0)} & \\text{both (2/1)} & \\text{both (2/1)} & \\text{non-LR only (2/0)} & \\text{--- (0/0)}\\\\\\hline\\text{a1.f2 = 0} & \\text{--- (0/0)} & \\text{non-LR only (2/0)} & \\text{both (2/1)} & \\text{both (2/1)} & \\text{--- (0/0)} & \\text{non-LR only (2/0)}\\\\\\hline\\text{both 0} & \\text{--- (0/0)} & \\text{--- (0/0)} & \\text{LR only (0/1)} & \\text{LR only (0/1)} & \\text{--- (0/0)} & \\text{--- (0/0)}\\\\\\hline\\text{a2 = a1} & \\text{--- (0/0)} & \\text{--- (0/0)} & \\text{--- (0/0)} & \\text{--- (0/0)} & \\text{--- (0/0)} & \\text{--- (0/0)}\\\\\\hline\\text{f2 = f1} & \\text{--- (0/0)} & \\text{--- (0/0)} & \\text{--- (0/0)} & \\tex… [latex truncated: 5789 chars total]",
