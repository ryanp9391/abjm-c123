       "data": "Out[648]= \\begin{array}{|c|c|}\\hline\\text{\\# configurations scanned (L = 2, 3, 4)} & 180\\\\\\hline\\text{LR selection rule (only LR states couple)} & \\begin{pmatrix}2 & \\text{both 0} & 2 & \\text{A} & 0 & 1 & 2 & 3\\\\2 & \\text{both 0} & 2 & \\text{F} & 0 & 1 & 2 & 3\\end{pmatrix}\\\\\\hline\\text{anti-LR (only non-LR states couple)} & \\begin{pmatrix}2 & \\text{generic (note)} & 1 & \\text{A} & 2 & 0 & 2 & 3\\\\2 & \\text{generic (note)} & 1 & \\text{F} & 2 & 0 & 2 & 3\\\\2 & \\text{generic (note)} & 3 & \\text{A} & 2 & 0 & 2 & 3\\\\2 & \\text{generic (note)} & 3 & \\text{F} & 2 & 0 & 2 & 3\\\\2 & \\text{a2.f1 = 0} & 1 & \\text{A} & 2 & 0 & 2 & 3\\\\2 & \\text{a2.f1 = 0} & 3 & \\text{A} & 2 & 0 & 2 & 3\\\\2 & \\text{a1.f2 = 0} & 1 & \\text{F} & 2 & 0 & 2 & 3\\\\2 & \\text{a1.f2 = 0} & 3 & \\text{F} & 2 & 0 & 2 & 3\\\\3 & \\text{a2.f1 = 0} & 2 & \\text{A} & 7 & 0 & 18 & 7\\\\3 & \\text{a2.f1 = 0} & 2 & \\text{F} & 7 & 0 & 18 & 7\\\\3 & \\text{a2.f1 = 0} & 4 & \\text{A} & 7 & 0 & 18 & 7\\\\3 & \\text{a2.f1 = 0} & 4 & \\text{F} & 7 & 0 & 18 & 7\\\\3 & \\text{a1.f2 = 0} & 2 & \\text{A} & 7 & 0 & 18 & 7\\\\3 & \\text{a1.f2 = 0} & 2 & \\text{F} & 7 & 0 & 18 & 7\\\\3 & \\text{a1.f2 = 0} & 4 & \\text{A} & 7 & 0 & 18 & 7\\\\3 & \\text{a1.f2 = 0} & 4 & \\text{F} & 7 & 0 & 1… [latex truncated: 5622 chars total]",
