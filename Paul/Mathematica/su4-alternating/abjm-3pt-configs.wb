      {
       "data": "Out[777]= \\begin{array}{|c|c|}\\hline\\text{\\# configurations scanned} & 360\\\\\\hline\\text{\\# hits P} & 44\\\\\\hline\\text{\\# hits LP} & 10\\\\\\hline\\text{P hits \\{orbit, start\\} -> \\{L, $\\mathscr{l}$\\}} & \\langle\\!\\lvert \\left\\{\\text{generic (note)},\\text{A}\\right\\}\\to \\begin{pmatrix}2 & 1\\\\2 & 2\\\\2 & 3\\\\3 & 1\\\\3 & 5\\\\4 & 1\\\\4 & 7\\end{pmatrix},\\left\\{\\text{generic (note)},\\text{F}\\right\\}\\to \\begin{pmatrix}2 & 1\\\\2 & 2\\\\2 & 3\\\\3 & 1\\\\3 & 5\\\\4 & 1\\\\4 & 7\\end{pmatrix},\\left\\{\\text{a2.f1 = 0},\\text{A}\\right\\}\\to \\begin{pmatrix}2 & 1\\\\2 & 2\\\\2 & 3\\\\3 & 1\\\\3 & 5\\\\4 & 1\\\\4 & 7\\end{pmatrix},\\left\\{\\text{a2.f1 = 0},\\text{F}\\right\\}\\to \\begin{pmatrix}2 & 2\\\\3 & 3\\end{pmatrix},\\left\\{\\text{a1.f2 = 0},\\text{F}\\right\\}\\to \\begin{pmatrix}2 & 1\\\\2 & 2\\\\2 & 3\\\\3 & 1\\\\3 & 5\\\\4 & 1\\\\4 & 7\\end{pmatrix},\\left\\{\\text{a1.f2 = 0},\\text{A}\\right\\}\\to \\begin{pmatrix}2 & 2\\\\3 & 3\\end{pmatrix},\\left\\{\\text{both 0},\\text{A}\\right\\}\\to \\begin{pmatrix}2 & 2\\\\3 & 2\\\\3 & 3\\\\3 & 4\\\\4 & 2\\\\4 & 6\\end{pmatrix},\\left\\{\\text{both 0},\\text{F}\\right\\}\\to \\begin{pmatrix}2 & 2\\\\3 & 2\\\\3 & 3\\\\3 & 4\\\\4 & 2\\\\4 & 6\\end{pmatrix}\\rvert\\!\\rangle \\\\\\hline\\text{LP hits \\{orbit, start\\} -> \\{L, $\\mathscr{l}$\\}} & \\langle\\!\\lvert \\left\\{\\text{both 0… [latex truncated: 1697 chars total]",
