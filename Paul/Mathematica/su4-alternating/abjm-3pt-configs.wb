       "data": "Out[781]= \\begin{array}{|c|c|c|c|c|c|}\\hline\\text{orbit} & \\mathscr{l} & \\text{start} & \\text{L = 2} & \\text{L = 3} & \\text{L = 4}\\\\\\hline\\text{generic (note)} & 1 & \\text{A} & \\text{4.6}\\times 10^{\\text{-2}} & \\text{2.6}\\times 10^{\\text{-2}} & \\text{2.4}\\times 10^{\\text{-3}}\\\\\\hline\\text{generic (note)} & 1 & \\text{F} & \\text{5.6}\\times 10^{\\text{-2}} & \\text{1.2}\\times 10^{\\text{-2}} & \\text{3.8}\\times 10^{\\text{-3}}\\\\\\hline\\text{a2.f1 = 0} & 1 & \\text{A} & \\text{7.1}\\times 10^{\\text{-2}} & \\text{1.6}\\times 10^{\\text{-2}} & \\text{7.4}\\times 10^{\\text{-3}}\\\\\\hline\\text{a1.f2 = 0} & 1 & \\text{F} & \\text{8.4}\\times 10^{\\text{-2}} & \\text{2.8}\\times 10^{\\text{-2}} & \\text{5.6}\\times 10^{\\text{-3}}\\\\\\hline\\text{both 0} & 2 & \\text{A} & \\text{1.1}\\times 10^{\\text{-1}} & \\text{1.2}\\times 10^{\\text{-2}} & \\text{4.4}\\times 10^{\\text{-3}}\\\\\\hline\\text{both 0} & 2 & \\text{F} & \\text{8.7}\\times 10^{\\text{-2}} & \\text{1.6}\\times 10^{\\text{-2}} & \\text{5.1}\\times 10^{\\text{-3}}\\\\\\hline\\text{generic (note)} & 2 & \\text{A} & \\text{7.4}\\times 10^{\\text{-2}} & \\text{1.4}\\times 10^{\\text{-2}} & \\text{5.4}\\times 10^{\\text{-3}}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
