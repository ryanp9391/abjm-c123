       "data": "Out[786]= \\begin{array}{|c|c|c|c|c|c|}\\hline\\text{orbit} & \\mathscr{l} & \\text{start} & \\text{L = 2} & \\text{L = 3} & \\text{L = 4}\\\\\\hline\\text{generic (note)} & 1 & \\text{A} & \\text{1.1}\\times 10^{\\text{-1}} & \\text{4.7}\\times 10^{\\text{-17}} & \\text{1.3}\\times 10^{\\text{-17}}\\\\\\hline\\text{generic (note)} & 1 & \\text{F} & \\text{7.4}\\times 10^{\\text{-2}} & \\text{7.8}\\times 10^{\\text{-17}} & \\text{1.3}\\times 10^{\\text{-17}}\\\\\\hline\\text{a2.f1 = 0} & 1 & \\text{A} & \\text{1.7}\\times 10^{\\text{-1}} & \\text{3.5}\\times 10^{\\text{-17}} & \\text{4.9}\\times 10^{\\text{-18}}\\\\\\hline\\text{a1.f2 = 0} & 1 & \\text{F} & \\text{7.6}\\times 10^{\\text{-2}} & \\text{5.1}\\times 10^{\\text{-17}} & \\text{4.1}\\times 10^{\\text{-18}}\\\\\\hline\\text{both 0} & 2 & \\text{A} & \\text{1.1}\\times 10^{\\text{-1}} & \\text{2.}\\times 10^{\\text{-17}} & \\text{4.9}\\times 10^{\\text{-18}}\\\\\\hline\\text{both 0} & 2 & \\text{F} & \\text{8.6}\\times 10^{\\text{-2}} & \\text{2.8}\\times 10^{\\text{-17}} & \\text{7.1}\\times 10^{\\text{-18}}\\\\\\hline\\text{generic (note)} & 2 & \\text{A} & \\text{6.5}\\times 10^{\\text{-2}} & \\text{3.7}\\times 10^{\\text{-3}} & \\text{2.4}\\times 10^{\\text{-3}}\\\\\\hline\\end{array}",
