   "kind": 2,
   "value": "cls[r_] := Which[r[[5]] == 0 && r[[6]] == 0, \"—\", r[[5]] == 0, \"LR only\", r[[6]] == 0, \"non-LR only\", True, \"both\"];\npatTab[L_] := Module[{rows = Select[allScan, #[[1]] == L &]},\n   Prepend[Table[Prepend[Table[With[{r = SelectFirst[rows, #[[2]] == o[[1]] && #[[3]] == l && #[[4]] == st &]}, cls[r] <> \" (\" <> ToString[r[[5]]] <> \"/\" <> ToString[r[[6]]] <> \")\"], {l, 1, 2 L - 1}, {st, {\"A\", \"F\"}}] // Flatten, o[[1]]], {o, orbits}],\n    Prepend[Flatten[Table[\"ℓ=\" <> ToString[l] <> \" \" <> st, {l, 1, 2 L - 1}, {st, {\"A\", \"F\"}}]], \"orbit \\\\ (ℓ, start)\"]]];\nColumn[Table[Column[{Style[\"L = \" <> ToString[L] <> \" pairs: class (# non-LR coupling / # non-BPS LR coupling)\", Bold], Grid[patTab[L], Frame -> All, Alignment -> Left]}], {L, {2, 3, 4}}], Spacings -> 2]",
   "languageId": "wolfram",
