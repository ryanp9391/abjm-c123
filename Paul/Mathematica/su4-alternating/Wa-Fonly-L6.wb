   "value": "(* (3) sector n = 3 (zero weight, 256 states): two states *)\nfdGen3 = Module[{M = fdSectorMat[3], d, vals, vecs},\n  d = Length[M]; {vals, vecs} = Eigensystem[N[M]];\n  Table[Module[{x = fdRefine[M, vecs[[j]], vals[[j]], 50], res},\n    res = Block[{$MinPrecision = 50, $MaxPrecision = 50}, Module[{Mx = SetPrecision[M, 50] . x, q = First[Ordering[Abs[x], -1]]}, Norm[Mx - (Mx[[q]]/x[[q]]) x]]];\n    Append[fdQcheck[3, x, fdIdx[3], 3/7], N[res, 3]]], {j, {5, 100}}]];\nGrid[Prepend[fdGen3, {\"n\", \"|<W_a^3|Psi>|\", \"rel. dev. direct vs Q-form\", \"tau(th2)\", \"eigen-residual\"}], Frame -> All]",
