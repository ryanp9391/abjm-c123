  {
   "kind": 2,
   "value": "(* extrapolation of |C(eps)| to eps -> 0 (Lagrange through the 4 eps values) and comparison with the data *)\nfdEpsList = {1/100, 1/200, 1/400, 1/800};\nfdLagr0[es_, vals_] := Sum[vals[[i]] Product[If[j == i, 1, (0 - es[[j]])/(es[[i]] - es[[j]])], {j, Length[es]}], {i, Length[es]}];\nfdDataMod = Table[Abs[fdDat[\"CRe\"][[i]][[5]] + I fdDat[\"CIm\"][[i]][[5]]], {i, {17, 18, 19, 20, 21, 22}}];\nfdSumTable = Table[Module[{cd = Table[N[Abs[fdEpsOut[e][[j]][\"Cd\"]], 30], {e, fdEpsList}], cq = Table[N[Abs[fdEpsOut[e][[j]][\"Cq\"]], 30], {e, fdEpsList}]},\n   {fdEpsOut[1/100][[j]][\"group\"], N[cd, 7], N[fdLagr0[fdEpsList, cd], 8], N[fdLagr0[fdEpsList, cq], 8], N[fdDataMod[[j]], 8], N[Max[Abs[(cq - cd)/cd]], 3]}], {j, 6}];\nGrid[Prepend[fdSumTable, {\"data state\", \"|C_direct|(eps = 1/100, 1/200, 1/400, 1/800)\", \"extrapolated |C_direct|\", \"extrapolated |C_Q|\", \"|C_data|\", \"max rel |C_Q - C_direct|\"}], Frame -> All]",
   "languageId": "wolfram",
   "outputs": [
