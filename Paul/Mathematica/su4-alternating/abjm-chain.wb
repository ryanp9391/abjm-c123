      {
       "data": "Out[386]= \\begin{array}{|c|c|c|}\\hline & \\text{[H\\_MZ, t̄\\_a(u)] = 0 at $\\theta$\\_A − $\\theta$\\_F = 2h} & \\text{at $\\theta$\\_A = $\\theta$\\_F}\\\\\\hline\\text{t̄1(u)} & \\mathrm{True} & \\mathrm{False}\\\\\\hline\\text{t̄2(u)} & \\mathrm{True} & \\mathrm{False}\\\\\\hline\\text{t̄3(u)} & \\mathrm{True} & \\mathrm{False}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
