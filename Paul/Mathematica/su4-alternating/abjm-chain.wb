      {
       "data": "Out[406]= \\begin{array}{|c|c|c|c|}\\hline\\text{L = 3 pairs} & \\text{$\\theta$\\_A − $\\theta$\\_F = 2h} & \\text{= 0} & \\text{= 0.3}\\\\\\hline\\text{t̄1} & \\text{3.7}\\times 10^{\\text{-15}} & \\text{5.4} & \\text{5.7}\\\\\\hline\\text{t̄2} & \\text{3.3}\\times 10^{\\text{-15}} & \\text{4.6} & \\text{4.7}\\\\\\hline\\text{t̄3} & \\text{2.6}\\times 10^{\\text{-15}} & \\text{1.} & \\text{1.6}\\\\\\hline\\end{array}",
