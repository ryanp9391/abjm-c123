      {
       "data": "Out[1159]= \\begin{array}{|c|c|}\\hline\\text{W1: c and rank\\{psi t1(th2), psi[site2->o2 G]\\} (rank 1 = exactly proportional)} & \\left\\{-\\frac{2263}{14000},1\\right\\}\\\\\\hline\\text{W2: same} & \\left\\{-\\frac{2263}{14000},1\\right\\}\\\\\\hline\\text{W1, psi(1 + a t1(th2)) with a = 1/3 (predicted kappa = -a c)} & \\left\\{\\text{PRODUCT ; 1:= 2:o(1-(0.053880952)G) 3:= 4:=},0.053880952380952384\\right\\}\\\\\\hline\\text{W1, a = -2} & \\left\\{\\text{PRODUCT ; 1:= 2:o(1-(-0.32328571)G) 3:= 4:=},-0.3232857142857143\\right\\}\\\\\\hline\\text{W0: psi(1 + a t1(th2)), a = 1/3} & \\text{ENT r=\\{4, 4, 1, 1\\} pairs(12|13|14)=\\{1, 4, 4\\} ; 3:= 4:= ; 12|34 splits: 12mv, 34=}\\\\\\hline\\text{W0: psi(1 + a t1(th3)), a = 1/3} & \\text{ENT r=\\{1, 1, 4, 4\\} pairs(12|13|14)=\\{1, 4, 4\\} ; 1:= 2:= ; 12|34 splits: 12=, 34mv}\\\\\\hline\\text{W1: kappa of t1(th4+h) on site 4 (M=G)} & \\frac{256620}{789233}\\\\\\hline\\text{W2: kappa of t1(th4+h) on site 4 (M=G)} & \\frac{769860}{2758019}\\\\\\hline\\text{W1: kappa of t3(th2+2h) on site 2 (M=G\\^{}-1)} & \\frac{16340}{62337}\\\\\\hline\\text{W2: kappa of t3(th2+2h) on site 2 (M=G\\^{}-1)} & \\frac{49020}{131761}\\\\\\hline\\end{array}",
