   "kind": 2,
   "value": "bkGdiff = Table[Module[{vac = bkVacVec[bkW0, n], psi, an},\n  psi = vac . bkTs[n, 2] - vac . bkTs[n, 1]; psi = psi/Norm[psi]; an = bkAnalyse[psi, n, bkVecs[bkW0, n]];\n  {n, StringRiffle[(#[[1]] <> \": \" <> ToString[#[[2]]] <> \" (\" <> bkFmt[#[[3]]] <> \")\") & /@ Rest[an], \"; \"], bkFmt /@ bkSV[psi, n, {1}], bkFmt /@ bkSV[psi, n, {2}], bkFmt[Take[bkSV[psi, n, {1, 2}], UpTo[6]]]}], {n, {4, 6}}];\nbkShow[\"G_diff\", Prepend[bkGdiff, {\"n\", \"blocks of <0|(t2-t1)\", \"SV cut {1}\", \"SV cut {2}\", \"SV cut {1,2} (first 6)\"}]]",
