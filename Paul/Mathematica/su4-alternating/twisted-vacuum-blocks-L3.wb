       "data": "Out[1347]= \\begin{array}{|c|c|c|c|c|c|c|}\\hline\\text{n} & \\text{pt} & \\text{lambda} & \\text{alpha} & \\text{beta/alpha - h/th24} & \\text{gamma/(lam alpha) - (th24+h)/th24} & \\text{max off-pattern coeff}\\\\\\hline\\text{4} & \\text{1} & \\text{-0.161643} & \\text{1.35287} & \\text{-3.67595}\\times 10^{\\text{-13}} & \\text{-1.18214}\\times 10^{\\text{-11}} & \\text{7.22383}\\times 10^{\\text{-12}}\\\\\\hline\\text{4} & \\text{2} & \\text{0.148438} & \\text{-0.00722614} & \\text{7.66178}\\times 10^{\\text{-11}} & \\text{1.42897}\\times 10^{\\text{-10}} & \\text{1.69791}\\times 10^{\\text{-13}}\\\\\\hline\\text{4} & \\text{3} & \\text{0.140432} & \\text{-0.0252894} & \\text{-1.92646}\\times 10^{\\text{-11}} & \\text{-1.97211}\\times 10^{\\text{-11}} & \\text{2.65493}\\times 10^{\\text{-13}}\\\\\\hline\\text{4} & \\text{4} & \\text{-0.148321} & \\text{0.0260631} & \\text{1.87073}\\times 10^{\\text{-12}} & \\text{-1.26565}\\times 10^{\\text{-13}} & \\text{5.0553}\\times 10^{\\text{-13}}\\\\\\hline\\text{6} & \\text{1} & \\text{-0.0512836} & \\text{2.61197} & \\text{7.05658}\\times 10^{\\text{-13}} & \\text{3.85134}\\times 10^{\\text{-11}} & \\text{6.04145}\\times 10^{\\text{-11}}\\\\\\hline\\text{6} & \\text{2} & \\text{-0.00646603} & \\text{0.000397397} & \\text{-6.26805}\\times 10^{… [latex truncated: 1672 chars total]",
