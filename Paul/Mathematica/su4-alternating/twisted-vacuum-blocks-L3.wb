      {
       "data": "Out[1341]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{n} & \\text{blocks of <0|(t2-t1)} & \\text{SV cut \\{1\\}} & \\text{SV cut \\{2\\}} & \\text{SV cut \\{1,2\\} (first 6)}\\\\\\hline\\text{4} & \\text{\\{1, 2, 3, 4\\}: entangled block (1.)} & \\left\\{\\text{0.9999999263608663},\\text{0.00027377700911306426},\\text{0.00026891583740718705},\\text{2.9468781107439894*\\^{}-6}\\right\\} & \\left\\{\\text{0.9999999898757875},\\text{0.00010734723993824298},\\text{0.00009339917177561542},\\text{1.2607635506229419*\\^{}-6}\\right\\} & \\text{\\{0.9999999362409573, 0.0002522993722219628, 0.00025222913348158535, 0.0000156068051801652, 3.540719856306347*\\^{}-16, 2.4035385089332487*\\^{}-16\\}}\\\\\\hline\\text{6} & \\text{\\{1, 2, 3, 4, 5, 6\\}: entangled block (1.)} & \\left\\{\\text{0.9999999112092277},\\text{0.00029961905591550226},\\text{0.00029632714521420864},\\text{4.2563442977557074*\\^{}-7}\\right\\} & \\left\\{\\text{0.999999927131412},\\text{0.0002717690916381915},\\text{0.00026810207183420014},\\text{1.0877547196857253*\\^{}-7}\\right\\} & \\text{\\{0.9999999840522253, 0.00012623534192673268, 0.0001262337494211815, 5.022756079436017*\\^{}-6, 5.566764043299181*\\^{}-16, 4.721809068246957*\\^{}-16\\}}\\\\\\hline\\end{array}",
