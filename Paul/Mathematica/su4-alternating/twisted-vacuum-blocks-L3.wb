  {
   "kind": 2,
   "value": "(* NB: the F-site vector u lies in a 3-dim G-invariant subspace on the locus, so use basis b_i = u G^i, i = 0,1,2 *)\nbkDual[o_] := o/(o . o);\nbkBasis3 = Table[bkV6[[2]] . MatrixPower[bkGzN, i], {i, 0, 2}];\nbkSVbasis = SingularValueList[Table[bkV6[[2]] . MatrixPower[bkGzN, i], {i, 0, 3}], Tolerance -> 0];\nbkCoef24[psi_] := Module[{t4 = ArrayReshape[psi, ConstantArray[4, 6]], T, Phi, C},\n  T = Transpose[t4, InversePermutation[{2, 4, 1, 3, 5, 6}]];\n  Phi = Map[# . bkDual[bkV6[[6]]] &, T, {4}]; Phi = Map[# . bkDual[bkV6[[5]]] &, Phi, {3}];\n  Phi = Map[# . bkDual[bkV6[[3]]] &, Phi, {2}]; Phi = Map[# . bkDual[bkV6[[1]]] &, Phi, {1}];\n  C = PseudoInverse[Transpose[bkBasis3]] . Phi . PseudoInverse[bkBasis3];\n  {C, Norm[Transpose[bkBasis3] . C . bkBasis3 - Phi]/Norm[Phi]}];\nbkS24 = Association[Table[nm -> bkCoef24[x], {nm, {\"vac\", \"X2\", \"X4\", \"X24\"}}, {x, {bkVacLookup}}] // Flatten[#, 1] &];\nbkS24 = <|\"vac\" -> bkCoef24[bkVac6], \"X2\" -> bkCoef24[bkX2], \"X4\" -> bkCoef24[bkX4], \"X24\" -> bkCoef24[bkX24]|>;\nbkOut[\"C_struct\", StringRiffle[Flatten[Table[{nm <> \" (resid of 3x3 span: \" <> bkFmt[bkS24[nm][[2]]] <> \")\", StringRiffle[StringRiffle[bkFmt /@ #, \" \"] & /@ Chop[bkS24[nm][[1]], 10^-9], \"\\n\"]}, {nm, Keys[bkS24]}]], \"\\n\"]];\nGrid[Prepend[Table[{nm, bkS24[nm][[2]], MatrixForm[Chop[N[bkS24[nm][[1]], 5], 10^-9]]}, {nm, Keys[bkS24]}], {\"bra\", \"rel resid\", \"coefficient matrix C_ij on b_i(site2) x b_j(site4), b_i = u G^i\"}], Frame -> All]",
   "languageId": "wolfram",
   "outputs": [
