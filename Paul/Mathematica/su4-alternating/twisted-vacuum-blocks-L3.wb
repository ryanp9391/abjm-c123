      {
       "data": "Out[1223]= \\begin{array}{cc}\\begin{matrix}\\text{n=4, W1}\\\\\\begin{array}{|c|c|}\\hline\\text{word} & \\text{blocks: identification (resid or entanglement)}\\\\\\hline\\text{t(th1)\\^{}1} & \\text{\\{1\\}: unchanged (0); \\{2\\}: unchanged (0); \\{3\\}: unchanged (0); \\{4\\}: unchanged (0)}\\\\\\hline\\text{t(th2)\\^{}1} & \\text{\\{1\\}: unchanged (0); \\{2\\}: o.G (1.1775693440128312*\\^{}-16); \\{3\\}: unchanged (0); \\{4\\}: unchanged (0)}\\\\\\hline\\text{t(th3)\\^{}1} & \\text{\\{1\\}: unchanged (0); \\{2\\}: unchanged (0); \\{3\\}: unchanged (0); \\{4\\}: unchanged (0)}\\\\\\hline\\text{t(th4)\\^{}1} & \\text{\\{1\\}: unchanged (0); \\{3\\}: unchanged (0); \\{2, 4\\}: entangled block (1.0000000000000002)}\\\\\\hline\\text{t(th1)\\^{}-1} & \\text{\\{1\\}: unchanged (0); \\{2\\}: unchanged (0); \\{3\\}: unchanged (0); \\{4\\}: unchanged (0)}\\\\\\hline\\text{t(th2)\\^{}-1} & \\text{\\{1\\}: unchanged (0); \\{3\\}: unchanged (0); \\{2, 4\\}: entangled block (1.0000000000000004)}\\\\\\hline\\text{t(th3)\\^{}-1} & \\text{\\{1\\}: unchanged (0); \\{2\\}: unchanged (0); \\{3\\}: unchanged (0); \\{4\\}: unchanged (0)}\\\\\\hline\\text{t(th4)\\^{}-1} & \\text{\\{1\\}: unchanged (0); \\{2\\}: unchanged (0); \\{3\\}: unchanged (0); \\{4\\}: 1-kappa o.Ginv (2.3329547837106334*\\^{}-15)}\\\\\\hline\\end{array}\\end… [latex truncated: 6221 chars total]",
