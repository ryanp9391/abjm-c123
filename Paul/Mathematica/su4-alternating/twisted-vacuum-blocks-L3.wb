       "data": "Out[1325]= \\begin{array}{|c|c|c|c|}\\hline\\text{kappa} & \\text{resid (vac coeff = 1)} & \\text{resid (all 8 coeffs free)} & \\text{max |free coeff|}\\\\\\hline\\text{0.5} & \\text{3.26792}\\times 10^{\\text{-15}} & \\text{2.53214}\\times 10^{\\text{-14}} & \\text{9.25324}\\\\\\hline\\text{-0.4} & \\text{1.61169}\\times 10^{\\text{-15}} & \\text{1.901}\\times 10^{\\text{-15}} & \\text{5.01638}\\\\\\hline\\text{sing. values of the 8 words} & \\text{8} &  & \\\\\\hline\\text{sv list} & \\text{\\{9.287519104981637*\\^{}7, 161263.39244487317, 33920.3584394719, 11336.796731696577, 392.98266757372267, 58.31399702076188, 27.8679889481247, 0.2184800070647737\\}} &  & \\\\\\hline\\text{eigenbra test: <tg|t(0.31) = mu <tg| ; mu, rel resid} & \\text{0.0483074} & \\text{0.00025807} & \\\\\\hline\\end{array}",
