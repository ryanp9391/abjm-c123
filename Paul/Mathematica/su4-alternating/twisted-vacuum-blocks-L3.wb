      {
       "data": "Out[1352]= \\begin{array}{|c|c|c|c|}\\hline\\text{state} & \\text{identification} & \\text{B1 = v3.u2} & \\text{B2 = v2.u3}\\\\\\hline\\text{W1, B bra kappa=0.3} & \\text{site1: unchanged ; site2: 1-kappa o.G kappa=0.30000000000000304} & \\text{3.55271}\\times 10^{\\text{-15}} & \\text{-9.76996}\\times 10^{\\text{-15}}\\\\\\hline\\text{W1, B bra kappa=0.7} & \\text{site1: unchanged ; site2: 1-kappa o.G kappa=0.7000000000000017} & \\text{3.55271}\\times 10^{\\text{-15}} & \\text{4.44089}\\times 10^{\\text{-15}}\\\\\\hline\\text{W1, C bra kappa=0.5} & \\text{site1: unchanged ; site2: 1-kappa o.G kappa=0.49999999999999784} & \\text{3.55271}\\times 10^{\\text{-15}} & \\text{1.24345}\\times 10^{\\text{-14}}\\\\\\hline\\text{W0, n=6, word\\_1 = t1\\^{}-1 t2 t3\\^{}-1...} & \\text{site1: 1-kappa o.GinvT kappa=-4.348183316849912*\\^{}7 ; site2: unchanged} & \\text{-4.38089}\\times 10^{\\text{6}} & \\text{-1.77636}\\times 10^{\\text{-15}}\\\\\\hline\\text{W0, n=6, word\\_2 = t1\\^{}-1 t2 t3\\^{}-1...} & \\text{sites 1,2 not both factorised; blocks \\{\\{2\\}, \\{1, 5\\}, \\{3, 4\\}, \\{6\\}\\}} & \\text{n/a} & \\text{n/a}\\\\\\hline\\text{W0, n=6, word\\_3 = t1\\^{}-1 t2 t3\\^{}-1...} & \\text{sites 1,2 not both factorised; blocks \\{\\{1, 2, 3, 4, 5, 6\\}\\}} & \\text{n/a} & \\text{n/a}… [latex truncated: 1986 chars total]",
