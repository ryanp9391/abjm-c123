      {
       "data": "Out[1486]= \\begin{array}{|c|c|c|}\\hline\\text{quantity} & \\text{closed form} & \\text{numerics}\\\\\\hline\\text{lambda} & \\text{-0.0512836} & \\text{-0.0512836}\\\\\\hline\\text{alpha4} & \\text{2.61197} & \\text{2.61197}\\\\\\hline\\text{gamma} & \\text{-0.220371} & \\text{-0.220371}\\\\\\hline\\text{alpha6} & \\text{-0.0987693} & \\text{-0.0987693}\\\\\\hline\\text{r2 (c2/c6)} & \\text{0.457849} & \\text{0.457849}\\\\\\hline\\text{max |a,b,c closed form - LSQ| over 4 kappa} & \\text{1.2168}\\times 10^{\\text{-13}} & \\\\\\hline\\text{D: word S} & \\text{coeff kappa=0.5} & \\text{coeff kappa=-0.4}\\\\\\hline\\text{\\{2\\}} & \\text{-6.27047} & \\text{5.01638}\\\\\\hline\\text{\\{4\\}} & \\text{-0.35169} & \\text{0.281352}\\\\\\hline\\text{\\{6\\}} & \\text{5.0623} & \\text{-4.04984}\\\\\\hline\\text{\\{2, 4\\}} & \\text{3.77765} & \\text{2.41769}\\\\\\hline\\text{\\{2, 6\\}} & \\text{4.59368} & \\text{2.93996}\\\\\\hline\\text{\\{4, 6\\}} & \\text{-5.95279} & \\text{-3.80979}\\\\\\hline\\text{\\{2, 4, 6\\}} & \\text{-9.25324} & \\text{4.73766}\\\\\\hline\\text{D: coeff/kappa\\^{}|S|} & \\text{kappa=0.5} & \\text{kappa=-0.4}\\\\\\hline\\text{\\{2\\}} & \\text{-12.5409} & \\text{-12.5409}\\\\\\hline\\text{\\{4\\}} & \\text{-0.703381} & \\text{-0.703381}\\\\\\hline\\text{\\{6\\}} & \\text{10.1246} & \\text{10.1246}\\\\\\hlin… [latex truncated: 1447 chars total]",
