      },
      {
       "data": "Out[1463]= \\begin{array}{|c|c|}\\hline\\text{(pow site2, pow site4, pow site6)} & \\text{coeff of <0|t(th6) at base point}\\\\\\hline\\text{\\{0, 0, 1\\}} & \\text{-0.0987693}\\\\\\hline\\text{\\{0, 1, 0\\}} & \\text{0.0826905}\\\\\\hline\\text{\\{1, 0, 0\\}} & \\text{-0.0452214}\\\\\\hline\\text{data over 4 theta points: alpha6 | c4/c6 | c2/c6 | h/th46 | other entries rel} & \\\\\\hline\\text{\\{-0.0987692623709918, -0.837209302338234, 0.45784883721396535\\}} & \\text{\\{-0.8372093023255814, 1.0592187080570896*\\^{}-10\\}}\\\\\\hline\\text{\\{0.3559563614351347, 0.8181818182521915, 1.558441558501996\\}} & \\text{\\{0.8181818181818181, 4.94911230856392*\\^{}-10\\}}\\\\\\hline\\text{\\{-0.0030944573044184415, 0.8571428571115192, 1.8571428573228417\\}} & \\text{\\{0.8571428571428571, 4.618236536881972*\\^{}-10\\}}\\\\\\hline\\text{\\{-0.7638917307392045, -0.6206896551616977, -0.17130144604086325\\}} & \\text{\\{-0.6206896551724138, 6.255117933968469*\\^{}-11\\}}\\\\\\hline\\end{array}",
