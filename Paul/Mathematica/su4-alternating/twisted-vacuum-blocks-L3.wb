   "kind": 2,
   "value": "bkcoefD = Module[{A = Transpose[bkXs[#] & /@ Rest[bkSubs]], rhs = bkTgt[0.5, {2, 4, 6}] - bkVac6}, LeastSquares[A, rhs]];\nbkTgD = bkTgt[0.5, {2, 4, 6}];\nbkRowsE2b = Table[Module[{p = bkPsis[[i]], tt, t2, t4, t6, ov0, PB, PC, PD},\n  t2 = bkRay[bkTs[6, 2], p]; t4 = bkRay[bkTs[6, 4], p]; t6 = bkRay[bkTs[6, 6], p]; ov0 = bkVac6 . p;\n  PB = 1 + bkaB t2; PC = 1 + bkcoefC[[1]] t2 + bkcoefC[[2]] t4 + bkcoefC[[3]] t2 t4;\n  PD = 1 + Total[MapThread[#1 Times @@ #2 &, {bkcoefD, Map[{t2, t4, t6}[[Position[{2, 4, 6}, #][[1, 1]]]] &, Rest[bkSubs], {2}]}]];\n  {i, Abs[ov0], Abs[bkTgB . p - PB ov0]/Abs[bkTgB . p], Abs[bkTgC . p - PC ov0]/Abs[bkTgC . p], Abs[bkTgD . p - PD ov0]/Abs[bkTgD . p]}], {i, Length[bkPsis]}];\nbkShow[\"E_overlap2\", Prepend[bkRowsE2b, {\"state\", \"|<0|Psi>|\", \"rel err B\", \"rel err C\", \"rel err D (3-pair)\"}]]",
