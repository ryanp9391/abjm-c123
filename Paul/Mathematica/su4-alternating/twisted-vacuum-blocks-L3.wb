  {
   "kind": 1,
   "value": "### HP analysis tools and Task G / Task F (W0 words) in high precision",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "bkTolHP = 10^-20;\nbkGmatsHP = <|\"G\" -> N[bkGz, bkPrec], \"GT\" -> N[Transpose[bkGz], bkPrec], \"Ginv\" -> N[Inverse[bkGz], bkPrec], \"GinvT\" -> N[Transpose[Inverse[bkGz]], bkPrec]|>;\nbkSVHP[psi_, n_, S_] := SingularValueList[bkMat[psi, n, S], Tolerance -> 0];\nbkRank1HP[psi_, n_, S_] := With[{sv = bkSVHP[psi, n, S]}, Length[sv] < 2 || sv[[2]] < bkTolHP sv[[1]]];\nbkBlocksHP[psi_, n_] := Module[{blocks = {}}, Do[Do[If[bkRank1HP[psi, n, S] && ! AnyTrue[blocks, SubsetQ[S, #] &] && ! AnyTrue[blocks, IntersectingQ[S, #] &], AppendTo[blocks, S]], {S, Subsets[Range[n], {k}]}], {k, 1, n - 1}]; If[Union @@ blocks =!= Range[n], blocks = Append[blocks, Complement[Range[n], Union @@ blocks]]]; blocks];\nbkSiteFactorHP[psi_, n_, s_] := First[SingularValueDecomposition[bkMat[psi, n, {s}], 1]][[All, 1]];\nbkFitHP[f_, o_] := Module[{res = {}, ff = f/Norm[f], oo = o, ok},\n If[Norm[ff - (ff . oo)/(oo . oo) oo] < 10^-15, Return[{\"unchanged\", 0, 0}]];\n Do[Module[{M = bkGmatsHP[name], oM, A, sol, r1, r2},\n  oM = oo . M; r1 = Norm[ff - (ff . oM)/(oM . oM) oM]/Norm[ff]; AppendTo[res, {\"o.\" <> name, r1, 0, 0}];\n  A = Transpose[{oo, -oM}]; sol = LeastSquares[A, ff]; r2 = Norm[A . sol - ff]/Norm[ff]; AppendTo[res, {\"1-kappa o.\" <> name, r2, sol[[2]]/sol[[1]], 1}]], {name, Keys[bkGmatsHP]}];\n ok = Select[res, #[[2]] < 10^-15 &]; If[ok =!= {}, First[SortBy[ok, #[[4]] &]][[1 ;; 3]], First[SortBy[res, #[[2]] &]][[1 ;; 3]]]];\nbkAnalyseHP[psi0_, n_, vecs_List] := Module[{psi = psi0/Norm[psi0], bl},\n bl = bkBlocksHP[psi, n];\n Table[If[Length[b] == 1, With[{s = b[[1]], fr = bkFitHP[bkSiteFactorHP[psi, n, b[[1]]], vecs[[b[[1]]]]]}, {b, fr[[1]], fr[[2]]}], {b, \"entangled block\", If[Length[b] == n, 1., With[{sv = bkSVHP[psi, n, b]}, N[sv[[2]]/sv[[1]], 3]]]}], {b, bl}]];\nbkShowAn[rows_] := StringRiffle[(ToString[#[[1]]] <> \": \" <> ToString[#[[2]]] <> \" (\" <> bkFmt[#[[3]]] <> \")\") & /@ rows, \"; \"];\nbkGanHP = Flatten[Table[Module[{psi = bkApplyWordHP[bkVacHP[bkW0, n], n, bkWordG[k]], an}, an = bkAnalyseHP[psi, n, bkVecsHP[bkW0, n]]; {n, k, bkShowAn[an]}], {n, {4, 6}}, {k, n}], 1];\nbkShow[\"G_words_HP\", Prepend[bkGanHP, {\"n\", \"k letters\", \"blocks: identification (resid) ; entangled block: (sv2/sv1 of that cut)\"}]]",
   "languageId": "wolfram",
