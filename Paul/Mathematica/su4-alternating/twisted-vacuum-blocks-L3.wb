       "data": "Out[1278]= \\begin{array}{|c|c|c|c|c|c|c|c|}\\hline\\text{kappa} & \\text{a} & \\text{b} & \\text{c} & \\text{rel resid} & \\text{a/kappa} & \\text{b/kappa} & \\text{c/kappa\\^{}2}\\\\\\hline\\text{0.2} & \\text{1.38383} & \\text{-0.0765706} & \\text{-0.181512} & \\text{1.7207}\\times 10^{\\text{-15}} & \\text{6.91914} & \\text{-0.382853} & \\text{-4.53779}\\\\\\hline\\text{0.5} & \\text{3.45957} & \\text{-0.191426} & \\text{-1.13445} & \\text{1.33578}\\times 10^{\\text{-15}} & \\text{6.91914} & \\text{-0.382853} & \\text{-4.53779}\\\\\\hline\\text{0.8} & \\text{5.53532} & \\text{-0.306282} & \\text{-2.90419} & \\text{1.04893}\\times 10^{\\text{-15}} & \\text{6.91914} & \\text{-0.382853} & \\text{-4.53779}\\\\\\hline\\text{-0.4} & \\text{-2.76766} & \\text{0.153141} & \\text{-0.726047} & \\text{1.8592}\\times 10^{\\text{-15}} & \\text{6.91914} & \\text{-0.382853} & \\text{-4.53779}\\\\\\hline\\end{array}",
