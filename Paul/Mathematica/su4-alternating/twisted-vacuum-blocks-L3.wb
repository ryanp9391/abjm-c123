       "data": "Out[1498]= \\begin{array}{|c|c|c|c|c|c|c|c|c|c|}\\hline\\text{n=4: B coefficient a\\_B, C coefficients (a,b,c), resid of C LSQ} & \\text{3.09324} & \\text{\\{1.097600957906294, -0.3695849856099612, -0.6948952187133394\\}} & \\text{3.4364}\\times 10^{\\text{-16}} &  &  &  &  &  & \\\\\\hline\\text{eig \\#} & \\text{tau(u0)} & \\text{|<0|Psi>|/norms} & \\text{res u=-0.77} & \\text{res th2} & \\text{res th4} & \\text{rel err B} & \\text{rel err C} & \\text{tau(th2)} & \\text{tau(th4)}\\\\\\hline\\text{123} & \\text{0.0681736}+\\text{0.}\\,\\mathrm{i} & \\text{4.34705}\\times 10^{\\text{-8}} & \\text{1.64544}\\times 10^{\\text{-6}} & \\text{6.03342}\\times 10^{\\text{-6}} & \\text{2.96909}\\times 10^{\\text{-6}} & \\text{1.52568}\\times 10^{\\text{-6}} & \\text{2.06633}\\times 10^{\\text{-6}} & \\text{-0.107762}+\\text{0.}\\,\\mathrm{i} & \\text{1.48379}+\\text{0.}\\,\\mathrm{i}\\\\\\hline\\text{126} & \\text{0.0676616}+\\text{0.}\\,\\mathrm{i} & \\text{3.8248}\\times 10^{\\text{-8}} & \\text{9.51431}\\times 10^{\\text{-7}} & \\text{6.23544}\\times 10^{\\text{-6}} & \\text{5.67666}\\times 10^{\\text{-6}} & \\text{1.88884}\\times 10^{\\text{-6}} & \\text{3.34666}\\times 10^{\\text{-6}} & \\text{-0.0993109}+\\text{0.}\\,\\mathrm{i} & \\text{1.38004}+\\text{0.}\\,\\mathrm{i}\\\\\\hline\\text{12… [latex truncated: 2189 chars total]",
