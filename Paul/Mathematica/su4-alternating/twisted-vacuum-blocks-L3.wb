       "data": "Out[1442]= \\begin{array}{|c|c|c|c|}\\hline\\text{state} & \\text{identification} & \\text{B1 = v3.u2} & \\text{B2 = v2.u3}\\\\\\hline\\text{W0, n=6, word\\_1} & \\text{site1: o.GinvT ; site2: unchanged} & \\text{-0.100752} & \\text{0.}\\times 10^{\\text{-57}}\\\\\\hline\\text{W0, n=6, word\\_2} & \\text{site1: o.GinvT ; site2: o.G} & \\text{-0.100752} & \\text{0.149263}\\\\\\hline\\text{W0, n=6, word\\_3} & \\text{site1: o.GinvT ; site2: o.G} & \\text{-0.100752} & \\text{0.149263}\\\\\\hline\\text{W0, n=6, word\\_4} & \\text{site1: o.GinvT ; site2: o.G} & \\text{-0.100752} & \\text{0.149263}\\\\\\hline\\text{W0, n=4, word\\_1} & \\text{site1: o.GinvT ; site2: unchanged} & \\text{-0.100752} & \\text{0.}\\times 10^{\\text{-57}}\\\\\\hline\\text{W0, n=4, word\\_2} & \\text{site1: o.GinvT ; site2: o.G} & \\text{-0.100752} & \\text{0.149263}\\\\\\hline\\text{W0, n=4, word\\_3} & \\text{site1: o.GinvT ; site2: o.G} & \\text{-0.100752} & \\text{0.149263}\\\\\\hline\\text{W0, n=4, word\\_4} & \\text{site1: o.GinvT ; site2: o.G} & \\text{-0.100752} & \\text{0.149263}\\\\\\hline\\text{q(W0) = u G v (exact)} & \\text{0.149263} &  & \\\\\\hline\\end{array}",
