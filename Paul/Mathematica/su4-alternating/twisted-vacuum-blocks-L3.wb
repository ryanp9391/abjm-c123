  {
   "kind": 2,
   "value": "bkPairFHP[label_, psi0_, n_, w_] := Module[{psi = psi0/Norm[psi0], vecs = bkVecsHP[w, n], bl, r1, r2, v3, u3, v2, u2, fv},\n  fv[row_, o_] := Which[row[[1]] == \"unchanged\", o, StringStartsQ[row[[1]], \"1-kappa o.\"], o - row[[3]] (o . bkGmatsHP[StringDrop[row[[1]], 10]]), True, o . bkGmatsHP[StringDrop[row[[1]], 2]]];\n  bl = bkBlocksHP[psi, n]; v2 = vecs[[1]]; u2 = vecs[[2]];\n  If[MemberQ[bl, {1}] && MemberQ[bl, {2}],\n   r1 = bkFitHP[bkSiteFactorHP[psi, n, 1], vecs[[1]]]; r2 = bkFitHP[bkSiteFactorHP[psi, n, 2], vecs[[2]]];\n   v3 = fv[r1, vecs[[1]]]; u3 = fv[r2, vecs[[2]]];\n   {label, \"site1: \" <> r1[[1]] <> \" ; site2: \" <> r2[[1]], N[v3 . u2, 8], N[v2 . u3, 8]},\n   {label, \"sites 1,2 not both factorised; blocks \" <> ToString[bl], \"n/a\", \"n/a\"}]];\nbkRowsFHP = Join[\n  Table[With[{wd = bkWordG[k]}, bkPairFHP[\"W0, n=6, word_\" <> ToString[k], bkApplyWordHP[bkVacHP[bkW0, 6], 6, wd], 6, bkW0]], {k, 1, 4}],\n  Table[With[{wd = bkWordG[k]}, bkPairFHP[\"W0, n=4, word_\" <> ToString[k], bkApplyWordHP[bkVacHP[bkW0, 4], 4, wd], 4, bkW0]], {k, 1, 4}]];\nbkShow[\"F_HP\", Join[{{\"state\", \"identification\", \"B1 = v3.u2\", \"B2 = v2.u3\"}}, bkRowsFHP, {{\"q(W0) = u G v (exact)\", bkQ0, \"\", \"\"}}]]",
   "languageId": "wolfram",
