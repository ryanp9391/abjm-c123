  {
   "kind": 2,
   "value": "bkCoefs3[psi_] := Module[{vecs = bkV6, F = {2, 4, 6}, oth = {1, 3, 5}, T, Phi, du, B3, P},\n  T = Transpose[ArrayReshape[psi, ConstantArray[4, 6]], InversePermutation[Join[F, oth]]];\n  du = Flatten[KroneckerProduct @@ (bkDual /@ vecs[[oth]])];\n  Phi = ArrayReshape[ArrayReshape[T, {64, 64}] . du, {4, 4, 4}];\n  B3 = Table[vecs[[2]] . MatrixPower[bkGzN, i], {i, 0, 2}]; P = PseudoInverse[B3];\n  Nest[Function[A, Transpose[A . P, {2, 3, 1}]], Phi, 3]];\nbkX6C = bkCoefs3[bkX6];\nbkEntries = Select[Flatten[Table[{{i - 1, j - 1, k - 1}, bkX6C[[i, j, k]]}, {i, 3}, {j, 3}, {k, 3}], 2], Abs[#[[2]]] > 10^-8 Max[Abs[bkX6C]] &];\nbkX6At[th_] := bkVac6 . bkTrans[6, N[th], bkGzN, N[th[[6]]]];\nbkR6 = Table[With[{C = bkCoefs3[bkX6At[th]], t = N[th]}, {C[[1, 1, 2]], C[[1, 2, 1]]/C[[1, 1, 2]], C[[2, 1, 1]]/C[[1, 1, 2]], bkhN/(t[[4]] - t[[6]]), Max[Abs[Delete[Flatten[C], {{1 + 1}, {1 + 3}, {1 + 9}}]]]/Abs[C[[1, 1, 2]]]}], {th, bkPts4}];\nbkShow[\"X6_struct\", Join[{{\"(pow site2, pow site4, pow site6)\", \"coeff of <0|t(th6) at base point\"}}, Map[{ToString[#[[1]]], #[[2]]} &, bkEntries], {{\"data over 4 theta points: alpha6 | c4/c6 | c2/c6 | h/th46 | other entries rel\", \"\"}}, Map[{ToString[bkFmt /@ #[[1 ;; 3]]], ToString[bkFmt /@ #[[4 ;; 5]]]} &, bkR6]]]",
   "languageId": "wolfram",
