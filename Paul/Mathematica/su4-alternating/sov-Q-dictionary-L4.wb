      {
       "data": "Out[330]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{state} & \\text{weight} & \\text{|$\\Sigma$⟨$\\Psi$ᴸ|y⟩M⟨x|$\\Psi$⟩/⟨$\\Psi$ᴸ|$\\Psi$⟩ − 1|} & \\text{1/$\\mathcal{N}$ = ⟨$\\Psi$ᴸ|$\\Psi$⟩/(⟨0|$\\Psi$⟩⟨$\\Psi$ᴸ|0̄⟩)} & \\text{|Q-formula/direct − 1|}\\\\\\hline201 & \\left\\{2,0,0,-2\\right\\} & 0.\\times 10^{-50} & 0.0001347694117836222526465375553603693077486997982547901 & 0.\\times 10^{-41}\\\\\\hline248 & \\left\\{-2,0,0,2\\right\\} & 0.\\times 10^{-50} & 0.0001347694117836222526465375553603693077486997982547901 & 0.\\times 10^{-41}\\\\\\hline1 & \\left\\{0,0,0,0\\right\\} & 0.\\times 10^{-49} & 1.34189022366788886900643994883069683814689453637911\\times 10^{-6}-6.49852898901200707158421996408190376860893447118\\times 10^{-86}\\,\\mathrm{i} & 0.\\times 10^{-39}\\\\\\hline5 & \\left\\{0,0,0,0\\right\\} & 0.\\times 10^{-49} & 0.0000310386891411460668262254964691559874535938033452903-7.066549345824553432451245268562252829096661189069\\times 10^{-84}\\,\\mathrm{i} & 0.\\times 10^{-40}\\\\\\hline\\end{array}",
