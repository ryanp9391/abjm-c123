      },
      {
       "data": "Out[299]= \\begin{array}{|c|c|}\\hline\\text{F site: max |$\\tau$₁($\\theta$\\_F)$\\cdot$Q\\_j($\\theta$\\_F−h)/Q\\_j($\\theta$\\_F) − 1|, all j, all states} & 0.\\times 10^{-50}\\\\\\hline\\text{A site: max |$\\tau$\\_a($\\theta$\\_A−h)$\\cdot$D₀/D\\_a − 1|, all triples I, a = 1,2,3, all states} & 2\\times 10^{-54}\\\\\\hline\\text{RV product formula, 256 words $\\times$ 256 states $\\times$ 4 $\\sigma$} & 2.62844892544793721455987\\times 10^{-54}\\\\\\hline\\text{polynomial-gauge N\\_x per site (label 0..3): sites 1, 2, 3, 4} & \\begin{pmatrix}1 & -\\frac{1073}{30184} & \\frac{46092861}{9110738560} & \\frac{30636864570897}{5499970653900800}\\\\1 & -\\frac{2263}{14000} & \\frac{5121169}{196000000} & -\\frac{11589205447}{2744000000000}\\\\1 & \\frac{7857}{745360} & -\\frac{340215957}{555561529600} & \\frac{55399745790009}{828186683405312000}\\\\1 & \\frac{175491}{78848} & \\frac{30797091081}{6217007104} & \\frac{5404612310895771}{490198576136192}\\end{pmatrix}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "34593c88-3c34-4f7f-94dd-db86fd34b4d1"
    }
