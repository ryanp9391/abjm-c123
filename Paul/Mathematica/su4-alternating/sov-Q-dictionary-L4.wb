       "data": "Out[243]= \\begin{array}{|c|c|}\\hline\\text{c₁ = 603680/25947} & \\mathrm{True}\\\\\\hline\\text{(i) vacuum e₁$\\otimes$e₄$\\otimes$e₁$\\otimes$e₄} & \\mathrm{True}\\\\\\hline\\text{(i) BPS v$\\otimes$w$\\otimes$v$\\otimes$w, v$\\cdot$w = 0} & \\mathrm{True}\\\\\\hline\\text{(i) generic NON-BPS product state} & \\mathrm{False}\\\\\\hline\\text{(ii) twisted-vacuum eigenbra of t₁\\^{}\\{G\\_c(w)\\}(u), u = 3/10, −7/13} & \\mathrm{True}\\\\\\hline\\text{(iii) u\\_w G\\_c(z) v\\_w = 232551/1558000} & \\mathrm{True}\\\\\\hline\\text{frame map t\\^{}\\{G\\_c\\}(u) R = R t\\^{}$\\Lambda$(u), a = 1, 2, 3, two u} & \\mathrm{True}\\\\\\hline\\end{array}",
