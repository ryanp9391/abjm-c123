5em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-2.75em;\"></span></span></span><span style=\"top:-2.5em;\"><span class=\"pstrut\" style=\"height:5.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.7em;\"><span class=\"pstrut\" style=\"height:5.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-4.9em;\"><span class=\"pstrut\" style=\"height:5.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-6.1em;\"><span class=\"pstrut\" style=\"height:5.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-7.3em;\"><span class=\"pstrut\" style=\"height:5.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-8.5em;\"><span class=\"pstrut\" style=\"height:5.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.75em;\"><span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[277]= \\begin{array}{|c|c|}\\hline\\text{\\# weight blocks / \\# states} & \\left\\{55,256\\right\\}\\\\\\hline\\text{max eigen-residual} & 3\\times 10^{-58}\\\\\\hline\\text{min gap of the combination spectrum (simple joint spectrum)} & 0.00002150343784325907104254489387712909457450496799376188172\\\\\\hline\\text{vacuum: max\\_a |$\\tau$\\_a − e\\_a(z\\_iV\\_i)| at u = 0.3141 (rel)} & 0.\\times 10^{-58}\\\\\\hline\\text{min / max |⟨0|$\\Psi$⟩|/‖$\\Psi$‖ over the 256 states} & \\left\\{0.000340834939242384264746114140028946851968896791528761136,0.061168009754780433721485210146407000273132004130997726070227\\right\\}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "dbe32070-4b49-499f-9f0e-da13742e7ba3"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "**Python results [50d].** 55 blocks, 256 joint eigenstates, eigen-residual ≤ 3·10⁻⁴⁷, min gap of the combination spectrum 2.15·10⁻⁵ (simple joint spectrum at generic twist; 30 states have complex eigenvalues). Vacuum: τ_a = e_a(z_iV_i) (column shifts u, u−h, …) to 10⁻⁵⁰. **⟨0|Ψ⟩ ≠ 0 for all 256 states:** |⟨0|Ψ⟩|/‖Ψ‖ ∈ [3.4·10⁻⁴, 6.1·10⁻²] — the SoV vacuum is cyclic.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "## 5. Twisted Q-functions\n\nPolynomial form of the Baxter equation in the gauge Q_i = z_i^{u/h}Φ q_i, Φ(u) = V₄(u)Φ(u−h):\n\nΣ_{a=0}^{4} (−1)^a z_i^{−a} τ_a(u) q_i(u − ah) ∏_{b=a}^{3} V₄(u − bh) = 0.\n\nFor each state and each twist z_i the monic q_i is solved at degree 2 + μ_i (least squares at 22 + deg points, rows scaled by the individual term sizes). Casoratian polynomial parts P_I(u) = det[z_i^{|I|−1−s} q_i(u − sh)] are divisible by the vacuum factors F₂ = ∏_F(u−θ_F), F₃ = ∏_F(u−θ_F)(u−θ_F−h), F₄ = ∏_F(u−θ_F)(u−θ_F−h)(u−θ_F−2h)∏_A(u−θ_A+h); q_I := P_I/F_{|I|}.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "sqSolveQd[st_, i_, d_] := Module[{pts, data, c, res},\n   pts = Table[k/7 + 1/29, {k, -10, 11 + d}];\n   data = Table[Module[{pre, sc},\n      pre = Table[(-1)^a sqZ[[i]]^(-a) sqTau[st, a, u] Product[sqV4[u - b sqH], {b, a, 3}], {a, 0, 4}];\n      sc = Max[Table[Abs[pre[[a + 1]]] Max[1, Abs[u - a sqH]^d], {a, 0, 4}]];\n      {Table[Sum[pre[[a + 1]] (u - a sqH)^k, {a, 0, 4}], {k, 0, d - 1}]/sc, -Sum[pre[[a + 1]] (u - a sqH)^d, {a, 0, 4}]/sc}], {u, pts}];\n   c = If[d == 0, {}, LeastSquares[data[[All, 1]], data[[All, 2]]]];\n   res = Max[Abs[If[d == 0, 0 data[[All, 2]], data[[All, 1]] . c] - data[[All, 2]]]];\n   {Append[c, 1] . sqx^Range[0, d], res}];\nsqSolveQ[st_, i_] := sqSolveQd[st, i, 2 + st[\"weight\"][[i]]];\nsqTrim[p_] := Module[{c = CoefficientList[Expand[p], sqx]}, c = Chop[c, 10^-30 Max[Abs[c]]]; c . sqx^Range[0, Length[c] - 1]];\nsqFvac[2] = (sqx - sqTh[[2]]) (sqx - sqTh[[4]]);\nsqFvac[3] = sqFvac[2] (sqx - sqTh[[2]] - sqH) (sqx - sqTh[[4]] - sqH);\nsqFvac[4] = sqFvac[3] (sqx - sqTh[[2]] - 2 sqH) (sqx - sqTh[[4]] - 2 sqH) (sqx - sqTh[[1]] + sqH) (sqx - sqTh[[3]] + sqH);\nsqQs = Table[Module[{sol = Table[sqSolveQ[st, i], {i, 4}], q, out = <||>, rem = 0},\n    q = sol[[All, 1]];\n    Do[out[{i}] = q[[i]], {i, 4}];\n    Do[Module[{k = Length[ss], P, qr},\n       P = Expand[Det[Table[sqZ[[m]]^(k - 1 - s) (q[[m]] /. sqx -> sqx - s sqH), {s, 0, k - 1}, {m, ss}]]];\n       qr = PolynomialQuotientRemainder[P, Expand[sqFvac[k]], sqx];\n       rem = Max[rem, Max[Append[Abs[CoefficientList[qr[[2]], sqx]], 0]]/Max[Abs[CoefficientList[P, sqx]]]];\n       out[ss] = sqTrim[qr[[1]]]], {ss, Subsets[Range[4], {2, 4}]}];\n    <|\"Q\" -> out, \"baxterRes\" -> Max[sol[[All, 2]]], \"casRem\" -> rem|>], {st, sqStates}];\n(* no polynomial solution one degree lower (sample of states) *)\nsqLower = Min[Flatten[Table[If[2 + sqStates[[n, \"weight\"]][[i]] > 0, sqSolveQd[sqStates[[n]], i, 1 + sqStates[[n, \"weight\"]][[i]]][[2]], Infinity], {n, 1, 256, 15}, {i, 4}]]];\nsqDegOK = And @@ Flatten[Table[Exponent[sqQs[[n]][\"Q\"][ss], sqx] == 2 + Total[sqStates[[n, \"weight\"]][[ss]]], {n, 256}, {ss, Subsets[Range[4], {1, 3}]}]];\nsqQ1234 = Table[sqQs[[n]][\"Q\"][{1, 2, 3, 4}], {n, 256}];\nGrid[{{\"max Baxter residual (scaled), all 1024 solutions\", Max[sqQs[[All, \"baxterRes\"]]]},\n  {\"min residual one degree lower (sample)\", sqLower},\n  {\"deg q_I = 2 + Σ_{i∈I} μ_i for all states, |I| ≤ 3\", sqDegOK},\n  {\"max Casoratian remainder after dividing by F_{|I|}\", Max[sqQs[[All, \"casRem\"]]]},\n  {\"q₁₂₃₄ (state independent?)\", {sqQ1234[[1]], Max[Abs[sqQ1234/sqQ1234[[1]] - 1]]}},\n  {\"vacuum q₁, q₂, q₃, q₄\", Table[Chop[N[sqQs[[sqVacIdx]][\"Q\"][{i}], 8]], {i, 4}]}}, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"725119\" data-output-id=\"252\" data-out-n=\"288\" data-sub-idx=\"11\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"14\" data-sub-start=\"27\" data-sub-end=\"32\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[288]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"17\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:7.26em;vertical-align:-3.36em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.9em;\"><span style=\"top:-5.86em;\"><span class=\"pstrut\" style=\"height:5.86em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:7.22em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-3.36em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.86em;\"><span style=\"top:-6.02em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">max Baxter residual (scaled), all 1024 solutions</span></span></span></span><span style=\"top:-4.82em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">min residual one degree lower (sample)</span></span></span></span><span style=\"top:-3.62em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">deg q_I = 2 + Σ_{i</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">∈</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mord\">I} </span><span class=\"mord mathnormal\">μ</span><span class=\"mord\">_i for all states, |I| </span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">≤</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mord\"> 3</span></span></span></span><span style=\"top:-2.42em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">max Casoratian remainder after dividing by F_{|I|}</span></span></span></span><span style=\"top:-1.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">q₁₂₃₄ (state independent?)</span></span></span></span><span style=\"top:0em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">vacuum q₁, q₂, q₃, q₄</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.36em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:7.22em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-3.36em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.86em;\"><span style=\"top:-6.02em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">0.</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord\">1</span><span class=\"mord\"><span class=\"mord\">0</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8141em;\"><span style=\"top:-3.063em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">−</span><span class=\"mord mtight\">52</span></span></span></span></span></span></span></span></span></span></span><span style=\"top:-4.82em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">0.00358670815279180074612920259943725202523783734962136</span></span></span><span style=\"top:-3.62em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">True</span></span></span></span><span style=\"top:-2.42em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">0</span></span></span><span style=\"top:-1.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size1\">{</span></span><span class=\"mord\"><span class=\"mopen nulldelimiter\"></span><span class=\"mfrac\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8451em;\"><span style=\"top:-2.655em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">169344</span></span></span></span><span style=\"top:-3.23em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"frac-line\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.394em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">1235</span></span></span></span><