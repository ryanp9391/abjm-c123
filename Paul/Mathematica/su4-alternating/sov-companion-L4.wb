      {
       "data": "Out[869]= \\begin{array}{|c|c|}\\hline\\text{A-site evaluation point} & \\text{rank of 256 words ($\\theta$\\_A = $\\theta$\\_F + 2h, reduced t's)}\\\\\\hline\\text{u\\_A = $\\theta$\\_A + (0)} & 169\\\\\\hline\\text{u\\_A = $\\theta$\\_A + (1 - 2)} & 169\\\\\\hline\\text{u\\_A = $\\theta$\\_A + (  1 -(-)   2)} & 169\\\\\\hline\\text{u\\_A = $\\theta$\\_A + (-1)} & 169\\\\\\hline\\text{u\\_A = $\\theta$\\_A + (  3 -(-)   2)} & 256\\\\\\hline\\text{u\\_A = $\\theta$\\_A + (1)} & 256\\\\\\hline\\end{array}",
