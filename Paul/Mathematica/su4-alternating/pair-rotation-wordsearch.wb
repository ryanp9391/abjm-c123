       "data": "Out[1834]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{ref} & \\text{\\#factors} & \\text{dim S (mod p)} & \\text{dim S12 (mod p)} & \\text{seconds}\\\\\\hline\\text{R1} & 102 & 54 & 6 & 1\\\\\\hline\\end{array}",
