       "data": "Out[1856]= \\begin{array}{|c|c|}\\hline\\text{x(kappa)} & \\begin{pmatrix}\\frac{-8833\\,k-56000}{168000} & 0 & 0 & \\frac{2263\\,k+24500}{24500}\\\\0 & \\frac{949\\,k}{33600} & 0 & 0\\\\0 & 0 & \\frac{949\\,k}{33600} & 0\\\\\\frac{-6789\\,k-28000}{252000} & 0 & 0 & \\frac{69423\\,k+392000}{1176000}\\end{pmatrix}\\\\\\hline\\text{det of \\{1,4\\} block} & -\\frac{2701803\\,k^2}{4390400000}\\\\\\hline\\text{ranks at kappa=1/3,-2/5,5/3} & \\left\\{4,4,4\\right\\}\\\\\\hline\\end{array}",
