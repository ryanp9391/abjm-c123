:0.04em;\"></span></span><span style=\"top:-48.2175em;\"><span class=\"pstrut\" style=\"height:30.5266em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-49.4226em;\"><span class=\"pstrut\" style=\"height:30.5266em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-50.6277em;\"><span class=\"pstrut\" style=\"height:30.5266em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-51.8328em;\"><span class=\"pstrut\" style=\"height:30.5266em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-53.0379em;\"><span class=\"pstrut\" style=\"height:30.5266em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-54.243em;\"><span class=\"pstrut\" style=\"height:30.5266em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-55.4481em;\"><span class=\"pstrut\" style=\"height:30.5266em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-56.6532em;\"><span class=\"pstrut\" style=\"height:30.5266em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-57.8532em;\"><span class=\"pstrut\" style=\"height:30.5266em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-59.0532em;\"><span class=\"pstrut\" style=\"height:30.5266em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:28.0266em;\"><span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[1822]= \\begin{array}{|c|c|c|c|c|c|c|}\\hline\\text{dims} & \\text{dim S12 full} & 6 & \\text{dim S12 singles-only} & 6 & \\text{\\#singles} & 102\\\\\\hline\\text{kappa} & \\text{target} & \\text{in full S12} & \\text{in singles-only S12} &  &  & \\\\\\hline\\frac{1}{3} & \\text{T\\_A  (v D) x (u D\\^{}-1)} & \\mathrm{True} & \\mathrm{True} &  &  & \\\\\\hline\\frac{1}{3} & \\text{T\\_B  (v D\\^{}-1) x (u D)} & \\mathrm{True} & \\mathrm{True} &  &  & \\\\\\hline\\frac{1}{3} & \\text{T\\_C  Lam\\^{}-1 version of A} & \\mathrm{True} & \\mathrm{True} &  &  & \\\\\\hline\\frac{1}{3} & \\text{T\\_D  Lam\\^{}-1 version of B} & \\mathrm{True} & \\mathrm{True} &  &  & \\\\\\hline\\frac{1}{3} & \\text{vD x u} & \\mathrm{True} & \\mathrm{True} &  &  & \\\\\\hline\\frac{1}{3} & \\text{v x uD} & \\mathrm{True} & \\mathrm{True} &  &  & \\\\\\hline\\frac{1}{3} & \\text{v x uD\\^{}-1} & \\mathrm{True} & \\mathrm{True} &  &  & \\\\\\hline\\frac{1}{3} & \\text{vD\\^{}-1 x u} & \\mathrm{True} & \\mathrm{True} &  &  & \\\\\\hline\\frac{1}{3} & \\text{v(1-kL\\^{}-1) x u} & \\mathrm{True} & \\mathrm{True} &  &  & \\\\\\hline\\frac{1}{3} & \\text{v x u(1-kL\\^{}-1)} & \\mathrm{True} & \\mathrm{True} &  &  & \\\\\\hline-\\frac{2}{5} & \\text{T\\_A  (v D) x (u D\\^{}-1)} & \\mathrm{True} & \\mathrm{True} &  &  & \\… [latex truncated: 3961 chars total]",
       "mime": "text/plain"
      }
