      {
       "data": "Out[1739]= \\begin{array}{|c|c|c|c|c|c|}\\hline\\text{frame} & \\text{[t1,t2]=0} & \\text{[t1,t3]=0} & \\text{[t2,t3]=0} & \\text{t4 scalar} & \\text{t4(1/3)}\\\\\\hline\\text{diag} & \\mathrm{True} & \\mathrm{True} & \\mathrm{True} & \\mathrm{True} & -\\frac{47526436485905}{63246551174940672}\\\\\\hline\\text{comp} & \\mathrm{True} & \\mathrm{True} & \\mathrm{True} & \\mathrm{True} & -\\frac{47526436485905}{63246551174940672}\\\\\\hline\\end{array}",
