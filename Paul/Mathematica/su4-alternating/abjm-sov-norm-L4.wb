   "value": "nmRunEps[eps_, prec_] := Module[{z = 1 + eps nmPhi, th = nmThEps[eps], G, ops, W, Yk, Gm, res, t0 = AbsoluteTime[]},\n  G = nmGc[z]; ops = nmAbjmOps[G, th]; {W, Yk, Gm} = nmGram[ops]; res = nmAbjmEval[eps, prec, ops, Gm, 3/10];\n  <|\"res\" -> res, \"ident\" -> ops[\"ident\"], \"gramNZ\" -> nmNZ[Gm], \"rank\" -> MatrixRank[Normal[Gm], Modulus -> 2305843009213693951], \"time\" -> AbsoluteTime[] - t0|>];\nnmR200 = nmRunEps[1/200, 100];\nnmR200[\"time\"]",
