      {
       "data": "Out[838]= \\begin{array}{|c|c|}\\hline\\text{identities <0|\\_Lam = lam(x)1(x)lam(x)1 and |0bar>\\_Lam = 1(x)lam(x)1(x)lam (exact)} & \\left\\{\\mathrm{True},\\mathrm{True}\\right\\}\\\\\\hline\\text{<0|Psi> = lambda\\^{}w <0bar\\^{}T|Psi>: max rel. deviation over 256 states} & 0.\\times 10^{-60}\\\\\\hline\\text{\\# states with real eigenvector / complex} & \\left\\{226,30\\right\\}\\\\\\hline\\text{max off-diagonal cosine of the right eigenvectors, Psi\\^{}T Psi (bilinear)} & 1.146\\\\\\hline\\text{same, Hermitian Psi\\^{}dag Psi} & 0.9847\\\\\\hline\\text{min over states of cos(PsiL\\_n, Psi\\_n\\^{}T) (1 means PsiL = c Psi\\^{}T)} & 0.1182\\\\\\hline\\text{min over states of cos(PsiL\\_n, Psi\\_n\\^{}dagger)} & 0.\\times 10^{-60}\\\\\\hline\\end{array}",
