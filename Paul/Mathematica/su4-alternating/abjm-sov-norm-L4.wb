      {
       "data": "Out[899]= \\begin{array}{|c|c|c|c|c|c|}\\hline\\text{state} & \\text{|A| (eps->0)} & \\text{N\\_pre (eps->0)} & \\text{|W| (eps->0)} & \\text{|B| (eps->0)} & \\text{A N\\_pre W / sqrt(B)}\\\\\\hline\\text{E = 20 singlet (target 1/sqrt40)} & 10.00000000000 & 1.000000000000 & 25.0000000000 & 2.50000000000\\times 10^{6} & 0.15811388300842\\\\\\hline\\text{E = 4 singlet (target 1/sqrt24)} & 2.00000000000 & 1.000000000000 & 9.00000000000 & 7776.00000000 & 0.20412414523193\\\\\\hline\\end{array}",
