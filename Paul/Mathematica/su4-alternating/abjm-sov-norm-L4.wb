      },
      {
       "data": "Out[824]= \\begin{array}{|c|c|}\\hline\\text{time (s)} & 18.9674818\\\\\\hline\\text{max\\_256 |sum tauT M tau / (<PsiL|Psi>/(<0|Psi><PsiL|0bar>)) - 1|  [hp, 60 digits]} & 0.\\times 10^{-48}\\\\\\hline\\text{min, max of |1/N| over the 256 states} & \\left\\{1.3419\\times 10^{-6},348630\\right\\}\\\\\\hline\\text{Im parts negligible: max |Im(1/N)|/|1/N|} & 0.976\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
