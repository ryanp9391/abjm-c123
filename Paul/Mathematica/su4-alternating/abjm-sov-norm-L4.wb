   "value": "nmRunT100 = AbsoluteTiming[nmRes100 = nmAbjmEval[1/100, 100, nmOpsA, nmGmA, 3/10]][[1]];\nnmSummary[res_] := Module[{rows = res[\"rows\"], sing},\n  sing = Select[rows, #[\"Cdir\"] > 5/100 &];\n  {res[\"eps\"], Count[rows[[All, \"real\"]], True], N[res[\"wchk\"], 3], N[res[\"gerr\"], 3], N[Max[rows[[All, \"invNerr\"]]], 3], N[Max[rows[[All, \"wErr\"]]], 3], Length[sing], N[sing[[All, \"Cdir\"]], 10], N[sing[[All, \"CQ\"]], 10], N[sing[[All, \"H\"]], 8]}];\nGrid[Prepend[{Prepend[nmSummary[nmRes100], nmRunT100]}, {\"time (s)\", \"eps\", \"# real states\", \"max |t2'-t1' tF|/w - 1 and t3' check\", \"max |G.sol - tau| (solve residual)\", \"max_28 |1/N_Q / 1/N_direct - 1|\", \"max_28 |<W_a|Psi> direct vs closed form| rel\", \"# singlet candidates\", \"|C_direct|\", \"|C_Q| (norm from Q-data)\", \"H = |<0|Psi>|^2/(|N| ||Psi||^2)\"}], Frame -> All, Alignment -> Left]",
