  {
   "kind": 1,
   "value": "## 8. Task 2/3 results: 1/N from eigenvalues vs direct, and extrapolation of the Q-based even bridge",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "nmResList = {nmR50[\"res\"], nmRes100, nmR200[\"res\"], nmR400[\"res\"], nmR800[\"res\"], nmR1600[\"res\"]};\nnmGramNZ = {nmR50[\"gramNZ\"], nmNZ[nmGmA], nmR200[\"gramNZ\"], nmR400[\"gramNZ\"], nmR800[\"gramNZ\"], nmR1600[\"gramNZ\"]};\nnmRankL = {nmR50[\"rank\"], 256, nmR200[\"rank\"], nmR400[\"rank\"], nmR800[\"rank\"], nmR1600[\"rank\"]};\nnmIdentL = {nmR50[\"ident\"], nmR200[\"ident\"], nmR400[\"ident\"], nmR800[\"ident\"], nmR1600[\"ident\"]};\nnmEpsL = nmResList[[All, \"eps\"]];\nnmTgt = {1/Sqrt[40], 1/Sqrt[24]};\nnmPick[res_, t_] := First[SortBy[Select[res[\"rows\"], #[\"real\"] &], Abs[#[\"Cdir\"] - t] &]];\nnmSing = Table[Table[nmPick[res, t], {res, nmResList}], {t, nmTgt}];\nnmExtrap[vals_] := InterpolatingPolynomial[Transpose[{nmEpsL, vals}], nmx] /. nmx -> 0;\nnmExtrapK[vals_, k_] := InterpolatingPolynomial[Transpose[{nmEpsL[[-k ;;]], vals[[-k ;;]]}], nmx] /. nmx -> 0;\nnmExt = Table[{nmTgt[[j]], nmExtrap[nmSing[[j, All, \"Cdir\"]]], nmExtrap[nmSing[[j, All, \"CQ\"]]], nmExtrapK[nmSing[[j, All, \"CQ\"]], 4], nmExtrapK[nmSing[[j, All, \"CQ\"]], 3]}, {j, 2}];\nnmInvNmax = Table[{res[\"eps\"], Max[res[\"rows\"][[All, \"invNerr\"]]], res[\"gerr\"], res[\"wchk\"], Max[res[\"rows\"][[All, \"wErr\"]]]}, {res, nmResList}];\nColumn[{Grid[Prepend[Table[{nmEpsL[[i]], nmGramNZ[[i]], nmRankL[[i]], N[nmInvNmax[[i, 2]], 3], N[nmInvNmax[[i, 3]], 3], N[nmInvNmax[[i, 5]], 3]}, {i, 6}], {\"eps\", \"# Gram nonzeros\", \"rank mod p of Gram\", \"max_28 |1/N_Q / 1/N_direct - 1|\", \"Gram solve residual\", \"max_28 closed-form <W_a|Psi> rel. error\"}], Frame -> All, Alignment -> Left],\n  Grid[Prepend[Table[{nmEpsL[[i]], N[nmSing[[1, i, \"Cdir\"]], 12], N[nmSing[[1, i, \"CQ\"]], 12], N[nmSing[[1, i, \"H\"]], 10], N[nmSing[[2, i, \"Cdir\"]], 12], N[nmSing[[2, i, \"CQ\"]], 12], N[nmSing[[2, i, \"H\"]], 10]}, {i, 6}], {\"eps\", \"|C_dir| (1/sqrt40)\", \"|C_Q| (1/sqrt40)\", \"H\", \"|C_dir| (1/sqrt24)\", \"|C_Q| (1/sqrt24)\", \"H\"}], Frame -> All, Alignment -> Left],\n  Grid[Prepend[Table[{N[e[[1]], 12], N[e[[2]], 12], N[e[[3]], 12], N[e[[4]], 12], N[e[[5]], 12], N[e[[3]] - e[[1]], 3]}, {e, nmExt}], {\"target\", \"extrap |C_dir| (deg 5)\", \"extrap |C_Q| (deg 5)\", \"|C_Q| deg 3 (last 4 pts)\", \"|C_Q| deg 2 (last 3 pts)\", \"|C_Q|(deg5) - target\"}], Frame -> All, Alignment -> Left]}]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
