      {
       "data": "Out[889]= \\begin{array}{|c|c|c|c|c|c|}\\hline\\text{eps} & \\text{singlet j (1: E=20, 2: E=4)} & \\text{state n} & \\text{<Psi0\\_data|Psi\\_eps> (sign-fixed > 0)} & \\text{signed C\\_direct} & \\text{|target| 1/sqrt40, 1/sqrt24 (data sign: -, +)}\\\\\\hline\\frac{1}{400} & 1 & 27 & 0.9999992605930875 & -0.158074407836 & 0.158113883008\\\\\\hline\\frac{1}{400} & 2 & 28 & 0.9999987676569889 & 0.204071983258 & 0.204124145232\\\\\\hline\\frac{1}{800} & 1 & 27 & 0.9999998153136191 & -0.158094132127 & 0.158113883008\\\\\\hline\\frac{1}{800} & 2 & 28 & 0.99999969218948 & 0.204098347093 & 0.204124145232\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
