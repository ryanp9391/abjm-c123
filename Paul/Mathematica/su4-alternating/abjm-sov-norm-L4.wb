       "data": "Out[808]= \\begin{array}{|c|c|}\\hline\\text{time ops, words+Gram (s)} & \\left\\{36.1746805,1.6978103\\right\\}\\\\\\hline\\text{rank of bra words (exact)} & 256\\\\\\hline\\text{\\# nonzero Gram} & 1456\\\\\\hline\\text{Gram . M == 1 (exact)} & \\mathrm{True}\\\\\\hline\\text{\\# nonzero M} & 1456\\\\\\hline\\end{array}",
