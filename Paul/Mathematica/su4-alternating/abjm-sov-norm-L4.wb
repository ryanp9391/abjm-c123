       "data": "Out[884]= \\begin{matrix}\\begin{array}{|c|c|c|c|c|c|}\\hline\\text{eps} & \\text{\\# Gram nonzeros} & \\text{rank mod p of Gram} & \\text{max\\_28 |1/N\\_Q / 1/N\\_direct - 1|} & \\text{Gram solve residual} & \\text{max\\_28 closed-form <W\\_a|Psi> rel. error}\\\\\\hline\\frac{1}{50} & 3323 & 256 & 0.\\times 10^{-48} & 0.\\times 10^{-77} & 0.\\times 10^{-80}\\\\\\hline\\frac{1}{100} & 3323 & 256 & 0.\\times 10^{-41} & 0.\\times 10^{-74} & 0.\\times 10^{-78}\\\\\\hline\\frac{1}{200} & 3323 & 256 & 0.\\times 10^{-33} & 0.\\times 10^{-70} & 0.\\times 10^{-76}\\\\\\hline\\frac{1}{400} & 3323 & 256 & 1.8\\times 10^{-40} & 2.10\\times 10^{-85} & 0.\\times 10^{-73}\\\\\\hline\\frac{1}{800} & 3323 & 256 & 0.\\times 10^{-29} & 4.4336713890671\\times 10^{-102} & 0.\\times 10^{-81}\\\\\\hline\\frac{1}{1600} & 3323 & 256 & 0.\\times 10^{-32} & 5.4\\times 10^{-99} & 0.\\times 10^{-88}\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|c|c|c|c|c|}\\hline\\text{eps} & \\text{|C\\_dir| (1/sqrt40)} & \\text{|C\\_Q| (1/sqrt40)} & \\text{H} & \\text{|C\\_dir| (1/sqrt24)} & \\text{|C\\_Q| (1/sqrt24)} & \\text{H}\\\\\\hline\\frac{1}{50} & 0.157800959718 & 0.152083131374 & 1.076606973 & 0.203643101598 & 0.202173933820 & 1.014586508\\\\\\hline\\frac{1}{100} & 0.157956610596 & 0.155064907354 & 1.03764… [latex truncated: 2210 chars total]",
