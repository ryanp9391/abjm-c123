      {
       "data": "Out[845]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{eps} & \\text{\\# real states (of 28)} & \\text{max |H\\_n - 1| (real states)} & \\text{max|H-1|/(2 eps)} & \\text{min cos(PsiL, Psi\\^{}*) (real states)}\\\\\\hline\\frac{1}{10} & 16 & 0.4415 & 2.207 & 0.991190\\\\\\hline\\frac{1}{20} & 16 & 0.2019 & 2.019 & 0.997831\\\\\\hline\\frac{1}{50} & 16 & 0.07661 & 1.915 & 0.999656\\\\\\hline\\frac{1}{100} & 16 & 0.03764 & 1.882 & 0.999914\\\\\\hline\\frac{1}{200} & 16 & 0.01866 & 1.866 & 0.999979\\\\\\hline\\frac{1}{400} & 16 & 0.009290 & 1.858 & 0.999995\\\\\\hline\\end{array}",
