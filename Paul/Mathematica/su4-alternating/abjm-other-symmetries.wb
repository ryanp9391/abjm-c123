      {
       "data": "Out[754]= \\begin{matrix}\\begin{array}{|c|c|c|}\\hline\\text{L} & \\text{symmetry} & \\text{max |B$\\cdot$X(u)r| (relative), 3 random two-site states}\\\\\\hline2 & \\text{P} & \\text{1.3}\\times 10^{\\text{-16}}\\\\\\hline2 & \\text{LP} & \\text{5.5}\\times 10^{\\text{-2}}\\\\\\hline2 & \\text{LR} & \\text{5.1}\\times 10^{\\text{-2}}\\\\\\hline3 & \\text{P} & \\text{5.1}\\times 10^{\\text{-17}}\\\\\\hline3 & \\text{LP} & \\text{1.9}\\times 10^{\\text{-2}}\\\\\\hline3 & \\text{LR} & \\text{1.9}\\times 10^{\\text{-2}}\\\\\\hline4 & \\text{P} & \\text{1.8}\\times 10^{\\text{-17}}\\\\\\hline4 & \\text{LP} & \\text{3.5}\\times 10^{\\text{-3}}\\\\\\hline4 & \\text{LR} & \\text{3.5}\\times 10^{\\text{-3}}\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|c|c|}\\hline\\text{1−|v₁$\\cdot$v₃| (herm.)} & \\text{1−|v₂$\\cdot$v₄|} & \\text{1−|v₁$\\cdot$v₄|} & \\text{1−|v₂$\\cdot$v₃|}\\\\\\hline0.1194 & 0.5488000000000001 & 1.\\, & 1.\\,\\\\\\hline0.4601 & 0.504 & 1.\\, & 1.\\,\\\\\\hline0.5861000000000001 & 0.1107 & 1.\\, & 1.\\,\\\\\\hline0.6464000000000001 & 0.0125 & 1.\\, & 1.\\,\\\\\\hline\\end{array}\\end{matrix}",
       "mime": "text/plain"
