       "data": "Out[741]= \\begin{array}{|c|c|c|c|c|c|c|}\\hline & \\text{dim kernel} & \\text{\\# starts} & \\text{\\# zeros} & \\text{\\# stuck (f > 10⁻⁶)} & \\text{zeros: eigen-bra? (tally)} & \\text{zero types |v\\_s| (rounded)}\\\\\\hline\\text{P, untwisted} & 136 & 40 & 40 & 0 & \\begin{pmatrix}\\mathrm{False} & 40\\end{pmatrix} & 40\\\\\\hline\\text{LP, untwisted} & 196 & 40 & 40 & 0 & \\begin{pmatrix}\\mathrm{False} & 40\\end{pmatrix} & 40\\\\\\hline\\end{array}",
