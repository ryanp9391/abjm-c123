pan></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[763]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{L} & \\text{product state (A $\\in$ span(e₁,e₂), F $\\in$ span(e₃,e₄))} & \\text{X\\_P} & \\text{X\\_LP} & \\text{X\\_LR}\\\\\\hline2 & \\text{generic in sector} & \\text{8.6}\\times 10^{\\text{-2}} & \\text{2.8}\\times 10^{\\text{-16}} & \\text{9.5}\\times 10^{\\text{-2}}\\\\\\hline2 & \\text{two-site in sector} & \\text{1.5}\\times 10^{\\text{-16}} & \\text{2.3}\\times 10^{\\text{-16}} & \\text{1.8}\\times 10^{\\text{-16}}\\\\\\hline3 & \\text{generic in sector} & \\text{3.}\\times 10^{\\text{-2}} & \\text{1.6}\\times 10^{\\text{-2}} & \\text{2.6}\\times 10^{\\text{-2}}\\\\\\hline3 & \\text{two-site in sector} & \\text{3.2}\\times 10^{\\text{-17}} & \\text{6.3}\\times 10^{\\text{-17}} & \\text{3.6}\\times 10^{\\text{-17}}\\\\\\hline4 & \\text{generic in sector} & \\text{7.4}\\times 10^{\\text{-3}} & \\text{7.1}\\times 10^{\\text{-3}} & \\text{8.8}\\times 10^{\\text{-3}}\\\\\\hline4 & \\text{two-site in sector} & \\text{7.1}\\times 10^{\\text{-18}} & \\text{8.2}\\times 10^{\\text{-18}} & \\text{5.9}\\times 10^{\\text{-18}}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "f2456e99-cd23-408e-9d03-8bdc5fa4ca5c"
    }
