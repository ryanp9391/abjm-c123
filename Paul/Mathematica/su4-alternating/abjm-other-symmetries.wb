      {
       "data": "Out[759]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{L} & \\text{product state} & \\text{X\\_P} & \\text{X\\_LP} & \\text{X\\_LR}\\\\\\hline2 & \\text{F$\\perp$nextA} & \\text{1.2}\\times 10^{\\text{-1}} & \\text{4.5}\\times 10^{\\text{-2}} & \\text{1.3}\\times 10^{\\text{-1}}\\\\\\hline2 & \\text{A$\\perp$nextF} & \\text{1.2}\\times 10^{\\text{-1}} & \\text{5.9}\\times 10^{\\text{-2}} & \\text{1.3}\\times 10^{\\text{-1}}\\\\\\hline2 & \\text{generic} & \\text{7.}\\times 10^{\\text{-2}} & \\text{1.1}\\times 10^{\\text{-1}} & \\text{9.9}\\times 10^{\\text{-2}}\\\\\\hline3 & \\text{F$\\perp$nextA} & \\text{2.7}\\times 10^{\\text{-2}} & \\text{3.2}\\times 10^{\\text{-2}} & \\text{3.4}\\times 10^{\\text{-2}}\\\\\\hline3 & \\text{A$\\perp$nextF} & \\text{2.4}\\times 10^{\\text{-2}} & \\text{2.9}\\times 10^{\\text{-2}} & \\text{3.9}\\times 10^{\\text{-2}}\\\\\\hline3 & \\text{generic} & \\text{2.8}\\times 10^{\\text{-2}} & \\text{2.9}\\times 10^{\\text{-2}} & \\text{3.5}\\times 10^{\\text{-2}}\\\\\\hline4 & \\text{F$\\perp$nextA} & \\text{7.4}\\times 10^{\\text{-3}} & \\text{6.8}\\times 10^{\\text{-3}} & \\text{8.5}\\times 10^{\\text{-3}}\\\\\\hline4 & \\text{A$\\perp$nextF} & \\text{7.}\\times 10^{\\text{-3}} & \\text{6.2}\\times 10^{\\text{-3}} & \\text{6.7}\\times 10^{\\text{-3}}\\\\\\hline4 & \\text{generic} & \\text{… [latex truncated: 1312 chars total]",
