      {
       "data": "Out[1792]= \\begin{array}{|c|c|c|c|}\\hline\\text{configuration} & \\text{a' or a''} & \\text{v.u} & \\text{comment}\\\\\\hline\\text{(a): pair 1 = (e1 + a e4, e4 - a' e1)} & 1.074074074074074 & -0.7407407407407407 & \\text{= a - a'}\\\\\\hline\\text{(b): pair 1 = (e1 + a'' e4, e4 - a e1)} & 0.10344827586206896 & -0.22988505747126436 & \\text{= a'' - a}\\\\\\hline\\text{chain: pair 1 = W\\_a} & 0.3333333333333333 & 0 & \\text{trace 0, a unchanged; pair 2 as (a)}\\\\\\hline\\text{even-bridge target: pair 1 = W\\_a', a' != a} & \\text{-} & 0 & \\text{requires A and F rotated together: not reached}\\\\\\hline\\end{array}",
