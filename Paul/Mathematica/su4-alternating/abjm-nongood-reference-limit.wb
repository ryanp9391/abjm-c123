       "data": "Out[1776]= \\begin{array}{|c|c|c|c|c|c|}\\hline\\text{(phi, c)} & \\text{Dynkin} & \\text{a'} & \\text{eps} & \\text{(T\\_eps - <vac|Psi0>)/(a-a')} & \\text{X = <e1e1 vac|Psi0>}\\\\\\hline\\text{phi1, c=2} & \\left\\{2,0,2\\right\\} & 1.074074074074074 & 0.01 & 0 & 0\\\\\\hline\\text{phi1, c=2} & \\left\\{2,0,2\\right\\} & 1.074074074074074 & 0.001 & 0 & 0\\\\\\hline\\text{phi1, c=2} & \\left\\{2,0,2\\right\\} & 1.074074074074074 & 0.0001 & \\text{1.661}\\times 10^{\\text{-12}} & 0\\\\\\hline\\text{phi1, c=2} & \\left\\{1,0,1\\right\\} & 1.074074074074074 & 0.01 & \\text{1.375}\\times 10^{\\text{-1}}-\\left(\\text{2.493}\\times 10^{\\text{-1}}\\right)\\,\\mathrm{i} & \\text{1.443}\\times 10^{\\text{-1}}-\\left(\\text{2.5}\\times 10^{\\text{-1}}\\right)\\,\\mathrm{i}\\\\\\hline\\text{phi1, c=2} & \\left\\{1,0,1\\right\\} & 1.074074074074074 & 0.001 & \\text{1.437}\\times 10^{\\text{-1}}-\\left(\\text{2.499}\\times 10^{\\text{-1}}\\right)\\,\\mathrm{i} & \\text{1.443}\\times 10^{\\text{-1}}-\\left(\\text{2.5}\\times 10^{\\text{-1}}\\right)\\,\\mathrm{i}\\\\\\hline\\text{phi1, c=2} & \\left\\{1,0,1\\right\\} & 1.074074074074074 & 0.0001 & \\text{1.443}\\times 10^{\\text{-1}}-\\left(\\text{2.5}\\times 10^{\\text{-1}}\\right)\\,\\mathrm{i} & \\text{1.443}\\times 10^{\\text{-1}}-\\left(\\text{2.5}\\times 10^{\\te… [latex truncated: 8765 chars total]",
