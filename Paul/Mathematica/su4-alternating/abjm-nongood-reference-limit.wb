      {
       "data": "Out[1729]= \\begin{array}{|c|c|c|c|c|c|}\\hline\\text{Dynkin} & \\text{E\\_MZ} & \\text{C\\_1 (data)} & \\text{<e1e1 vac\\^{}(L-1)|Psi0>} & \\text{<e4e4 vac\\^{}(L-1)|Psi0>} & \\text{<vac\\^{}L|Psi0>}\\\\\\hline\\left\\{2,0,2\\right\\} & 0.\\, & \\text{1.} & \\text{0.} & \\text{0.} & \\text{1.}\\\\\\hline\\left\\{0,2,0\\right\\} & 15.999999999999996 & \\text{0.} & \\text{0.} & \\text{0.} & \\text{0.}\\\\\\hline\\left\\{1,0,1\\right\\} & 12.\\, & \\text{0.14434}-\\text{0.25}\\,\\mathrm{i} & \\text{0.14434}-\\text{0.25}\\,\\mathrm{i} & \\text{0.14434}-\\text{0.25}\\,\\mathrm{i} & \\text{0.}+\\text{0.}\\,\\mathrm{i}\\\\\\hline\\left\\{1,0,1\\right\\} & 12.\\, & \\text{0.14434}+\\text{0.25}\\,\\mathrm{i} & \\text{0.14434}+\\text{0.25}\\,\\mathrm{i} & \\text{0.14434}+\\text{0.25}\\,\\mathrm{i} & \\text{0.}+\\text{0.}\\,\\mathrm{i}\\\\\\hline\\left\\{0,0,0\\right\\} & 20.\\, & \\text{0.} & \\text{0.} & \\text{0.} & \\text{0.}\\\\\\hline\\left\\{0,0,0\\right\\} & 4.\\, & \\text{0.} & \\text{0.} & \\text{0.} & \\text{0.}\\\\\\hline\\end{array}",
