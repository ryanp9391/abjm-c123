      {
       "data": "Out[1805]= \\begin{array}{|c|c|c|c|}\\hline\\text{shift test: a} & \\text{a'} & \\text{|B* rho(n) - shifted|} & \\text{max\\_states |<B*|Psi0> - (vac + (a-a')X)|}\\\\\\hline\\frac{\\text{1}}{\\text{3}} & \\text{2} & 0 & 0\\\\\\hline\\frac{\\text{1}}{\\text{3}} & -\\frac{\\text{4}}{\\text{3}} & 0 & 0\\\\\\hline\\text{-1} & \\text{7.}\\times 10^{\\text{-1}} & 0 & 0\\\\\\hline\\frac{\\text{2}}{\\text{5}} & \\frac{\\text{2}}{\\text{5}} & 0 & 0\\\\\\hline &  &  & \\\\\\hline\\text{eps} & \\text{bra\\_eps vs N\\_eps (rel)} & \\text{|N\\_eps - B*| (normalised)} & \\\\\\hline\\frac{\\text{1}}{\\text{100}} & \\text{6.131}\\times 10^{\\text{-10}} & \\text{6.054}\\times 10^{\\text{-3}} & \\\\\\hline\\frac{\\text{1}}{\\text{1000}} & \\text{3.485}\\times 10^{\\text{-8}} & \\text{6.005}\\times 10^{\\text{-4}} & \\\\\\hline\\frac{\\text{1}}{\\text{10000}} & \\text{1.422}\\times 10^{\\text{-12}} & \\text{6.001}\\times 10^{\\text{-5}} & \\\\\\hline\\end{array}",
       "mime": "text/plain"
