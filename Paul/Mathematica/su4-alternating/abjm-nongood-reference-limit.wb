      {
       "data": "Out[1696]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{c12(measured) - c12(formula)} & 0 &  &  & \\\\\\hline\\text{reference} & \\text{(b): max|bra - expected|} & \\text{(b) product defect} & \\text{(a): max|bra - expected|} & \\text{(a) product defect}\\\\\\hline\\text{W\\_a\\^{}2} & 0 & 0.\\, & 0 & 0.\\,\\\\\\hline\\text{BPS identical pairs} & 0 & 0.\\, & 0 & 0.\\,\\\\\\hline\\end{array}",
