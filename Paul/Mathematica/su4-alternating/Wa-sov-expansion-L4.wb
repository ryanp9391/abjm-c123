   "kind": 2,
   "value": "wsBraYa = Expand[wsWaC[wsa] . wsYk];\nwsBraYn = Table[Coefficient[wsBraYa, wsa, n], {n, 0, 4}];\nwsTenRk[t_] := Module[{t4 = ArrayReshape[t, {4, 4, 4, 4}]}, {Count[t, Except[0]], Table[MatrixRank[Flatten[t4, {{s}, Complement[Range[4], {s}]}]], {s, 4}], MatrixRank[Flatten[t4, {{1, 2}, {3, 4}}]], MatrixRank[Flatten[t4, {{1, 3}, {2, 4}}]]}];\nwsBraYgen = (wsBraYa /. wsa -> 3/7);\nwsBraY0w = wsBra0y;\nwsDualRows = Join[Table[Join[{\"a^\" <> ToString[n], \"<vac|rho(E14)^n/n!|y>\"}, wsTenRk[wsBraYn[[n + 1]]]], {n, 0, 4}], {Join[{\"a = 3/7\", \"full <W_a|y>\"}, wsTenRk[wsBraYgen]], Join[{\"<0_w|y>\", \"twisted vacuum\"}, wsTenRk[wsBra0y]]}];\nwsBraYcharge = Table[Count[wsSupp[wsBraYn[[n + 1]]], x_ /; Total[wsLabels[[x]]] == d], {n, 0, 4}, {d, 0, 12}];\nColumn[{Grid[Prepend[wsDualRows, {\"object\", \"meaning\", \"# nonzero y\", \"site ranks (1 = product over sites)\", \"pair-cut rank (12)|(34)\", \"rank (13)|(24)\"}], Frame -> All, Alignment -> Left], Grid[Prepend[Table[Prepend[wsBraYcharge[[n + 1]], \"a^\" <> ToString[n]], {n, 0, 4}], Prepend[Range[0, 12], \"|y| ->\"]], Frame -> All]}]",
   "languageId": "wolfram",
