  {
   "kind": 2,
   "value": "wsTriples = Subsets[Range[4], {3}];\nwsZI[zz_, ii_] := Times @@ zz[[ii]];\nwsWd[zz_, qd_, ii_, u_, th_] := wsZI[zz, ii]^((u - th)/wsH) wsPe[qd[ii], u];\n(* dual (mirror) dictionary constants N0_{s,n}: tauTilde at site s, power/level n = N0 (det G)^n * (Q-form); calibrated on the vacuum of the given twist *)\nwsDualConsts[zz_] := Module[{qd = wsVacQ[zz][[1]], out = {}, tau = wsTauVac[zz], mm, D0, Dn, dG = Times @@ zz},\n  Do[If[wsTypes[[s]] == \"A\",\n    AppendTo[out, {s, 1, Table[tau[1, wsTh[[s]]] wsWd[zz, qd, t3, wsTh[[s]] - wsH, wsTh[[s]]]/wsWd[zz, qd, t3, wsTh[[s]] - 2 wsH, wsTh[[s]]]/dG, {t3, wsTriples}]}],\n    mm = Table[wsWd[zz, qd, wsTriples[[l]], wsTh[[s]] + (j - 1) wsH, wsTh[[s]]], {l, 3}, {j, 0, 3}];\n    D0 = Det[mm[[All, {2, 3, 4}]]];\n    Do[Dn = Det[mm[[All, Complement[Range[4], {n + 1}]]]]; AppendTo[out, {s, n, {tau[n, wsTh[[s]] + n wsH] D0/Dn/dG^n}}], {n, 1, 3}]], {s, 4}]; out];\nwsZ2 = {11/7, 5/3, 2/9, 13/5};\nwsDCt = AbsoluteTiming[{wsDCz = wsDualConsts[wsZ], wsDCw = wsDualConsts[wsWt], wsDC2 = wsDualConsts[wsZ2]}][[1]];\nwsDCtriples = Max[Table[Max[Abs[wsDCz[[k, 3]]/wsDCz[[k, 3, 1]] - 1]], {k, Length[wsDCz]}]];\nwsDCtwist = {wsDCz[[All, 3, 1]] == wsDCw[[All, 3, 1]], wsDCz[[All, 3, 1]] == wsDC2[[All, 3, 1]]};\nColumn[{Grid[{{\"time (s)\", wsDCt}, {\"A-site constants independent of the triple (max rel. spread)\", wsDCtriples}, {\"constants N0 = const/(det G)^n identical at twists z, w and z, w2 = (11/7,5/3,2/9,13/5) (exact)\", wsDCtwist}}, Frame -> All, Alignment -> Left],\n Grid[Prepend[Table[{wsDCz[[k, 1]], wsDCz[[k, 2]], wsDCz[[k, 3, 1]], wsDCw[[k, 3, 1]], wsDC2[[k, 3, 1]]}, {k, Length[wsDCz]}], {\"site s\", \"n (A: power 1; F: level n)\", \"N0 from vac(z)\", \"N0 from vac(w)\", \"N0 from vac(w2)\"}], Frame -> All, Alignment -> Left]}]",
   "languageId": "wolfram",
   "outputs": [
