       "data": "Out[278]= \\begin{matrix}\\begin{array}{|c|c|}\\hline\\text{time (s)} & 0.111791\\\\\\hline\\text{A-site constants independent of the triple (max rel. spread)} & 0\\\\\\hline\\text{constants N0 = const/(det G)\\^{}n identical at twists z, w and z, w2 = (11/7,5/3,2/9,13/5) (exact)} & \\left\\{\\mathrm{True},\\mathrm{True}\\right\\}\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|c|c|c|}\\hline\\text{site s} & \\text{n (A: power 1; F: level n)} & \\text{N0 from vac(z)} & \\text{N0 from vac(w)} & \\text{N0 from vac(w2)}\\\\\\hline1 & 1 & \\frac{25947}{603680} & \\frac{25947}{603680} & \\frac{25947}{603680}\\\\\\hline2 & 1 & -\\frac{459}{19250} & -\\frac{459}{19250} & -\\frac{459}{19250}\\\\\\hline2 & 2 & -\\frac{26625213}{5929000000} & -\\frac{26625213}{5929000000} & -\\frac{26625213}{5929000000}\\\\\\hline2 & 3 & -\\frac{1498387112001}{130438000000000} & -\\frac{1498387112001}{130438000000000} & -\\frac{1498387112001}{130438000000000}\\\\\\hline3 & 1 & \\frac{391645}{298144} & \\frac{391645}{298144} & \\frac{391645}{298144}\\\\\\hline4 & 1 & -\\frac{3589}{35840} & -\\frac{3589}{35840} & -\\frac{3589}{35840}\\\\\\hline4 & 2 & -\\frac{15407577}{7064780800} & -\\frac{15407577}{7064780800} & -\\frac{15407577}{7064780800}\\\\\\hline4 & 3 & \\frac{229218523029}{2785219182592000… [latex truncated: 1312 chars total]",
