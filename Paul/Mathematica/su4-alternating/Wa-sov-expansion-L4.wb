      {
       "data": "Out[85]= \\begin{array}{|c|c|}\\hline\\text{\\# weight blocks / \\# states} & \\left\\{55,256\\right\\}\\\\\\hline\\text{min gap of the combination spectrum (simple joint spectrum)} & 0.000021503\\\\\\hline\\text{max relative eigen-residual of t₁($\\theta$₂) on the companion kets} & 0.\\times 10^{-54}\\\\\\hline\\text{max\\_n max\\_x |⟨x|$\\Psi$⟩ − $\\tau$\\_x($\\Psi$)⟨0|$\\Psi$⟩| / max\\_x|⟨x|$\\Psi$⟩| (operator identity, round-off only)} & 1\\times 10^{-56}\\\\\\hline\\text{min |⟨0|$\\Psi$⟩|/‖$\\Psi$‖ over the 256 states} & 0.00034083\\\\\\hline\\end{array}",
