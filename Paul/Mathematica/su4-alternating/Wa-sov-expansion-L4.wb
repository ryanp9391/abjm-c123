  {
   "kind": 2,
   "value": "wsMob[zz_, w1_] := -((zz[[1]] - zz[[2]]) (zz[[1]] - zz[[3]]) (w1 - zz[[1]]))/((zz[[4]] - zz[[2]]) (zz[[4]] - zz[[3]]) (w1 - zz[[4]]));\nwsVdD[zz_, ww_] := Table[1/Product[If[m == j, 1, zz[[j]] - zz[[m]]], {m, 4}] Product[If[m == j, 1, ww[[1]] - zz[[m]]], {m, 4}], {j, 4}];\nwsUdD[zz_, ww_] := Table[Product[zz[[j]] - ww[[m]], {m, 3}], {j, 4}]/Product[ww[[4]] - ww[[m]], {m, 3}];\nwsMobSym = Module[{zs = Array[Symbol[\"wsZs\" <> ToString[#]] &, 4], ws1, ws4, vd, ud}, ws1 = Symbol[\"wsW1s\"]; ws4 = Symbol[\"wsW4s\"]; vd = wsVdD[zs, {ws1, zs[[2]], zs[[3]], ws4}]; ud = wsUdD[zs, {ws1, zs[[2]], zs[[3]], ws4}];\n  {Simplify[vd[[4]]/vd[[1]] - wsMob[zs, ws1]], Simplify[-ud[[1]]/ud[[4]] - wsMob[zs, ws1]], ud[[2]], ud[[3]], Simplify[vd[[1]] ud[[1]] + vd[[4]] ud[[4]]]}];\nwsMobLim = {wsMob[wsZ, wsZ[[1]]], Quiet[wsMob[wsZ, wsZ[[4]]]], Limit[wsMob[wsZ, x], x -> wsZ[[4]], Direction -> \"FromAbove\"], Limit[wsMob[wsZ, x], x -> Infinity]};\nGrid[{{\"a = v4/v1 minus Moebius map (symbolic)\", wsMobSym[[1]]}, {\"-u1/u4 minus Moebius map (symbolic)\", wsMobSym[[2]]}, {\"u2, u3 (must vanish)\", wsMobSym[[3 ;; 4]]}, {\"BPS: v.u = v1u1 + v4u4 (u2=u3=0) = 0\", wsMobSym[[5]]}, {\"a(w1=z1), a(w1=z4), limit w1->z4+, limit w1->infinity\", wsMobLim}}, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"725116\" data-output-id=\"69\" data-out-n=\"410\" data-sub-idx=\"5\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"31\" data-sub-start=\"6\" data-sub-end=\"6\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[410]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"15\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:6.05em;vertical-align:-2.755em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.295em;\"><span style=\"top:-5.255em;\"><span class=\"pstrut\" style=\"height:5.255em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:6.01em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-2.755em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.255em;\"><span style=\"top:-5.415em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">a = v4/v1 minus Moebius map (symbolic)</span></span></span></span><span style=\"top:-4.215em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">-u1/u4 minus Moebius map (symbolic)</span></span></span></span><span style=\"top:-3.015em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">u2, u3 (must vanish)</span></span></span></span><span sty