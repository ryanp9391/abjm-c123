  {
   "kind": 2,
   "value": "wsNAc[s_] := wsDCz[[Position[wsDCz[[All, 1]], s][[1, 1]], 3, 1]];\nwsNFc[s_, n_] := wsDCz[[Select[Range[Length[wsDCz]], wsDCz[[#, 1]] == s && wsDCz[[#, 2]] == n &][[1]], 3, 1]];\n(* mirror dictionary: A site: tauTilde(m) = (detG N0_A w_I(th-2h)/w_I(th-h))^m ; F site: tauTilde(n) = (detG)^n N0_{F,n} det[w_I(th+(j-1)h)]_{j!=n}/det[...]_{j=1,2,3} *)\nwsDualSite[zz_, qd_, s_, n_] := Module[{th = wsTh[[s]], mm, dG = Times @@ zz},\n  If[n == 0, 1, If[wsTypes[[s]] == \"A\", (dG wsNAc[s] wsWd[zz, qd, wsTriples[[1]], th - 2 wsH, th]/wsWd[zz, qd, wsTriples[[1]], th - wsH, th])^n,\n    mm = Table[wsWd[zz, qd, wsTriples[[l]], th + (j - 1) wsH, th], {l, 3}, {j, 0, 3}];\n    dG^n wsNFc[s, n] Det[mm[[All, Complement[Range[4], {n + 1}]]]]/Det[mm[[All, {2, 3, 4}]]]]]];\nwsTauYQ[zz_] := Module[{qd = wsVacQ[zz][[1]], tab},\n  tab = Table[wsDualSite[zz, qd, s, n], {s, 4}, {n, 0, 3}];\n  Table[Product[tab[[s, y[[s]] + 1]], {s, 4}], {y, wsLabels}]];\nwsTYQw = wsTauYQ[wsWt]; wsTYQ2 = wsTauYQ[wsZ2]; wsTYQz = wsTauYQ[wsZ];\nwsMirrorErr = {Max[Abs[wsTYQw/(wsTauYvac[wsWt] /@ wsLabels) - 1]], Max[Abs[wsTYQ2/(wsTauYvac[wsZ2] /@ wsLabels) - 1]], Max[Abs[wsTYQz/(wsTauYvac[wsZ] /@ wsLabels) - 1]]};\nGrid[{{\"mirror (dual-Q) dictionary with N0 calibrated on vac(z): max_y |tauTilde_y(Q-form)/tauTilde_y(eigenvalue) - 1| at twist w, w2 = (11/7,5/3,2/9,13/5), z (exact)\", wsMirrorErr}}, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
