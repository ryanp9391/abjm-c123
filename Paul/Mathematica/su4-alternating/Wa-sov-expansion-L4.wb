      {
       "data": "Out[111]= \\begin{matrix}\\begin{array}{|c|c|}\\hline\\text{\\# words with c\\_x(a) $\\not=$ 0 (symbolic a)} & 256\\\\\\hline\\text{exponents of a occurring in c\\_x(a): tally over x} & \\begin{pmatrix}\\left\\{0,1,2,3,4\\right\\} & 256\\end{pmatrix}\\\\\\hline\\text{z-scaling c\\_x(a; $\\kappa$z) = $\\kappa$\\^{}\\{6−|x|\\} c\\_x(a; z) at $\\kappa$ = 2/3 (symbolic a, exact)} & \\mathrm{True}\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|c|c|c|c|c|c|}\\hline\\text{component} & \\text{meaning} & \\text{\\# words} & \\text{pair-cut rank (12)|(34)} & \\text{site ranks} & \\text{rank (13)|(24)} & \\text{support by charge |x| = 0..12} & \\text{rank of m(r₂,r₄): two generic points, symbolic}\\\\\\hline\\text{a\\^{}0} & \\text{⟨vac|$\\rho$(E₁₄)\\^{}0/0!} & 256 & 11 & \\left\\{4,4,4,4\\right\\} & 4 & \\left\\{1,4,10,20,31,40,44,40,31,20,10,4,1\\right\\} & \\left\\{2,2,2\\right\\}\\\\\\hline\\text{a\\^{}1} & \\text{⟨vac|$\\rho$(E₁₄)\\^{}1/1!} & 256 & 13 & \\left\\{4,4,4,4\\right\\} & 12 & \\left\\{1,4,10,20,31,40,44,40,31,20,10,4,1\\right\\} & \\left\\{2,2,2\\right\\}\\\\\\hline\\text{a\\^{}2} & \\text{⟨vac|$\\rho$(E₁₄)\\^{}2/2!} & 256 & 16 & \\left\\{4,4,4,4\\right\\} & 16 & \\left\\{1,4,10,20,31,40,44,40,31,20,10,4,1\\right\\} & \\left\\{4,4,4\\right\\}\\\\\\hline\\text{a\\^{}3} & \\text{⟨vac|$\\rho$(E₁₄)\\^{}3/… [latex truncated: 1676 chars total]",
