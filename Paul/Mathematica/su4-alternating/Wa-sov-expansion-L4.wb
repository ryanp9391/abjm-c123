      {
       "data": "Out[499]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{eps} & \\text{\\# states with |C\\_direct| > 0.05} & \\text{|C\\_direct| = |K w/N|} & \\text{|C\\_Q| = |K w\\_Q/N|} & \\text{|w - w\\_Q|/|w|}\\\\\\hline\\frac{1}{100} & 16 & \\left\\{0.12063320,0.11930823,0.078098097,0.12768432,0.14528281,0.29427081,0.10820318,0.10820318,0.085494360,0.085494360,0.18262540,0.18262540,0.21945618,0.21945618,0.15795661,0.20390188\\right\\} & \\left\\{0.12063320,0.11930823,0.078098097,0.12768432,0.14528281,0.29427081,0.10820318,0.10820318,0.085494360,0.085494360,0.18262540,0.18262540,0.21945618,0.21945618,0.15795661,0.20390188\\right\\} & \\left\\{0.\\times 10^{-76},0.\\times 10^{-74},0.\\times 10^{-74},0.\\times 10^{-75},0.\\times 10^{-75},0.\\times 10^{-75},0.\\times 10^{-81},0.\\times 10^{-81},0.\\times 10^{-80},0.\\times 10^{-80},0.\\times 10^{-80},0.\\times 10^{-80},0.\\times 10^{-79},0.\\times 10^{-79},0.\\times 10^{-73},0.\\times 10^{-74}\\right\\}\\\\\\hline\\frac{1}{200} & 16 & \\left\\{0.12029468,0.11920000,0.078370826,0.12835435,0.14591399,0.29447000,0.10868753,0.10868753,0.085930199,0.085930199,0.18279349,0.18279349,0.21952633,0.21952633,0.15803504,0.20401756\\right\\} & \\left\\{0.12029468,0.11920000,0.078370826,0.12835435,0.14591399,0.29447000,0.1086875… [latex truncated: 3080 chars total]",
