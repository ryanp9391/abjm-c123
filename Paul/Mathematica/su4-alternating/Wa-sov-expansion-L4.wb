  {
   "kind": 2,
   "value": "wsQt[zz_, qd_, i_, th_, j_] := zz[[i]]^(-j) Product[wsVvac[4, th - b wsH], {b, j, 4}] wsPe[qd[{i}], th - j wsH];\nwsSiteQF[zz_, qd_, s_, lab_, j_] := (wsQt[zz, qd, j, wsTh[[s]], 0]/wsQt[zz, qd, j, wsTh[[s]], 1])^lab;\nwsSiteQA[zz_, qd_, s_, lab_, tri_] := Module[{th = wsTh[[s]], D}, D = Function[pts, Det[Table[wsQt[zz, qd, i, th, jj], {i, tri}, {jj, pts}]]]; D[Complement[{1, 2, 3, 4}, {lab + 1}]]/D[{2, 3, 4}]];\nwsBraDictErr[zz_] := Module[{qd = wsVacQ[zz][[1]], tau = wsTauVac[zz], eF, eA},\n  eF = Max[Table[Abs[wsSiteQF[zz, qd, s, lab, j]/tau[1, wsTh[[s]]]^lab - 1], {s, {2, 4}}, {lab, 0, 3}, {j, 4}]];\n  eA = Max[Table[Abs[wsSiteQA[zz, qd, s, lab, tri]/tau[lab, wsTh[[s]] - wsH] - 1], {s, {1, 3}}, {lab, 0, 3}, {tri, wsTriples}]];\n  {eF, eA}];\nGrid[{{\"bra-side dictionary on the vacuum Q's of twist w: F: tau_1(th_F)^k = (Qt_j(th_F)/Qt_j(th_F - h))^k (all j), A: tau_a(th_A - h) = D_a/D_0 (all 4 triples); max rel. error (F, A) [exact]\", wsBraDictErr[wsWt]}, {\"same at twist z\", wsBraDictErr[wsZ]}}, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
