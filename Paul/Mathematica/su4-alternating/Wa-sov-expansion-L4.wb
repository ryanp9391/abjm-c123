  {
   "kind": 2,
   "value": "wsvw = wsVand[wsWt][[All, 1]]; wsuw = Inverse[wsVand[wsWt]][[4]];\nwsV0w = wsProd4[wsvw, wsuw, wsvw, wsuw];\nwsVvac[i_, u_] := Which[i == 1, (u - wsTh[[1]] + wsH) (u - wsTh[[2]]) (u - wsTh[[3]] + wsH) (u - wsTh[[4]]), i == 2 || i == 3, Times @@ (u - wsTh), True, (u - wsTh[[1]]) (u - wsTh[[2]] - wsH) (u - wsTh[[3]]) (u - wsTh[[4]] - wsH)];\nwsTauVac[zz_][a_, u_] := If[a == 0, 1, Sum[Product[zz[[idx[[k]]]] wsVvac[idx[[k]], u - (k - 1) wsH], {k, a}], {idx, Subsets[Range[4], {a}]}]];\nwsBraEv[bra_, op_] := Module[{p = LengthWhile[bra, # === 0 &] + 1, r}, r = bra . op; {r[[p]]/bra[[p]], r == (r[[p]]/bra[[p]]) bra}];\nwsEvTest = Table[With[{r = wsBraEv[wsV0w, wsT[wsGcw, a, u]]}, {a, u, r[[2]], r[[1]] == wsTauVac[wsWt][a, u]}], {a, 3}, {u, {3/10, -7/10, 5/9}}];\nwsBra0y = wsV0w . wsYk;\nwsTauYvac[zz_][y_] := Product[If[y[[s]] == 0, 1, If[wsTypes[[s]] == \"A\", wsTauVac[zz][1, wsTh[[s]]]^y[[s]], wsTauVac[zz][y[[s]], wsTh[[s]] + y[[s]] wsH]]], {s, 4}];\nwsFactErr = Max[Table[Abs[wsBra0y[[j]]/(wsBra0y[[1]] wsTauYvac[wsWt][wsLabels[[j]]]) - 1], {j, 256}]];\nwsCw = wsBra0y . wsM;\nwsCompl = (SparseArray[wsCw] . wsW == wsV0w);\nGrid[{{\"<0_w| eigenbra of t_a^{Gc(w)}(u): proportional (True) and eigenvalue = sum_I prod z_i V_i(u-(k-1)h) (True), a=1,2,3 x u={3/10,-7/10,5/9}\", wsEvTest[[All, All, {3, 4}]]},\n {\"max_y |<0_w|y>/(<0_w|0bar> tauTilde_y(vac_w)) - 1| (exact: 0)\", wsFactErr},\n {\"<0_w| = sum_x (sum_y <0_w|y> M_yx) <x|  (exact)\", wsCompl},\n {\"# nonzero words in the SoV expansion of <0_w|\", wsNZ[wsCw]},\n {\"<0_w|0bar>\", wsBra0y[[1]]}}, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"725116\" data-output-id=\"32\" data-out-n=\"130\" data-sub-idx=\"11\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"13\" data-sub-start=\"11\" data-sub-end=\"15\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[130]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"15\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:8.4451em;vertical-align:-3.9526em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.4926em;\"><span style=\"top:-6.4526em;\"><span class=\"pstrut\" style=\"height:6.4526em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:8.4051em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-3.9526em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.4526em;\"><span style=\"top:-6.4526em;\"><span class=\"pstrut\" style=\"height:4.05em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">&lt;0_w| eigenbra of t_a</span><span class=\"mord accent\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.6944em;\"><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"></span></span><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"accent-body\" style=\"left:-0.25em;\"><span class=\"mord\">ˆ</span></span></span></span></span></span></span><span class=\"mord\">{Gc(w)}(u): proportional (True) and eigenvalue = sum_I prod z_i V_i(u-(k-1)h) (True), a=1,2,3 x u={3/10,-7/10,5/9}</span></span></span></span><span style=\"top:-4.0625em;\"><span class=\"pstrut\" style=\"height:4.05em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">max_y |&lt;0_w|y&gt;/(&lt;0_w|0bar&gt; tauTilde_y(vac_w)) - 1| (exact: 0)</span></span></span></span><span style=\"top:-2.8625em;\"><span class=\"pstrut\" style=\"height:4.05em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">&lt;0_w| = sum_x (sum_y &lt;0_w|y&gt; M_yx) &lt;x| (exact)</span></span></span></span><span style=\"top:-1.6625em;\"><span class=\"pstrut\" style=\"height:4.05em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\"># nonzero words in the SoV expansion of &lt;0_w|</span></span></span></span><span style=\"top:-0.4574em;\"><span class=\"pstrut\" style=\"height:4.05em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">&lt;0_w|0bar&gt;</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.9526em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:8.4051em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-3.9526em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.4526em;\"><span style=\"top:-6.4526em;\"><span class=\"pstrut\" style=\"height:4.05em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen\"><span class=\"delimsizing mult\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.05em;\"><span style=\"top:-4.05em;\"><span class=\"pstrut\" 