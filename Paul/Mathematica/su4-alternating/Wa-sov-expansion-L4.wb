       "data": "Out[404]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{weight sector} & \\text{\\# states} & \\text{max |<0\\_w|Psi> - (v1 u4)\\^{}2 <W\\_a|Psi>|} & \\text{max |<0\\_w|Psi>|} & \\text{max |(v1u4)\\^{}2 <W\\_a|Psi>|}\\\\\\hline\\left\\{2,0,0,-2\\right\\} & 1 & 0.\\times 10^{-41} & 0.1499123473531549078315947431837788877667 & 0.1499123473531549078315947431837788877667\\\\\\hline\\left\\{1,0,0,-1\\right\\} & 12 & 0.\\times 10^{-41} & 0.07337133832963645711547970582525365520580 & 0.07337133832963645711547970582525365520580\\\\\\hline\\left\\{0,0,0,0\\right\\} & 28 & 0.\\times 10^{-41} & 0.03251525180482127003073111551472600844570 & 0.03251525180482127003073111551472600844570\\\\\\hline\\left\\{-1,0,0,1\\right\\} & 12 & 0.\\times 10^{-42} & 0.01136685805853821838080954458797751179341 & 0.01136685805853821838080954458797751179341\\\\\\hline\\left\\{-2,0,0,2\\right\\} & 1 & 0.\\times 10^{-42} & 0.003435006463688727819958809946255148132406 & 0.003435006463688727819958809946255148132406\\\\\\hline\\left\\{1,1,-1,-1\\right\\} & 4 & 0 & 0 & 0\\\\\\hline\\left\\{0,1,0,-1\\right\\} & 12 & 0.1252632381946202148854860464778683804648 & 0.1252632381946202148854860464778683804648 & 0\\\\\\hline\\end{array}",
