  {
   "kind": 2,
   "value": "wsMn60 = N[wsM, 60];\nwsWvec = N[wsTYQw, 60] . wsMn60;                       (* row vector over x: sum_y tauTilde_y(vac_w) M_yx *)\nwsWform = Table[wsWvec . wsTauX[[All, n]], {n, 256}];\nwsWdirect = Table[(wsV0w . wsPsiC[[All, n]])/(wsBra0y[[1]] wsOv0[[n]]), {n, 256}];\nwsWerr = Max[Abs[wsWform/wsWdirect - 1]];\nwsWvecZ = N[wsTYQz, 60] . wsMn60;\nwsWz = Table[wsWvecZ . wsTauX[[All, n]], {n, 256}];\nwsBiorth = Max[Abs[Delete[wsWz, wsVacIdx]]]/Abs[wsWz[[wsVacIdx]]];\nwsB0z = wsProd4[wsvz[1], wsut[4], wsvz[1], wsut[4]];\nwsWzDirect = (wsB0z . wsPsiC[[All, wsVacIdx]])/((wsB0z . wsYk[[All, 1]]) wsOv0[[wsVacIdx]]);\nGrid[{{\"W_w(Psi) := <0_w|Psi_z>/(<0_w|0bar><0|Psi_z>): max_n |sum_{x,y} tauTilde_y(Q-form of vac_w) M_yx tau_x(Psi_n) / direct - 1|  [hp 60 digits, 256 states]\", N[wsWerr, 3]},\n  {\"min_n |W_w(Psi_n)| (all 256 nonzero)\", N[Min[Abs[wsWdirect]], 5]},\n  {\"biorthogonality w = z: max_{n != vac} |W_z(Psi_n)| / |W_z(vac)| (finite Q-sum must vanish)\", N[wsBiorth, 3]},\n  {\"W_z(vac): Q-sum vs direct\", {N[wsWz[[wsVacIdx]], 12], N[wsWzDirect, 12]}}}, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
