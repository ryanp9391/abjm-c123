       "data": "Out[402]= \\begin{matrix}\\begin{array}{|c|c|c|c|}\\hline\\text{n} & \\text{u} & \\text{proportional to <bra|t\\_1\\^{}\\{Gc(z)\\}(u)} & \\text{eigenvalue = vacuum formula (z for n=0, (z4,z2,z3,z1) for n=4)}\\\\\\hline0 & \\frac{3}{10} & \\mathrm{True} & \\mathrm{True}\\\\\\hline0 & -\\frac{7}{10} & \\mathrm{True} & \\mathrm{True}\\\\\\hline4 & \\frac{3}{10} & \\mathrm{True} & \\mathrm{True}\\\\\\hline4 & -\\frac{7}{10} & \\mathrm{True} & \\mathrm{True}\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|}\\hline\\text{\\# states with <W\\_a|Psi> != 0 (a = 3/7)} & 54\\\\\\hline\\text{G/(P1 P2): min, max |.| over those states} & \\left\\{1.0177\\times 10^{-6},10.015\\right\\}\\\\\\hline\\text{least squares G = c1 P1 + c2 P2 + c0: relative residual} & 0.7933\\\\\\hline\\end{array}\\end{matrix}",
