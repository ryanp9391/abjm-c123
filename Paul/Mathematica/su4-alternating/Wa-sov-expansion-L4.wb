       "data": "Out[484]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{theta} & \\text{\\# states checked} & \\text{max rel. deviation direct vs closed form} & \\text{max eigen-residual of t1(theta2)} & \\text{max |<W\\_a|Psi>|}\\\\\\hline\\text{ABJM pair-by-pair (2/5,-3/5,-3/8,-11/8)} & 54 & 0.\\times 10^{-52} & 0.\\times 10^{-60} & 1.\\,\\\\\\hline\\text{generic standard theta} & 54 & 0.\\times 10^{-54} & 0.\\times 10^{-59} & 1.\\,\\\\\\hline\\end{array}",
