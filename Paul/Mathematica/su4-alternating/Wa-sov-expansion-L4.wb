      {
       "data": "Out[505]= \\begin{array}{|c|c|c|c|}\\hline\\text{a} & \\text{a(w1) == a} & \\text{omega1 = (w1-1)/eps} & \\text{max\\_28 |(v1u4)\\^{}-2 <0\\_w|Psi> - <W\\_a|Psi>|/|<W\\_a|Psi>|}\\\\\\hline\\frac{3}{10} & \\mathrm{True} & -\\frac{4433}{6030} & 0.\\times 10^{-84}\\\\\\hline\\frac{3}{10} & \\mathrm{True} & -\\frac{4433}{6030} & 0.\\times 10^{-83}\\\\\\hline\\end{array}",
