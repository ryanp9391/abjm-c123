  {
   "kind": 2,
   "value": "rootsOf[p_] := If[Exponent[p, x] == 0, {}, SortBy[x /. NSolve[p == 0, x], {Re, Im}]];\n(* LR test: Q1(u) ∝ Q123(u + c)?  c from the root means; residual = max distance after the shift *)\nlrTest[q1_, q123_] := Module[{r1 = rootsOf[q1], r3 = rootsOf[q123], c},\n   Which[Length[r1] != Length[r3], {\"degrees differ\", Infinity},\n    Length[r1] == 0, {0, 0.},\n    True, c = Mean[r3] - Mean[r1]; {Chop[c, 10^-8], Max[Table[Min[Abs[r1 - (s - c)]], {s, r3}]]}]];\nqRow[st_, tc_, L_, vq_] := Module[{qf = qfunctions[tc, L, vq], K = Ks[st[\"dyn\"], L], lr, degQ},\n   lr = lrTest[qf[\"Q1\"], qf[\"Q123\"]];\n   degQ = Map[Exponent[#, x] &, {qf[\"Q1\"], qf[\"Q12\"], qf[\"Q123\"]}];\n   <|\"dyn\" -> st[\"dyn\"], \"E\" -> st[\"E\"], \"K\" -> K, \"degQ\" -> degQ, \"rem\" -> qf[\"rem\"],\n    \"Q1\" -> qf[\"Q1\"], \"Q12\" -> qf[\"Q12\"], \"Q123\" -> qf[\"Q123\"], \"roots\" -> Map[rootsOf, {qf[\"Q1\"], qf[\"Q12\"], qf[\"Q123\"]}],\n    \"shift\" -> lr[[1]], \"LRres\" -> lr[[2]], \"dLR\" -> st[\"LR\"], \"C\" -> st[\"C\"]|>];\nqTable[rows_] := Grid[Prepend[{#dyn, NumberForm[Chop[#E, 10^-8], 5], #K, #degQ, ScientificForm[#rem, 2], ScientificForm[#dLR, 2], #shift, ScientificForm[#LRres, 2], Map[NumberForm[Chop[#, 10^-8], 4] &, #roots, {2}]} & /@ rows,\n    {\"Dynkin\", \"E\", \"K₁,K₂,K₃\", \"deg Q₁,Q₁₂,Q₁₂₃\", \"Cas remainder\", \"δ_LR (τ)\", \"c\", \"Q₁ vs Q₁₂₃(u+c)\", \"roots of Q₁ | Q₁₂ | Q₁₂₃\"}], Frame -> All, Alignment -> Left];\nqRows[2] = MapThread[qRow[#1, #2, 2, vacQ[2]] &, {states[\"L2\"], tc2}];\nIf[!ValueQ[tc3], tc3 = tauPolys[6, states[\"L3\"]]]; vacQ[3] = solveQs[tc3[[1]], 3, 18];\nqRows[3] = MapThread[qRow[#1, #2, 3, vacQ[3]] &, {states[\"L3\"], tc3}];\nqTable[qRows[2]]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
