  {
   "kind": 1,
   "value": "### L = 4 pairs: τ̄ polynomials in parallel (8 subkernels), saved to `data/abjm-tau-L4.wxf`",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "tauOne[LL_, psi0_] := Module[{pts = N[3 Cos[Pi (Range[0, LL] + 1/2)/(LL + 1)]] + 0.1234, vand, psi, p},\n   psi = If[Max[Abs[Im[psi0]]] < 10^-14, Developer`ToPackedArray[Re[N[psi0]]], Developer`ToPackedArray[N[psi0] + 0. I]];\n   p = Ordering[Abs[psi], -1][[1]];\n   vand = Table[pt^k, {pt, pts}, {k, 0, LL}];\n   Table[LinearSolve[vand, Table[op[pt, psi][[p]]/psi[[p]], {pt, pts}]], {op, {t1b[LL], t2b[LL], t3b[LL]}}]];\nDistributeDefinitions[tauOne, t1b, t2b, t3b, transferV, applySite, lax1, lax2, lax3, wedgeOp, DwE, rho, ee, id4, nn, hh, thA, thF, thAB, typesOf, subs2];\ntauFile4 = FileNameJoin[{DirectoryName[dataFile], \"abjm-tau-L4.wxf\"}];\n{timeTau4, tc4} = AbsoluteTiming[ParallelMap[tauOne[8, Normal[#[\"psi\"]]] &, states[\"L4\"], Method -> \"FinestGrained\"]];\nExport[tauFile4, <|\"description\" -> \"tau-bar_a(u), a = 1, 2, 3, coefficient lists (u^0..u^8) for states[L4] of abjm-hw-states.wxf, same order; abjm-Qfunctions.wb\", \"tc\" -> tc4|>, \"WXF\"];\nGrid[{{\"time (s)\", timeTau4}, {\"# states\", Length[tc4]}, {\"leading coefficients (should be 4, 6, 4)\", Union[Round[tc4[[All, All, -1]], 10.^-8]]}, {\"saved\", tauFile4}}, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
