em;\"><span></span></span></span></span></span></span></span></span></span></div></div></div></div>\n<div style=\"margin-top:3px;padding:2px 8px;display:flex;align-items:center;gap:6px;border-left:2px solid rgba(128,128,128,0.3);\"\n     data-truncated-uuid=\"56\" data-session-epoch=\"825950\">\n  <span style=\"font-size:11px;color:var(--vscode-descriptionForeground,#888);flex:1;\">&#128230; Large output &#8212; 1,176 atoms (skeleton shown, full value in kernel)</span>\n  <button data-action=\"expand\" style=\"padding:1px 6px;font-size:12px;cursor:pointer;line-height:1.5;background:transparent;border:1px solid rgba(128,128,128,0.3);border-radius:3px;color:var(--vscode-foreground,inherit);\" title=\"Show full output\">&#9654;</button>\n  <button data-action=\"expand-more\" style=\"padding:1px 6px;font-size:12px;cursor:pointer;line-height:1.5;background:transparent;border:1px solid rgba(128,128,128,0.3);border-radius:3px;color:var(--vscode-foreground,inherit);\" title=\"Show +20 more lines\">&#43;&#8230;</button>\n  <button data-action=\"open-text\" style=\"padding:1px 6px;font-size:12px;cursor:pointer;line-height:1.5;background:transparent;border:1px solid rgba(128,128,128,0.3);border-radius:3px;color:var(--vscode-foreground,inherit);\" title=\"Open as text file\">&#128196;</button>\n</div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[580]= \\begin{array}{|c|c|c|c|c|c|c|c|}\\hline\\text{Dynkin} & \\text{E} & \\text{K₁,K₂,K₃} & \\text{deg Q₁,Q₁₂,Q₁₂₃} & \\text{$\\delta$\\_LR ($\\tau$)} & \\text{c} & \\text{Q₁ vs Q₁₂₃(u+c)} & \\text{roots of Q₁ | Q₁₂ | Q₁₂₃}\\\\\\hline\\left\\{3,0,3\\right\\} & \\text{0} & \\left\\{0,0,0\\right\\} & 0 & \\text{1.4}\\times 10^{\\text{-16}} & 0 & \\text{0.} & \\left\\{\\{\\},\\{\\},\\{\\}\\right\\}\\\\\\hline\\left\\{4,0,0\\right\\} & \\text{12.} & \\left\\{0,1,2\\right\\} & 0 & \\text{8.}\\times 10^{\\text{-1}} & \\text{degrees differ} & \\infty  & \\left\\{\\left\\{\\text{0.25}-\\text{0.1443}\\,\\mathrm{i},\\text{0.25}+\\text{0.1443}\\,\\mathrm{i}\\right\\},\\left\\{\\text{0.5}\\right\\},\\{\\}\\right\\}\\\\\\hline\\left\\{1,2,1\\right\\} & \\text{12.} & \\left\\{1,0,1\\right\\} & 1 & \\text{1.9} & 3.350000000000032 -3.3443375672973987\\,\\mathrm{i} & \\text{2.2}\\times 10^{\\text{-16}} & \\left\\{\\left\\{\\text{0.25}+\\text{0.1443}\\,\\mathrm{i}\\right\\},\\{\\},\\left\\{\\text{3.6}-\\text{3.2}\\,\\mathrm{i}\\right\\}\\right\\}\\\\\\hline\\left\\{1,2,1\\right\\} & \\text{12.} & \\left\\{1,0,1\\right\\} & 1 & \\text{1.9} & 3.350000000000032 +3.3443375672973987\\,\\mathrm{i} & \\text{2.2}\\times 10^{\\text{-16}} & \\left\\{\\left\\{\\text{0.25}-\\text{0.1443}\\,\\mathrm{i}\\right\\},\\{\\},\\left\\{\\text{3.6}+\\text{3.2}\\,\\mathrm{i}\\ri… [latex truncated: 9660 chars total]",
       "mime": "text/plain"
