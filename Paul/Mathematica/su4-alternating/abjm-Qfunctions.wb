      {
       "data": "Out[705]= \\begin{array}{|c|c|}\\hline\\text{saved} & \\text{c:\\\\Users\\\\pryan\\\\git-projects\\\\abjm-c123\\\\Paul\\\\Mathematica\\\\su4-alternating\\\\data\\\\abjm-tau.wxf}\\\\\\hline\\text{\\# states} & \\left\\{6,26,152\\right\\}\\\\\\hline\\end{array}",
