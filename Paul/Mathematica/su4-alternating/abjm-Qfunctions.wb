  {
   "kind": 2,
   "value": "(* save the tau-bar polynomials of all lengths in one file (L = 4 also in abjm-tau-L4.wxf) *)\ntauFileAll = FileNameJoin[{DirectoryName[dataFile], \"abjm-tau.wxf\"}];\nExport[tauFileAll, <|\"description\" -> \"tau-bar_a(u), a = 1, 2, 3 (reduced transfer matrices of abjm-chain.wb, ABJM point theta_A = 2h, theta_F = 0, untwisted), coefficient lists u^0..u^(2L) for the states of abjm-hw-states.wxf, same order. abjm-Qfunctions.wb.\", \"L2\" -> tc2, \"L3\" -> tc3, \"L4\" -> tc4|>, \"WXF\"];\nGrid[{{\"saved\", tauFileAll}, {\"# states\", Length /@ {tc2, tc3, tc4}}}, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"825950\" data-output-id=\"71\" data-out-n=\"705\" data-sub-idx=\"3\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"19\" data-sub-start=\"3\" data-sub-end=\"3\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[705]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"15\" data-latex-b64=\"XGJlZ2lue2FycmF5fXt8Y3xjfH1caGxpbmVcdGV4dHtzYXZlZH0gJiBcdGV4dHtjOlxcVXNlcnNcXHByeWFuXFxnaXQtcHJvamVjdHNcXGFiam0tYzEyM1xcUGF1bFxcTWF0aGVtYXRpY2FcXHN1NC1hbHRlcm5hdGluZ1xcZGF0YVxcYWJqbS10YXUud3hmfVxcXGhsaW5lXHRleHR7XCMgc3RhdGVzfSAmIFxsZWZ0XHs2LDI2LDE1MlxyaWdodFx9XFxcaGxpbmVcZW5ke2FycmF5fQ==\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:2.44em;vertical-align:-0.95em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.49em;\"><span style=\"top:-3.45em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:2.4em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-0.95em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.45em;\"><span style=\"top:-3.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">saved</span></span></span></span><span style=\"top:-2.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\"># states</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.95em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:2.4em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-0.95em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.45em;\"><span style=\"top:-3.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">c:</span><span class=\"mspace newline\"></span><span class=\"mord\">Users</span><span class=\"mspace newline\"></span><span class=\"mord\">pryan</span><span class=\"mspace newline\"></span><span class=\"mord\">git-projects</span><span class=\"mspace newline\"></span><span class=\"mord\">abjm-c123</span><span class=\"mspace newline\"></span><span class=\"mord\">Paul</span><span class=\"mspace newline\"></span><span class=\"mord\">Mathematica</span><span class=\"mspace newline\"></span><span class=\"mord\">su4-alternating</span><span class=\"mspace newline\"></span><span class=\"mord\">data</span><span class=\"mspace newline\"></span><span class=\"mord\">abjm-tau.wxf</span></span></span></span><span style=\"top:-2.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">6</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">26</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">152</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.95em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:2.4em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-0.95em;\"></span></span></span><span style=\"top:-2.5em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.7em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-4.9em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.95em;\"><span></span></span></span></span></span></span></span></span></span></div></div></div>",
