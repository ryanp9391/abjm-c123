      {
       "data": "Out[625]= \\begin{array}{|c|c|c|c|c|c|}\\hline\\text{L} & \\text{\\# states} & \\text{\\# with deg(Q₁, Q₁₂, Q₁₂₃) = (K₁, K₂, K₃)} & \\text{max Casoratian remainder} &  & \\\\\\hline2 & 6 & 6 & 2.2544840246164823\\times 10^{-13} &  & \\\\\\hline3 & 26 & 18 & 8.912870441698475\\times 10^{-13} &  & \\\\\\hline4 & 152 & 92 & 8.180362351437267\\times 10^{-12} &  & \\\\\\hline &  &  &  &  & \\\\\\hline\\text{L} & \\text{\\# states} & \\text{\\# LR by $\\tau$} & \\text{\\# LR by Q} & \\text{\\# $\\tau$ and Q agree} & \\text{\\# with LR partner}\\\\\\hline2 & 6 & 4 & 4 & 6 & 6\\\\\\hline3 & 26 & 8 & 8 & 26 & 26\\\\\\hline4 & 152 & 24 & 24 & 152 & 152\\\\\\hline\\text{saved} & \\text{c:\\\\Users\\\\pryan\\\\git-projects\\\\abjm-c123\\\\Paul\\\\Mathematica\\\\su4-alternating\\\\data\\\\abjm-Qfunctions.wxf} &  &  &  & \\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "03088981-68e3-46ef-9002-a09933134b71"
    }
