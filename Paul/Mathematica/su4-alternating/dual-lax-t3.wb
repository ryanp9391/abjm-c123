       "data": "Out[287]= \\begin{array}{|c|c|c|c|}\\hline\\text{L sites} & \\text{twist} & \\text{t₂ = $\\prod$g$\\cdot$tr[T⁽²⁾ $\\land$²G] at u = 37/100} & \\text{at u = −6/5}\\\\\\hline2 & \\text{companion G\\_c(z)} & \\mathrm{True} & \\mathrm{True}\\\\\\hline2 & \\text{diagonal z} & \\mathrm{True} & \\mathrm{True}\\\\\\hline2 & \\text{generic G} & \\mathrm{True} & \\mathrm{True}\\\\\\hline2 & \\text{untwisted} & \\mathrm{True} & \\mathrm{True}\\\\\\hline4 & \\text{companion G\\_c(z)} & \\mathrm{True} & \\mathrm{True}\\\\\\hline4 & \\text{diagonal z} & \\mathrm{True} & \\mathrm{True}\\\\\\hline4 & \\text{generic G} & \\mathrm{True} & \\mathrm{True}\\\\\\hline4 & \\text{untwisted} & \\mathrm{True} & \\mathrm{True}\\\\\\hline\\text{L = 4} & \\text{G\\_c(z)} & \\text{vector t₂ vs quantum-minor t₂, rel. residual} & \\text{2.2}\\times 10^{\\text{-16}}\\\\\\hline\\end{array}",
